# =====================================================================
# 2D rod-and-tube elastic stability case (FULL geometry, no symmetry)
# =====================================================================
# Worst-case conditioning for the masked thermoelastic MLMG solve:
# a stiff propellant ROD floating inside a stiff propellant TUBE,
# coupled only through a thin, soft VOID annulus (the "seam"). The rod
# is a near-floating body; arithmetic coarsening tends to close the
# thin seam (Mode D in benchmark/MLMG_HIGH_CONTRAST_FINDINGS.md), and
# the persistent-MLMG stale coarse hierarchy detonates high-contrast
# Newton relinearizations (Mode C) unless resync_coeffs is on.
#
# Geometry is a full centered annulus (NO quarter-plane symmetry) built
# from an analytic expression in (x,y) only, so the 3D deck
# (input_rod_and_tube_3d) is this exact cross-section extruded along z.
#
# Materials (three-material partition, homogenized propellant):
#   solid  = phi*eta        -> model_prop  (stiff)   rod + tube
#   void   = phi*(1-eta)    -> model_void  (soft)    seam
#   casing = 1-phi          -> model_casing (unused; phi=1 everywhere)
# With phi=1 everywhere the field reduces to a two-material rod/void/tube.
#
# Stability recipe (validated 2026-07-04, commit 1cc3c32db):
#   resync_coeffs=1  nr_convergence=psi_update  line_search=1
#   zero_out_displacement=1  psi_floor=0.01
#   max_coarsening_level=2  bottom_solver=smoother  (Mode-D seam add-ons)
# Toggle elastic.solver.resync_coeffs=0 to reproduce the Mode-C divergence.
# =====================================================================

alamo.program = flame
plot_file = output_rod_and_tube_2d

amr.plot_int = 25
amr.max_level = 2
amr.nsubsteps = 2
amr.blocking_factor = 8
amr.base_regrid_int = 10
amr.grid_eff = 0.7
amr.node.all = 1
amr.refinement_criterion = 0.1        # refine on grad(eta): the two seam interfaces
amr.refinement_criterion_temp = 15.0_K
amr.phi_refinement_criterion = 0.2
amr.n_cell = 64 64 64
amr.thermo.plot_int = 1
amr.thermo.int = 1

geometry.prob_lo = 0.0_m 0.0_m 0.0_m
geometry.prob_hi = 0.1754_m 0.1754_m 0.1754_m
geometry.is_periodic = 0 0 0

system.length = m
system.time = s

# Timestep and duration (short: exercises a few high-contrast elastic solves)
timestep = 1.0e-4_s
stop_time = 0.005_s

# ---------------------------------------------------------------------
# Phase field: eta = burn state (1 unburned solid, 0 gas/void)
# ---------------------------------------------------------------------
pf.eps = 5.0e-5_m
pf.lambda = 0.001_J/m^2
pf.kappa = 1.0_J/m^2
pf.relax_steps = 0
pf.w1 = 1.0_1
pf.w12 = 2.0_1
pf.w0 = 0.0_1
small = 1E-4

# eta initial condition: centered rod (r<r1) and outer tube (r>r2) are
# solid (eta=1); the annular seam r1<r<r2 is void (eta=0). R is measured
# from the domain center (xc,yc) -> full circle, no quarter symmetry.
pf.eta.ic.type = expression
pf.eta.ic.expression.constant.xc = 0.0877
pf.eta.ic.expression.constant.yc = 0.0877
pf.eta.ic.expression.constant.r1 = 0.033
pf.eta.ic.expression.constant.r2 = 0.046
pf.eta.ic.expression.constant.w  = 0.0015
pf.eta.ic.expression.region0 = "1.0 - 0.25*(1.0 + tanh((sqrt((x-xc)^2+(y-yc)^2) - r1)/w))*(1.0 + tanh((r2 - sqrt((x-xc)^2+(y-yc)^2))/w))"

# phi = fuel-presence mask. Whole domain is fuel (no casing) -> phi=1.
phi.ic.type = constant
phi.ic.constant.value = 1.0

# eta boundary: outer tube is solid at the domain edge -> dirichlet 1
pf.eta.bc.type = constant
pf.eta.bc.constant.type.xlo = dirichlet
pf.eta.bc.constant.type.xhi = dirichlet
pf.eta.bc.constant.type.ylo = dirichlet
pf.eta.bc.constant.type.yhi = dirichlet
pf.eta.bc.constant.val.xlo = 1.0
pf.eta.bc.constant.val.xhi = 1.0
pf.eta.bc.constant.val.ylo = 1.0
pf.eta.bc.constant.val.yhi = 1.0

# ---------------------------------------------------------------------
# Propellant (homogenized) -> sets homogenized=true for the elastic blend
# ---------------------------------------------------------------------
propellant.type = homogenize
propellant.homogenize.P_reference = 1_MPa
propellant.homogenize.dispersion1 = 0.025_W/m/K
propellant.homogenize.dispersion2 = 1.2_kg/m^3
propellant.homogenize.dispersion3 = 1000_J/kg/K
propellant.homogenize.h1 = 1.5e6_W/m^2
propellant.homogenize.h2 = 8.0e6_W/m^2
propellant.homogenize.rho_prop = 1745.0_kg/m^3
propellant.homogenize.k_prop = 1.5_W/m/K
propellant.homogenize.cp_prop = 1476.0_J/kg/K
propellant.homogenize.m_prop = 8000_cm/s
propellant.homogenize.mlocal_prop = 0.1_kg/m^2/s
propellant.homogenize.E_prop = 3500.0_K
propellant.homogenize.mob_prop = true
propellant.homogenize.pressure_exponent = 0.372531
propellant.homogenize.bound = 0_K
propellant.homogenize.bound_width = 50_K

# ---------------------------------------------------------------------
# Thermal
# ---------------------------------------------------------------------
thermal.on = 1
thermal.Tref = 300
thermal.Tfluid = 300
thermal.temp.bc.type = constant
thermal.temp.bc.constant.type.xlo = dirichlet
thermal.temp.bc.constant.type.xhi = dirichlet
thermal.temp.bc.constant.type.ylo = dirichlet
thermal.temp.bc.constant.type.yhi = dirichlet
thermal.temp.bc.constant.val.xlo = 300_K
thermal.temp.bc.constant.val.xhi = 300_K
thermal.temp.bc.constant.val.ylo = 300_K
thermal.temp.bc.constant.val.yhi = 300_K

temp.ic.type = constant
temp.ic.constant.value = 300_K

# Ignition laser (first 25 ms)
laser.ic.type = expression
laser.ic.expression.region0 = "(t < 0.025) * (150000000)"
thermal.hc = 1.0

# ---------------------------------------------------------------------
# Chamber pressure
# ---------------------------------------------------------------------
variable_pressure = 1
chamber.pressure = 1.0_MPa
chamber.ballistic.At = 8.5e-4_m^2
chamber.ballistic.T0 = 3200_K
chamber.ballistic.R = 287_J/kg/K
chamber.ballistic.gamma = 1.25
chamber.ballistic.pressure = 4.0e6_Pa

# ---------------------------------------------------------------------
# Thermoelasticity
# ---------------------------------------------------------------------
elastic.on = 1
elastic.type = static
elastic.interval = 25
elastic.tstart = 0.5e-4
elastic.phirefinement = 100
elastic.print_model = 0
elastic.traction = 1.0_MPa

# Mode-D thin-void-seam + Mode-C stale-hierarchy stability recipe
elastic.psi_floor = 0.01
elastic.use_psi = 1
elastic.zero_out_displacement = 1
elastic.max_coarsening_level = 2

# tol_rel=1e-5 is the achievable linear tolerance for this near-singular
# floating-rod/soft-void problem: the masked high-contrast operator plateaus
# at its conditioning noise floor (~2.5e-6 rel resid) and cannot reach the
# 1e-8 default, but reaches 1e-5 in ~7 MG iterations. The resync A/B still
# holds: with resync_coeffs=0 the stale coarse hierarchy detonates the
# residual to ~1e22, far above any tolerance.
elastic.tol_rel = 1e-5
elastic.tol_abs = 1e-8
elastic.solver.max_iter = 200
elastic.solver.pre_smooth = 4
elastic.solver.post_smooth = 4
elastic.solver.nriters = 5
elastic.solver.nrtolerance = 1e-6
elastic.solver.bottom_solver = smoother
elastic.solver.line_search = 1
elastic.solver.resync_coeffs = 1
elastic.solver.nr_convergence = psi_update
elastic.solver.verbose = 4

# Three-material homogenized elastic models (mu + kappa only: NeoHookean
# requires exactly two moduli). High modulus gap prop:void ~ 20-23x.
model_prop.kappa = 150_MPa
model_prop.mu = 140_MPa
model_void.kappa = 8_MPa
model_void.mu = 6_MPa
model_casing.kappa = 150_MPa
model_casing.mu = 140_MPa

# Displacement BCs on all sides/corners (clamps the outer tube; the inner
# rod floats, coupled only through the soft seam -> worst-case conditioning)
elastic.bc.type = constant
elastic.bc.constant.type.xlo = disp disp
elastic.bc.constant.type.xhi = disp disp
elastic.bc.constant.type.ylo = disp disp
elastic.bc.constant.type.yhi = disp disp
elastic.bc.constant.type.xloylo = disp disp
elastic.bc.constant.type.xloyhi = disp disp
elastic.bc.constant.type.xhiylo = disp disp
elastic.bc.constant.type.xhiyhi = disp disp
