# Self-contained 3 MPa AP/HTPB packed-particle combustion case with an
# advecting aluminum particle that melts and then boils to inert Al vapor.
# This file intentionally has no
# FILE or ignore directives: every case parameter inherited by the previous
# version is specified directly below.
#
# Run from the repository root with:
#   mpirun -np 8 ./bin/lowmach-2d-clang++ \
#       input.lm.ap_htpb_al_packed_advecting_melting_boiling

# Output and AMR
plot_file = output.lm.ap_htpb_al_packed_advecting_melting_boiling
amr.plot_dt = 2.0e-5_s
amr.max_level = 2
amr.n_cell = 64 120
amr.max_grid_size = 16
amr.blocking_factor = 4
amr.regrid_int = 5
amr.grid_eff = 0.7
amr.nsubsteps = 1

# Reinitialization samples stationary condensed-species ICs and is therefore
# inappropriate once the aluminum profile moves away from its initial state.
amr.reinitialize_condensed_composition = 0

# Carry the moving condensed interfaces and active reaction layer to the
# finest level without following smooth burned-gas temperature or velocity
# structure downstream.
# The first molten layer is much thinner than a cell and has eta well below
# one percent.  Keep that layer refined until it accumulates into a resolved
# liquid-gas interface.
eta_refinement_criterion = 1.0e-4
reaction_refinement_criterion = 1.0e4_1/s
temperature_refinement_criterion = 500.0

# Time integration
timestep = 1.0e-7_s
stop_time = 8_ms
dynamictimestep.on = 1
dynamictimestep.min = 1.0e-12
dynamictimestep.max = 5.0e-4
dynamictimestep.verbose = 0
integration.type = RungeKutta
integration.rk.type = 3

# Domain
geometry.prob_lo = -0.0006_m -0.0004_m 0.0
geometry.prob_hi =  0.0006_m  0.0018_m 0.0
geometry.is_periodic = 1 0 0

# Gas model
system.amount = kmol
gas.thermo.type = gross_model
gas.thermo.gross_model.cp_mass = 0.3_cal/g/K
gas.thermo.gross_model.Tref = 273.15_K
gas.transport.type = gross_model
gas.transport.gross_model.prandtl = 0.69
gas.transport.gross_model.lewis = 1.0
gas.transport.gross_model.lambda_a = 2.13037e-7_cal/cm/s/K^2
gas.transport.gross_model.lambda_b = 5.32743e-6_cal/cm/s/K
gas.eos.type = gross_model

# GrossModel_Aluminized retains the original six reacting species and appends an
# inert aluminum-bearing gas species. The reduced GrossModel closure accepts one
# molecular weight for every gas species. Al_gas uses its atomic weight and
# the inert lumped Al2O3_gas species uses its molecular weight of 101.96 g/mol.
gas.mw = 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.9815385_g/mol 101.96_g/mol
species.names = AP_gas HTPB_gas Mono Premixed Primary Final Al_gas Al2O3_gas AP_solid HTPB_solid Al_solid Al_liquid
AP_gas.mechanics = fluid
HTPB_gas.mechanics = fluid
Mono.mechanics = fluid
Premixed.mechanics = fluid
Primary.mechanics = fluid
Final.mechanics = fluid
Al_gas.mechanics = fluid
Al2O3_gas.mechanics = fluid
AP_solid.mechanics = rigid_solid
HTPB_solid.mechanics = rigid_solid
Al_solid.mechanics = rigid_solid
Al_liquid.mechanics = liquid

AP_solid.reference_density = 1950.0_kg/m^3
HTPB_solid.reference_density = 920.0_kg/m^3
Al_solid.reference_density = 2700.0_kg/m^3
AP_solid.specific_heat = 1297.90_J/kg/K
AP_solid.thermal_conductivity = 0.4186_W/m/K
HTPB_solid.specific_heat = 2418.29_J/kg/K
HTPB_solid.thermal_conductivity = 0.1300_W/m/K
Al_solid.specific_heat = 900.0_J/kg/K
Al_solid.thermal_conductivity = 237.0_W/m/K
Al_solid.temperature_override = 800.0_K

# The liquid interface thickness is about four cells on the finest AMR level.
# The constant liquid-gas tension is representative of molten aluminum over
# the resolved melting/evaporation interval; a temperature-dependent property
# would be preferable once the interface model supports it.
Al_liquid.reference_density = 2375.0_kg/m^3
Al_liquid.dynamic_viscosity = 1.3e-3_Pa*s
Al_liquid.specific_heat = 1177.0_J/kg/K
Al_liquid.thermal_conductivity = 90.0_W/m/K
liquid.interface_thickness = 20.0_um
liquid.capillary.enabled = 1
liquid.capillary.include_solids = 1
# Surface tension is reserved for liquid-gas and liquid-liquid interfaces.
liquid.surface_tension.Al_liquid_gas = 0.85_J/m^2
# Each liquid-solid interface gets a positive diffuse-interface regularizer.
liquid.solid_interface_regularization.Al_liquid_AP_solid = 0.05_J/m^2
liquid.solid_interface_regularization.Al_liquid_HTPB_solid = 0.05_J/m^2
liquid.solid_interface_regularization.Al_liquid_Al_solid = 0.10_J/m^2
# AP and HTPB are transient hot propellant interfaces, so do not impose an
# artificial wetting preference there.  Molten aluminum completely wets its
# own solid: gamma_SL-gamma_SG lies beyond the finite-contact-angle Young
# range, so specify that signed surface-energy difference directly.
liquid.contact_angle.Al_liquid_AP_solid = 90.0_deg
liquid.contact_angle.Al_liquid_HTPB_solid = 90.0_deg
liquid.solid_surface_energy_difference.Al_liquid_Al_solid = -1.0_J/m^2

chemistry.model.type = gross_model_aluminized
chemistry.model.gross_model_aluminized.A = 27.0e3_g/cm^3/s 25.3e3_g/cm^3/s 5.0e3_g/cm^3/s 0.4e3_g/cm^3/s
chemistry.model.gross_model_aluminized.pressure_exponent = 1.6 1.7 1.7 1.7
chemistry.model.gross_model_aluminized.activation_energy = 15.9_kcal/mol 14.5_kcal/mol 11.3_kcal/mol 14.5_kcal/mol
chemistry.model.gross_model_aluminized.qgas = 430.0_cal/g 447.0_cal/g 8365.0_cal/g 2127.0_cal/g
chemistry.model.gross_model_aluminized.pressure_reference = 1.0_bar
chemistry.solver.type = backward_euler
chemistry.solver.backward_euler.nsubsteps = 1
chemistry.solver.backward_euler.max_iter = 100
chemistry.solver.backward_euler.reltol = 1.0e-8
chemistry.solver.backward_euler.abstol = 1.0e-12

# Rigid-body mechanics
AP_solid.rigid.motion = fixed
AP_solid.rigid.relaxation_time = 1.0e-8_s
AP_solid.rigid.velocity = 0.0 0.0
HTPB_solid.rigid.motion = fixed
HTPB_solid.rigid.relaxation_time = 1.0e-8_s
HTPB_solid.rigid.velocity = 0.0 0.0
Al_solid.rigid.motion = free
Al_solid.rigid.relaxation_time = 1.0e-8_s
# Retain the fresh provisional body momentum and predict the pressure impulse
# from the preceding step. Anderson corrections are used only when that cheap
# predictor misses the requested coupling tolerance.
Al_solid.rigid.coupling = anderson
Al_solid.rigid.max_iterations = 3
Al_solid.rigid.relative_tolerance = 1.0e-3
Al_solid.rigid.absolute_tolerance = 1.0e-5_m/s

mechanisms.names = AP_decomposition HTPB_pyrolysis Al_melting Al_boiling

# Use the AP and HTPB PhaseChange configurations from input.lm.ap_htpb_packed.
# The phase-field gradient terms are integrated implicitly.
AP_decomposition.type = phase_change
AP_decomposition.phase_change.phase0 = AP_solid
AP_decomposition.phase_change.phase1 = AP_gas
AP_decomposition.phase_change.latent_heat = 100.0_cal/g
AP_decomposition.phase_change.rate_multiplier = 2.75e6
AP_decomposition.phase_change.activation_temperature = 3145.0_K
AP_decomposition.phase_change.temperature_cutoff = 360.0_K
AP_decomposition.phase_change.phase_field.type = allencahn
AP_decomposition.phase_change.phase_field.allencahn.mobility = 0.01_1/Pa/s
AP_decomposition.phase_change.phase_field.allencahn.lambda = 8.333333333333333_Pa
AP_decomposition.phase_change.phase_field.allencahn.kappa = 1.0e-8_J/m
AP_decomposition.phase_change.phase_field.allencahn.w0 = 0.0
AP_decomposition.phase_change.phase_field.allencahn.w12 = 2.0
AP_decomposition.phase_change.phase_field.allencahn.w1 = 1.0

HTPB_pyrolysis.type = phase_change
HTPB_pyrolysis.phase_change.phase0 = HTPB_solid
HTPB_pyrolysis.phase_change.phase1 = HTPB_gas
HTPB_pyrolysis.phase_change.latent_heat = 300.0_cal/g
HTPB_pyrolysis.phase_change.rate_multiplier = 1.85e5
HTPB_pyrolysis.phase_change.activation_temperature = 3145.0_K
HTPB_pyrolysis.phase_change.temperature_cutoff = 360.0_K
HTPB_pyrolysis.phase_change.phase_field.type = allencahn
HTPB_pyrolysis.phase_change.phase_field.allencahn.mobility = 0.01_1/Pa/s
HTPB_pyrolysis.phase_change.phase_field.allencahn.lambda = 8.333333333333333_Pa
HTPB_pyrolysis.phase_change.phase_field.allencahn.kappa = 1.0e-8_J/m
HTPB_pyrolysis.phase_change.phase_field.allencahn.w0 = 0.0
HTPB_pyrolysis.phase_change.phase_field.allencahn.w12 = 2.0
HTPB_pyrolysis.phase_change.phase_field.allencahn.w1 = 1.0

# Use separate forward-only phase changes so aluminum must enter the liquid
# state before it can become vapor.  Melting begins at the equilibrium melting
# temperature.  Evaporation is represented by the fixed-speed capability
# available in this mechanism, calibrated to the vapor-pressure-limited
# recession rate near 2000 K.  It is not a bulk-boiling threshold; a future
# vapor-pressure/Al-partial-pressure flux model should replace this surrogate.
# Aluminum vapor remains chemically inert, but 40% of its 31.05 MJ/kg nominal
# combustion enthalpy is returned locally as an unresolved process coupled to
# forward vaporization.  The negative sign denotes an exothermic enthalpy
# change; latent heat remains a separate positive vaporization cost.
Al_melting.type = phase_change
Al_melting.phase_change.phase0 = Al_solid
Al_melting.phase_change.phase1 = Al_liquid
Al_melting.phase_change.reversible = false
Al_melting.phase_change.latent_heat = 3.9145e5_J/kg
Al_melting.phase_change.prescribed_speed = 0.8_mm/s
Al_melting.phase_change.temperature_cutoff = 933.45_K
Al_melting.phase_change.phase_field.type = allencahn

Al_boiling.type = phase_change
Al_boiling.phase_change.phase0 = Al_liquid
Al_boiling.phase_change.phase1 = Al_gas
Al_boiling.phase_change.reversible = false
Al_boiling.phase_change.latent_heat = 1.0897e7_J/kg
Al_boiling.phase_change.coupled_enthalpy_change = -1.242e7_J/kg
Al_boiling.phase_change.prescribed_speed = 0.13_mm/s
Al_boiling.phase_change.temperature_cutoff = 2000_K
Al_boiling.phase_change.phase_field.type = allencahn

# Flow, projection, and diffusion
advection.type = muscl
advection.muscl.limiter.type = superbee
cfl = 0.8
phase_field.cfl = 1.5
include_viscosity = 1
implicit_viscosity = 1
include_conduction = 1
advect_temperature = 1
projection.enabled = 1
projection.tol_rel = 1.0e-11
projection.tol_abs = 1.0e-12
projection.verbose = 0
projection.update_pressure = 1
diffusion.tol_rel = 1.0e-11
diffusion.tol_abs = 1.0e-12
diffusion.verbose = 0

