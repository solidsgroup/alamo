temperature.ic.expression.region0 = "Tsurface+(Tsolid-Tsurface)*(1.0-exp(-max(-(y-surface_y),0.0)/Lsolid))+(Tproducts-Tsurface)*(1.0-exp(-max(y-surface_y,0.0)/Lgas))"
pressure.ic.type = constant
