# rotation are obtained from the flow-derived rigid-body momentum projection.
velocity.ic.type = expression
velocity.ic.expression.constant.U = 0.01_m/s
velocity.ic.expression.constant.surface_y = -0.0003_m
velocity.ic.expression.constant.surface_eps = 20.0_um
