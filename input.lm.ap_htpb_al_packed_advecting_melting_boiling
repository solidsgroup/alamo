Final.density.ic.type = expression
Final.density.ic.expression.constant.surface_y = -0.0003_m
Final.density.ic.expression.constant.surface_eps = 20.0_um
Final.density.ic.expression.constant.al_height = 0.00035_m
Final.density.ic.expression.constant.al_r = 70.0_um
Final.density.ic.expression.constant.al_eps = 20.0_um
Final.density.ic.expression.constant.P = 3.0e6
Final.density.ic.expression.constant.Tsolid = 300.0_K
Final.density.ic.expression.constant.Tsurface = 350.0_K
Final.density.ic.expression.constant.Tproducts = 3000.0_K
Final.density.ic.expression.constant.Lsolid = 100.0_um
Final.density.ic.expression.constant.Lgas = 50.0_um
Final.density.ic.expression.region0 = "max(0.0,(0.5+0.5*tanh(2.0*(y-surface_y)/surface_eps))*(0.5+0.5*tanh(2.0*(sqrt(x*x+(y-surface_y-al_height)^2)-al_r)/al_eps))*P/(319.787*(Tsurface+(Tsolid-Tsurface)*(1.0-exp(-max(-(y-surface_y),0.0)/Lsolid))+(Tproducts-Tsurface)*(1.0-exp(-max(y-surface_y,0.0)/Lgas)))))"

Al_gas.density.ic.type = constant
