# LowMach driven cavity recirculation case
# Run with: ./bin/lowmach-2d-clang++ input.lm

plot_file = output.lm
amr.plot_dt = 0.1
amr.max_grid_size = 64
amr.blocking_factor = 4
amr.regrid_int = 50
amr.max_level = 2
amr.nsubsteps = 1
amr.n_cell = 64 64
eta_refinement_criterion = 0.01
velocity_refinement_criterion = 0.01

timestep = 2.5e-3
stop_time = 200.0
integration.type = RungeKutta
integration.rk.type = 3
#dynamictimestep.on = 1
#dynamictimestep.min = 0.0
#dynamictimestep.max = 1.0e-2
#dynamictimestep.verbose = 0

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 0.0
geometry.is_periodic = 0 0 0

system.amount = kmol
gas.mw = 28.0_g/mol
gas.thermo.type = cpconstant
gas.thermo.cpconstant.cp_moles = 29.1_J/mol/K
gas.thermo.cpconstant.h0 = 0.0
gas.thermo.cpconstant.s0 = 0.0
gas.thermo.cpconstant.Tref = 0.0_K
gas.transport.type = mixture_averaged
gas.transport.mixture_averaged.type = constant
gas.transport.mixture_averaged.mu = 1.0e-3_Pa*s
gas.transport.mixture_averaged.k = 0.02_W/m/K
gas.eos.type = cpg
species.names = ambient_gas solid
ambient_gas.mechanics = fluid
solid.mechanics = deformable_solid

advection.type = weno5

cfl = 0.25
include_viscosity = 1
include_conduction = 0
advect_temperature = 0
projection.enabled = 1
projection.tol_rel = 1.0e-11
projection.tol_abs = 1.0e-12
projection.verbose = 0
projection.update_pressure = 1
diagnostics.interval = 20
diagnostics.extended_fields = 0

reference_map.eta_core = 0.7
reference_map.eta_extension = 1.0e-3
reference_map.extrapolation_sweeps = 4
reference_map.reconstruction_alpha = 1.0
reference_map.reconstruction_power = 1.0
reference_map.affine_tolerance = 1.0e-7
reference_map.smoothing_sweeps = 4
reference_map.smoothing_alpha = 1.0
reference_map.smoothing_power = 2.0
reference_map.stress_smoothing_sweeps = 2
reference_map.stress_smoothing_alpha = 0.05

solid.model.type = finite.neohookean
solid.model.reference_density = 100.0_kg/m^3
solid.model.eta_threshold = 0.5
solid.model.J_floor = 1.0e-6
solid.model.deviatoric_stress_divergence_sign = 1.0
solid.model.viscosity = 5.0e-3_Pa*s
solid.model.interface_viscosity = 5.0e-3_Pa*s
solid.model.finite.neohookean.mu = 5.0e-2_Pa
solid.model.finite.neohookean.kappa = 5.0e-1_Pa

component_density.ic.type = expression
component_density.ic.expression.constant.rhog = 1.12254198039921
component_density.ic.expression.constant.rhos = 100.0
component_density.ic.expression.constant.eps = 0.01
component_density.ic.expression.constant.x0 = 0.45
component_density.ic.expression.constant.y0 = 0.65
component_density.ic.expression.constant.hx = 0.035
component_density.ic.expression.constant.hy = 0.12
component_density.ic.expression.region0 = "rhog*0.5*(1.0+tanh((sqrt(max(abs(x-x0)-hx,0.0)*max(abs(x-x0)-hx,0.0)+max(abs(y-y0)-hy,0.0)*max(abs(y-y0)-hy,0.0))+min(max(abs(x-x0)-hx,abs(y-y0)-hy),0.0))/eps))"
component_density.ic.expression.region1 = "rhos*(1.0-0.5*(1.0+tanh((sqrt(max(abs(x-x0)-hx,0.0)*max(abs(x-x0)-hx,0.0)+max(abs(y-y0)-hy,0.0)*max(abs(y-y0)-hy,0.0))+min(max(abs(x-x0)-hx,abs(y-y0)-hy),0.0))/eps)))"
velocity.ic.type = constant
velocity.ic.constant.value = 0.0 0.0
temperature.ic.type = constant
temperature.ic.constant.value = 300.0
pressure.ic.type = constant
pressure.ic.constant.value = 100000.0

# Allen-Cahn phase-field evolution
mechanisms.names = solid_phase_field
solid_phase_field.type = phase_change
solid_phase_field.phase_change.in = solid
solid_phase_field.phase_change.out = ambient_gas
solid_phase_field.phase_change.interface_only = 0
solid_phase_field.phase_change.phase_field.type = allencahn
solid_phase_field.phase_change.phase_field.allencahn.mobility = 0.01_1/Pa/s
solid_phase_field.phase_change.phase_field.allencahn.sigma = 0.01_J/m^2
solid_phase_field.phase_change.phase_field.allencahn.epsilon = 0.01_m

xi.ic.type = expression
xi.ic.expression.region0 = "x"
xi.ic.expression.region1 = "y"

component_density.bc.type = constant
component_density.bc.constant.type.xlo = neumann neumann
component_density.bc.constant.type.xhi = neumann neumann
component_density.bc.constant.type.ylo = neumann neumann
component_density.bc.constant.type.yhi = neumann neumann
component_density.bc.constant.val.xlo = 0.0 0.0
component_density.bc.constant.val.xhi = 0.0 0.0
component_density.bc.constant.val.ylo = 0.0 0.0
component_density.bc.constant.val.yhi = 0.0 0.0

velocity.bc.type = expression
velocity.bc.expression.constant.lid_u = 0.1
velocity.bc.expression.constant.lid_t = 5.0e-3
velocity.bc.expression.constant.lid_tw = 1.0e-3
velocity.bc.expression.constant.lid_xw = 5.0e-2
velocity.bc.expression.constant.lid_xs = 1.0e-2
velocity.bc.expression.type.xlo = dirichlet dirichlet
velocity.bc.expression.type.xhi = dirichlet dirichlet
velocity.bc.expression.type.ylo = dirichlet dirichlet
velocity.bc.expression.type.yhi = dirichlet dirichlet
velocity.bc.expression.val.xlo = 0.0 0.0
velocity.bc.expression.val.xhi = 0.0 0.0
velocity.bc.expression.val.ylo = 0.0 0.0
velocity.bc.expression.val.yhi = "lid_u" "0.0" #"lid_u*0.5*(1.0+tanh((t-lid_t)/lid_tw))*0.5*(tanh((x-lid_xw)/lid_xs)-tanh((x-(1.0-lid_xw))/lid_xs))" 0.0

temperature.bc.type = constant
temperature.bc.constant.type.xlo = neumann
temperature.bc.constant.type.xhi = neumann
temperature.bc.constant.type.ylo = neumann
temperature.bc.constant.type.yhi = neumann
temperature.bc.constant.val.xlo = 0.0
temperature.bc.constant.val.xhi = 0.0
temperature.bc.constant.val.ylo = 0.0
temperature.bc.constant.val.yhi = 0.0

pressure.bc.type = constant
pressure.bc.constant.type.xlo = neumann
pressure.bc.constant.type.xhi = neumann
pressure.bc.constant.type.ylo = neumann
pressure.bc.constant.type.yhi = neumann
pressure.bc.constant.val.xlo = 0.0
pressure.bc.constant.val.xhi = 0.0
pressure.bc.constant.val.ylo = 0.0
pressure.bc.constant.val.yhi = 0.0


xi.bc.type = expression
xi.bc.expression.type.xlo = dirichlet dirichlet
xi.bc.expression.type.xhi = dirichlet dirichlet
xi.bc.expression.type.ylo = dirichlet dirichlet
xi.bc.expression.type.yhi = dirichlet dirichlet
xi.bc.expression.val.xlo = "x" "y"
xi.bc.expression.val.xhi = "x" "y"
xi.bc.expression.val.ylo = "x" "y"
xi.bc.expression.val.yhi = "x" "y"
