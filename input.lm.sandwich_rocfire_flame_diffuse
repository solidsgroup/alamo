# LowMach analogue of input.sandwich_rocfire_flame_diffuse from the
# flame-with-multicomponent-advect branch.
# Run with: mpirun -np 2 ./bin/lowmach-2d-clang++ input.lm.sandwich_rocfire_flame_diffuse
# Short check: append "max_step=3 amr.plot_dt=-1 amr.plot_int=-1".

plot_file = output.lm.sandwich_rocfire_flame_diffuse
#amr.plot_dt = 3.0e-4_s
amr.plot_int = 100
amr.max_level = 0
amr.n_cell = 64 128
amr.max_grid_size = 32
amr.blocking_factor = 8
amr.regrid_int = -1
amr.nsubsteps = 1

# Backward-Euler viscosity, species diffusion, and heat conduction remove the
# gas transport limits. Start from the source Flame case's 2 ns step, then let
# the explicit advection and unburned-surface regression limits increase it.
timestep = 2.0e-9_s
stop_time = 5.0e-1_s
dynamictimestep.on = 1
dynamictimestep.min = 1.0e-12
dynamictimestep.max = 1.0e-6
dynamictimestep.verbose = 0
integration.type = RungeKutta
integration.rk.type = 3

# This is the source case's half-domain. The x boundaries are symmetry walls.
geometry.prob_lo = 0.0_m -0.0001_m 0.0
geometry.prob_hi = 0.0003_m 0.0005_m 0.0
geometry.is_periodic = 0 0 0

# Gas species 0-5 retain the ordering required by the Rocfire mechanism:
# AP, binder, monopropellant, premixed, primary-flame, final-flame products.
system.amount = kmol
gas.mw = 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol
gas.thermo.type = rocfire
gas.thermo.rocfire.mw = 26.0_g/mol
gas.thermo.rocfire.cp_mass = 0.3_cal/g/K
gas.thermo.rocfire.Tref = 273.15_K
gas.transport.type = rocfire
gas.transport.rocfire.mw = 26.0_g/mol
gas.transport.rocfire.prandtl = 0.69
gas.transport.rocfire.lewis = 1.0
gas.transport.rocfire.lambda_a = 2.13037e-7_cal/cm/s/K^2
gas.transport.rocfire.lambda_b = 5.32743e-6_cal/cm/s/K
# LowMach's thermally perfect ideal gas is equivalent to the source Rocfire EOS
# for this common-molecular-weight mixture.
gas.eos.type = tpg

species.names = AP_gas HTPB_gas Mono Premixed Primary Final AP_solid HTPB_solid
AP_gas.mechanics = fluid
HTPB_gas.mechanics = fluid
Mono.mechanics = fluid
Premixed.mechanics = fluid
Primary.mechanics = fluid
Final.mechanics = fluid
AP_solid.mechanics = rigid_solid
HTPB_solid.mechanics = rigid_solid
AP_solid.reference_density = 1950.0_kg/m^3
HTPB_solid.reference_density = 920.0_kg/m^3
AP_solid.thermal_conductivity = 0.4186_W/m/K
HTPB_solid.thermal_conductivity = 0.1300_W/m/K
AP_solid.specific_heat_capacity = 1297.90_J/kg/K
HTPB_solid.specific_heat_capacity = 2418.29_J/kg/K

chemistry.model.type = rocfire
chemistry.model.rocfire.A = 27.0e3_g/cm^3/s 25.3e3_g/cm^3/s 5.0e3_g/cm^3/s 0.4e3_g/cm^3/s
chemistry.model.rocfire.pressure_exponent = 1.6 1.7 1.7 1.7
chemistry.model.rocfire.activation_energy = 15.9_kcal/mol 14.5_kcal/mol 11.3_kcal/mol 14.5_kcal/mol
chemistry.model.rocfire.qgas = 430.0_cal/g 447.0_cal/g 8365.0_cal/g 2127.0_cal/g
chemistry.model.rocfire.qsolid = -100.0_cal/g -300.0_cal/g
chemistry.model.rocfire.pressure_reference = 1.0_bar
chemistry.solver.type = backward_euler
chemistry.solver.backward_euler.max_iter = 100
chemistry.solver.backward_euler.reltol = 1.0e-8
chemistry.solver.backward_euler.abstol = 1.0e-12

# Evolve one common rigid-solid eta with Flame's temperature-dependent AP/HTPB
# Arrhenius mobility and multi-well phase-field chemical potential. Gas heat
# conducts into the solid and raises the local surface temperature that drives
# regression; no laser or prescribed burn rate is used.
# Lost AP_solid and HTPB_solid mass is transferred one-for-one to the matching
# gas species. The paired sources have zero net mass. The outward momentum
# source uses Flame's u0 = c*rho_s/rho_g jump condition, while gas expansion is
# supplied to the pressure projection.
mechanisms.names = propellant_regression
propellant_regression.type = flame_regression
propellant_regression.flame_regression.in = AP_solid HTPB_solid
propellant_regression.flame_regression.out = AP_gas HTPB_gas
# Match the AP and HTPB gas states used by the source Rocfire case. The phase
# transition mixes this sensible enthalpy conservatively into the gas field.
propellant_regression.flame_regression.ejection_temperature = 830.0_K 889.0_K
propellant_regression.flame_regression.pre_exponential = 1.45e5_m/s 1.4e1_m/s
propellant_regression.flame_regression.activation_temperature = 11000.0_K 7500.0_K
propellant_regression.flame_regression.pressure_exponent = 0.0 0.0
propellant_regression.flame_regression.pressure_reference = 1.0_MPa
propellant_regression.flame_regression.stability_pressure = 2026500.0_Pa
propellant_regression.flame_regression.temperature_cutoff = 0.0_K
propellant_regression.flame_regression.phase_field.epsilon = 5.0_um
propellant_regression.flame_regression.phase_field.lambda = 0.001_J/m^2
propellant_regression.flame_regression.phase_field.kappa = 1.0_J/m^2
propellant_regression.flame_regression.phase_field.w0 = 0.0
propellant_regression.flame_regression.phase_field.w1 = 1.0
propellant_regression.flame_regression.phase_field.w12 = 2.0

rigid.relaxation_time = 1.0e-8_s
rigid.velocity = 0.0 0.0
# Use the material-specific AP/HTPB conductivity and heat capacity above so
# gas-side reaction heat can conduct through and heat the regressing surface.
rigid.thermal.enabled = 1

advection.type = muscl
advection.muscl.limiter.type = koren
cfl = 0.4
include_viscosity = 1
include_conduction = 1
transport.implicit_viscosity = 1
transport.implicit_conduction = 1
transport.implicit_species_diffusion = 1
transport.velocity_solver.tol_rel = 1.0e-9
transport.temperature_solver.tol_rel = 1.0e-9
transport.species_solver.tol_rel = 1.0e-9
advect_temperature = 1
projection.enabled = 1
projection.tol_rel = 1.0e-11
projection.tol_abs = 1.0e-12
projection.verbose = 0
projection.update_pressure = 1
# Remove only volume-constraint drift beyond the change predicted by the
# regression and split-chemistry volume sources.
projection.volume_constraint_correction = 1
diagnostics.interval = 100
diagnostics.extended_fields = 1

# The rigid body initially contains only AP_solid and HTPB_solid. Its volume
# fraction is 0.5-0.5*erf(y/20 um); the source case's diffuse 10 um x mask
# partitions that volume between the two true condensed material densities.
AP_solid.density.ic.type = expression
AP_solid.density.ic.expression.region0 = "max(0.0,1950.0*(0.5-0.5*erf(y/20.0e-6))*(0.5-0.5*erf((abs(x)-0.0002)/10.0e-6)))"
HTPB_solid.density.ic.type = expression
HTPB_solid.density.ic.expression.region0 = "max(0.0,920.0*(0.5-0.5*erf(y/20.0e-6))*(0.5+0.5*erf((abs(x)-0.0002)/10.0e-6)))"

# The rigid volume contains no gas. The complementary gas volume reproduces
# the source Flame case's original diffuse species initialization. The shared
# temperature is 830 K over AP and 889 K over HTPB at the surface. The solid
# remains preheated through the diffuse interface, then transitions smoothly
# around 50 um below the surface to 300 K in the bulk. The gas reaches the
# 2500 K product state across the reaction layer centered 15 um above the
# surface. Regression supplies additional material-specific reactant gas.
# LowMach has one shared temperature field, but its heat capacity,
# conductivity, and advective weight are evaluated from the local gas/solid
# composition. All gas partial densities use the shared local temperature so
# solid volume plus ideal-gas volume is one. The source case's complementary
# 10 um AP/HTPB laminate transition is retained; finite-rate diffusion and
# chemistry evolve it without a premixed-product pocket.
AP_gas.density.ic.type = expression
AP_gas.density.ic.expression.region0 = "max(0.0,(0.5+0.5*erf(y/20.0e-6))*(0.5-0.5*erf((y-20.0e-6)/30.0e-6))*(0.5-0.5*erf((abs(x)-0.0002)/10.0e-6))*2026500.0/(319.787*((0.5-0.5*erf(y/20.0e-6))*(300.0+((830.0*(0.5-0.5*erf((abs(x)-0.0002)/10.0e-6))+889.0*(0.5+0.5*erf((abs(x)-0.0002)/10.0e-6)))-300.0)*(0.5+0.5*erf((y+50.0e-6)/20.0e-6)))+(0.5+0.5*erf(y/20.0e-6))*((0.5-0.5*erf((y-15.0e-6)/5.0e-6))*(830.0*(0.5-0.5*erf((abs(x)-0.0002)/10.0e-6))+889.0*(0.5+0.5*erf((abs(x)-0.0002)/10.0e-6)))+(0.5+0.5*erf((y-15.0e-6)/5.0e-6))*2500.0))))"
HTPB_gas.density.ic.type = expression
HTPB_gas.density.ic.expression.region0 = "max(0.0,(0.5+0.5*erf(y/20.0e-6))*(0.5-0.5*erf((y-20.0e-6)/30.0e-6))*(0.5+0.5*erf((abs(x)-0.0002)/10.0e-6))*2026500.0/(319.787*((0.5-0.5*erf(y/20.0e-6))*(300.0+((830.0*(0.5-0.5*erf((abs(x)-0.0002)/10.0e-6))+889.0*(0.5+0.5*erf((abs(x)-0.0002)/10.0e-6)))-300.0)*(0.5+0.5*erf((y+50.0e-6)/20.0e-6)))+(0.5+0.5*erf(y/20.0e-6))*((0.5-0.5*erf((y-15.0e-6)/5.0e-6))*(830.0*(0.5-0.5*erf((abs(x)-0.0002)/10.0e-6))+889.0*(0.5+0.5*erf((abs(x)-0.0002)/10.0e-6)))+(0.5+0.5*erf((y-15.0e-6)/5.0e-6))*2500.0))))"
Final.density.ic.type = expression
Final.density.ic.expression.region0 = "max(0.0,(0.5+0.5*erf(y/20.0e-6))*(0.5+0.5*erf((y-20.0e-6)/30.0e-6))*2026500.0/(319.787*((0.5-0.5*erf(y/20.0e-6))*(300.0+((830.0*(0.5-0.5*erf((abs(x)-0.0002)/10.0e-6))+889.0*(0.5+0.5*erf((abs(x)-0.0002)/10.0e-6)))-300.0)*(0.5+0.5*erf((y+50.0e-6)/20.0e-6)))+(0.5+0.5*erf(y/20.0e-6))*((0.5-0.5*erf((y-15.0e-6)/5.0e-6))*(830.0*(0.5-0.5*erf((abs(x)-0.0002)/10.0e-6))+889.0*(0.5+0.5*erf((abs(x)-0.0002)/10.0e-6)))+(0.5+0.5*erf((y-15.0e-6)/5.0e-6))*2500.0))))"
temperature.ic.type = expression
temperature.ic.expression.region0 = "(0.5-0.5*erf(y/20.0e-6))*(300.0+((830.0*(0.5-0.5*erf((abs(x)-0.0002)/10.0e-6))+889.0*(0.5+0.5*erf((abs(x)-0.0002)/10.0e-6)))-300.0)*(0.5+0.5*erf((y+50.0e-6)/20.0e-6)))+(0.5+0.5*erf(y/20.0e-6))*((0.5-0.5*erf((y-15.0e-6)/5.0e-6))*(830.0*(0.5-0.5*erf((abs(x)-0.0002)/10.0e-6))+889.0*(0.5+0.5*erf((abs(x)-0.0002)/10.0e-6)))+(0.5+0.5*erf((y-15.0e-6)/5.0e-6))*2500.0)"
velocity.ic.type = constant
velocity.ic.constant.value = 0.0 0.0
pressure.ic.type = constant
pressure.ic.constant.value = 2026500.0

component_density.bc.type = constant
component_density.bc.constant.type.xlo = neumann
component_density.bc.constant.type.xhi = neumann
component_density.bc.constant.type.ylo = neumann
component_density.bc.constant.type.yhi = neumann

# Zero normal velocity on both x symmetry planes; open in y as in the source.
velocity.bc.type = constant
velocity.bc.constant.type.xlo = dirichlet neumann
velocity.bc.constant.type.xhi = dirichlet neumann
velocity.bc.constant.type.ylo = neumann
velocity.bc.constant.type.yhi = neumann
velocity.bc.constant.val.xlo = 0.0 0.0
velocity.bc.constant.val.xhi = 0.0 0.0

temperature.bc.type = constant
temperature.bc.constant.type.xlo = neumann
temperature.bc.constant.type.xhi = neumann
temperature.bc.constant.type.ylo = neumann
temperature.bc.constant.type.yhi = neumann

# Pin the chamber pressure at the top outlet and use homogeneous Neumann
# pressure conditions elsewhere.
pressure.bc.type = constant
pressure.bc.constant.type.xlo = neumann
pressure.bc.constant.type.xhi = neumann
pressure.bc.constant.type.ylo = neumann
pressure.bc.constant.type.yhi = dirichlet
pressure.bc.constant.val.yhi = 2026500.0
