# Aluminum occupies the gas-side circle. Multiplying by the gas-side
# complement of the bed profile prevents overlap with the propellant.
Al_solid.density.ic.type = expression
Al_solid.density.ic.expression.constant.surface_y = -0.0003_m
Al_solid.density.ic.expression.constant.surface_eps = 20.0_um
Al_solid.density.ic.expression.constant.al_height = 0.00035_m
Al_solid.density.ic.expression.constant.al_r = 70.0_um
Al_solid.density.ic.expression.constant.al_eps = 20.0_um
Al_solid.density.ic.expression.region0 = "max(0.0,2700.0*(0.5+0.5*tanh(2.0*(y-surface_y)/surface_eps))*(0.5-0.5*tanh(2.0*(sqrt(x*x+(y-surface_y-al_height)^2)-al_r)/al_eps)))"

# Final products fill the space outside both condensed regions.
Final.density.ic.type = expression
Final.density.ic.expression.constant.surface_y = -0.0003_m
Final.density.ic.expression.constant.surface_eps = 20.0_um
Final.density.ic.expression.constant.al_height = 0.00035_m
