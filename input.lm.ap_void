# Proof-of-concept: a single circular/cylindrical void (filled with "Final"
# combustion products, i.e. inert gas) embedded inside an otherwise solid AP
# bed, based on input.lm.ap_htpb_packed_elastic. Differences from that file:
#
#   1) Only the AP condensed phase is actually present in the domain.
#      HTPB_solid is left in species.names/mechanisms (Rocfire's gas-phase
#      network and phase-change mechanism list both assume two condensed
#      species) but its IC is identically zero everywhere, so no HTPB
#      material is placed.
#   2) A smoothed circular region of Final (inert product gas) sits inside
#      the AP bed, well below the burning surface -- a stand-in for a void/
#      pocket in the grain. Its temperature IC is pinned to ambient (see
#      below) regardless of position, so it cannot self-ignite from the
#      Arrhenius phase-change rate (which needs temperature above
#      temperature_cutoff).
#   3) The elastic FSI solve (input.lm.ap_htpb_packed_elastic) is disabled
#      by commenting out its entire ParmParse block rather than setting
#      elastic.type=disable -- Alamo's ParmParse runs in strict mode and
#      aborts on unused parameters, so simply flipping elastic.type while
#      leaving elastic.bc.constant.* etc. uncommented does NOT work (it
#      throws "unused inputs" for every other elastic.* key). To re-enable
#      later: uncomment the whole "ELASTIC SOLVE" block at the bottom
#      verbatim -- it is left in its working form from
#      input.lm.ap_htpb_packed_elastic (real SI AP moduli, full 2D/3D BC
#      set), just commented out.
#
# Run in either dimension:
#   mpirun -np 8 ./bin/lowmach-2d-clang++ input.lm.ap_void
#   mpirun -np 8 ./bin/lowmach-3d-clang++ input.lm.ap_void

plot_file = output.lm.ap_void
amr.plot_dt = 1.0e-5_s
amr.plot_int = 1
amr.max_level = 2
amr.n_cell = 40 48 40
amr.max_grid_size = 20
amr.blocking_factor = 2
amr.regrid_int = 5
amr.grid_eff = 0.7
amr.nsubsteps = 1
amr.reinitialize_condensed_composition = 1
amr.reinitialize_condensed_composition_eta_min = 0.99
amr.cell.all = 1
amr.node.any = 0

eta_refinement_criterion = 0.5
temperature_refinement_criterion = 1.0
velocity_refinement_criterion = 1.0

timestep = 1.0e-7_s
stop_time = 25_ms
dynamictimestep.on = 1
dynamictimestep.min = 1.0e-12
dynamictimestep.max = 5.0e-6
dynamictimestep.verbose = 0

integration.type = RungeKutta
integration.rk.type = 3

# Extra depth below the burning surface (y0 = 0) compared to
# input.lm.ap_htpb_packed_elastic, to give the void comfortable margin (>10
# interface widths, see wy/wv below) from both the burning surface and the
# domain floor.
geometry.prob_lo = -0.25_mm -0.5_mm -0.25_mm
geometry.prob_hi =  0.25_mm  0.1_mm  0.25_mm
geometry.is_periodic = 0 0 0

# Gas species 0-5 retain the ordering required by the Rocfire mechanism:
# AP, binder, monopropellant, premixed, primary-flame, final-flame products.
system.amount = kmol
gas.mw = 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol
gas.thermo.type = rocfire
gas.thermo.rocfire.mw = 26.0_g/mol
gas.thermo.rocfire.cp_mass = 0.3_cal/g/K
gas.thermo.rocfire.Tref = 273.15_K
gas.transport.type = rocfire
gas.transport.rocfire.mw = 26.0_g/mol
gas.transport.rocfire.prandtl = 0.69
gas.transport.rocfire.lewis = 1.0
gas.transport.rocfire.lambda_a = 2.13037e-7_cal/cm/s/K^2
gas.transport.rocfire.lambda_b = 5.32743e-6_cal/cm/s/K
gas.eos.type = tpg

species.names = AP_gas HTPB_gas Mono Premixed Primary Final AP_solid HTPB_solid
AP_gas.mechanics = fluid
HTPB_gas.mechanics = fluid
Mono.mechanics = fluid
Premixed.mechanics = fluid
Primary.mechanics = fluid
Final.mechanics = fluid
AP_solid.mechanics = rigid_solid
HTPB_solid.mechanics = rigid_solid
AP_solid.reference_density = 1950.0_kg/m^3
HTPB_solid.reference_density = 920.0_kg/m^3
AP_solid.specific_heat = 1297.90_J/kg/K
AP_solid.thermal_conductivity = 0.4186_W/m/K
HTPB_solid.specific_heat = 2418.29_J/kg/K
HTPB_solid.thermal_conductivity = 0.1300_W/m/K

chemistry.model.type = rocfire
chemistry.model.rocfire.A = 27.0e3_g/cm^3/s 25.3e3_g/cm^3/s 5.0e3_g/cm^3/s 0.4e3_g/cm^3/s
chemistry.model.rocfire.pressure_exponent = 1.6 1.7 1.7 1.7
chemistry.model.rocfire.activation_energy = 15.9_kcal/mol 14.5_kcal/mol 11.3_kcal/mol 14.5_kcal/mol
chemistry.model.rocfire.qgas = 430.0_cal/g 447.0_cal/g 8365.0_cal/g 2127.0_cal/g
chemistry.model.rocfire.qsolid = -100.0_cal/g -300.0_cal/g
chemistry.model.rocfire.pressure_reference = 1.0_bar
chemistry.solver.type = backward_euler
chemistry.solver.backward_euler.max_iter = 100
chemistry.solver.backward_euler.reltol = 1.0e-8
chemistry.solver.backward_euler.abstol = 1.0e-12

# HTPB_pyrolysis is kept (Rocfire's Primary/Final network structurally
# assumes both condensed mechanisms) but is inert here since no HTPB_solid
# is ever placed in the domain (see HTPB_solid.density.ic below).
mechanisms.names = AP_decomposition HTPB_pyrolysis
AP_decomposition.type = phase_change
AP_decomposition.phase_change.in = AP_solid
AP_decomposition.phase_change.out = AP_gas
AP_decomposition.phase_change.rate_multiplier = 2.75e6
AP_decomposition.phase_change.activation_temperature = 3145.0_K
AP_decomposition.phase_change.temperature_cutoff = 600.0_K
AP_decomposition.phase_change.phase_field.type = allencahn
AP_decomposition.phase_change.phase_field.allencahn.mobility = 0.01_1/Pa/s
AP_decomposition.phase_change.phase_field.allencahn.lambda = 8.333333333333333_Pa
AP_decomposition.phase_change.phase_field.allencahn.kappa = 1.0e-8_J/m
AP_decomposition.phase_change.phase_field.allencahn.w0 = 0.0
AP_decomposition.phase_change.phase_field.allencahn.w12 = 2.0
AP_decomposition.phase_change.phase_field.allencahn.w1 = 1.0

HTPB_pyrolysis.type = phase_change
HTPB_pyrolysis.phase_change.in = HTPB_solid
HTPB_pyrolysis.phase_change.out = HTPB_gas
HTPB_pyrolysis.phase_change.rate_multiplier = 1.85e5
HTPB_pyrolysis.phase_change.activation_temperature = 3145.0_K
HTPB_pyrolysis.phase_change.temperature_cutoff = 360.0_K
HTPB_pyrolysis.phase_change.phase_field.type = allencahn
HTPB_pyrolysis.phase_change.phase_field.allencahn.mobility = 0.01_1/Pa/s
HTPB_pyrolysis.phase_change.phase_field.allencahn.lambda = 8.333333333333333_Pa
HTPB_pyrolysis.phase_change.phase_field.allencahn.kappa = 1.0e-8_J/m
HTPB_pyrolysis.phase_change.phase_field.allencahn.w0 = 0.0
HTPB_pyrolysis.phase_change.phase_field.allencahn.w12 = 2.0
HTPB_pyrolysis.phase_change.phase_field.allencahn.w1 = 1.0

rigid.relaxation_time = 1.0e-8_s
rigid.velocity = 0.0 0.0 0.0

advection.type = muscl
advection.muscl.limiter.type = minmod
cfl = 0.8
phase_field.cfl = 1.5
include_viscosity = 1
implicit_viscosity = 1
include_conduction = 1
advect_temperature = 1
projection.enabled = 1
projection.tol_rel = 1.0e-11
projection.tol_abs = 1.0e-12
projection.verbose = 0
projection.update_pressure = 1
diffusion.tol_rel = 1.0e-11
diffusion.tol_abs = 1.0e-12
diffusion.verbose = 0
#diagnostics.interval = 100
diagnostics.extended_fields = 0

# --- Condensed-phase IC: solid AP bed (y < y0) with a smoothed spherical/
# cylindrical void of radius rv centered at (xv,yv) sitting well inside the
# bed. void_mask below is the reusable indicator (1 inside the void, 0
# outside, tanh-smoothed over width wv) used consistently across the AP,
# Final and temperature ICs so the pressure/ideal-gas/thermal fields all
# agree at t=0. The void is defined in x-y only (a cylinder along z, same
# convention as the psread "z=0 slice" used for the 2D cross-section
# elsewhere in this repo), so this input runs unmodified in 2D or 3D.
AP_solid.density.ic.type = expression
AP_solid.density.ic.expression.constant.rho = 1950.0_kg/m^3
AP_solid.density.ic.expression.constant.y0 = 0.0_mm
AP_solid.density.ic.expression.constant.wy = 10.0_um
AP_solid.density.ic.expression.constant.xv = 0.0_mm
AP_solid.density.ic.expression.constant.yv = -0.25_mm
AP_solid.density.ic.expression.constant.rv = 50.0_um
AP_solid.density.ic.expression.constant.wv = 10.0_um
AP_solid.density.ic.expression.region0 = "rho*(0.5*(1.0-tanh((y-y0)/wy)))*(1.0-0.5*(1.0+tanh((rv-sqrt((x-xv)^2+(y-yv)^2))/wv)))"

# No HTPB material is placed anywhere in this proof-of-concept domain.
HTPB_solid.density.ic.type = constant
HTPB_solid.density.ic.constant.value = 0.0

# Gas (Final) IC: ideal-gas-consistent complement of AP_solid everywhere --
# above the burning surface (y > y0) via the usual thermal-penetration
# profile, AND inside the void (void_mask), where the local temperature is
# pinned to Tambient (see temperature.ic below) rather than the thermal
# profile, since the void starts thermally isolated from the surface.
Final.density.ic.type = expression
Final.density.ic.expression.constant.P = 3.0e6
Final.density.ic.expression.constant.Tambient = 300.0_K
Final.density.ic.expression.constant.Tignite = 400.0_K
Final.density.ic.expression.constant.Lsolid = 100.0_um
Final.density.ic.expression.constant.Lgas = 250.0_um
Final.density.ic.expression.constant.y0 = 0.0_mm
Final.density.ic.expression.constant.wy = 10.0_um
Final.density.ic.expression.constant.xv = 0.0_mm
Final.density.ic.expression.constant.yv = -0.25_mm
Final.density.ic.expression.constant.rv = 50.0_um
Final.density.ic.expression.constant.wv = 10.0_um
Final.density.ic.expression.region0 = "max(0.0,((0.5+0.5*tanh(2.0*y/20.0e-6))+(0.5*(1.0+tanh((rv-sqrt((x-xv)^2+(y-yv)^2))/wv))))*P/(319.787*(Tambient+(1.0-0.5*(1.0+tanh((rv-sqrt((x-xv)^2+(y-yv)^2))/wv)))*(Tignite-Tambient)*exp(-max(-y,0.0)/Lsolid-max(y,0.0)/Lgas))))"

velocity.ic.type = constant
velocity.ic.constant.value = 0.0

# Temperature: the usual thermal-penetration profile referenced to the
# burning surface, EXCEPT inside the void, which is pinned to Tambient
# (void_mask = 1) regardless of its distance to the surface -- this is what
# keeps AP inside the void from decomposing (the phase-change rate needs
# T > temperature_cutoff = 360 K) even if a future case moves the void
# closer to the surface than the thermal penetration depth would allow on
# its own.
temperature.ic.type = expression
temperature.ic.expression.constant.Tambient = 300.0_K
temperature.ic.expression.constant.Tignite = 400.0_K
temperature.ic.expression.constant.Lsolid = 100.0_um
temperature.ic.expression.constant.Lgas = 250.0_um
temperature.ic.expression.constant.xv = 0.0_mm
temperature.ic.expression.constant.yv = -0.25_mm
temperature.ic.expression.constant.rv = 50.0_um
temperature.ic.expression.constant.wv = 10.0_um
temperature.ic.expression.region0 = "Tambient+(1.0-0.5*(1.0+tanh((rv-sqrt((x-xv)^2+(y-yv)^2))/wv)))*(Tignite-Tambient)*exp(-max(-y,0.0)/Lsolid-max(y,0.0)/Lgas)"

pressure.ic.type = constant
pressure.ic.constant.value = 3000000.0

heat_source.ic.type = expression
heat_source.ic.expression.unit = W/m^3
heat_source.ic.expression.constant.qflux = 1.0e7_W/m^2
heat_source.ic.expression.constant.width = 6.25e-6_m
heat_source.ic.expression.constant.norm = 1.772453850905516
heat_source.ic.expression.constant.toff = 2.5e-4_s
heat_source.ic.expression.constant.tramp = 1.0e-5_s
heat_source.ic.expression.region0 = "qflux*exp(-(y/width)^2)/(norm*width)*0.5*(1.0-tanh((t-toff)/tramp))"

component_density.bc.type = constant
component_density.bc.constant.type.xlo = neumann
component_density.bc.constant.type.xhi = neumann
component_density.bc.constant.type.ylo = neumann
component_density.bc.constant.type.yhi = neumann
component_density.bc.constant.type.zlo = neumann
component_density.bc.constant.type.zhi = neumann

velocity.bc.type = constant
velocity.bc.constant.type.xlo = REFLECT_ODD REFLECT_EVEN REFLECT_EVEN
velocity.bc.constant.type.xhi = REFLECT_ODD REFLECT_EVEN REFLECT_EVEN
velocity.bc.constant.type.ylo = dirichlet
velocity.bc.constant.type.yhi = neumann
velocity.bc.constant.type.zlo = REFLECT_EVEN REFLECT_EVEN REFLECT_ODD
velocity.bc.constant.type.zhi = REFLECT_EVEN REFLECT_EVEN REFLECT_ODD
velocity.bc.constant.val.ylo = 0.0

temperature.bc.type = constant
temperature.bc.constant.type.xlo = neumann
temperature.bc.constant.type.xhi = neumann
temperature.bc.constant.type.ylo = neumann
temperature.bc.constant.type.yhi = neumann
temperature.bc.constant.type.zlo = neumann
temperature.bc.constant.type.zhi = neumann

pressure.bc.type = constant
pressure.bc.constant.type.xlo = neumann
pressure.bc.constant.type.xhi = neumann
pressure.bc.constant.type.ylo = neumann
pressure.bc.constant.type.yhi = dirichlet
pressure.bc.constant.type.zlo = neumann
pressure.bc.constant.type.zhi = neumann
pressure.bc.constant.val.yhi = 3000000.0

# --- ELASTIC SOLVE (disabled for this proof-of-concept) ---------------------
# Left commented out, verbatim from input.lm.ap_htpb_packed_elastic (minus
# HTPB's moduli, since HTPB_solid is never actually present here), so the
# void case can be re-run later with the elastic FSI solve enabled: just
# uncomment this whole block. Commented out rather than elastic.type=disable
# because Alamo's ParmParse aborts on unused inputs -- disabling while
# leaving elastic.bc.constant.* etc. uncommented throws "unused inputs" for
# every other elastic.* key.
#
# AP_solid.elastic.model.mu    = 9.47e9
# AP_solid.elastic.model.kappa = 1.00e10
#
# elastic.type = static
# elastic.interval = 10
# elastic.traction = 0.0
# elastic.apply_fluid_pressure = 1
# elastic.etacutoff = 0.0
# elastic.print_model = 1
# elastic.solver.verbose = 0
# elastic.tol_rel = 1.0e-8
# elastic.tol_abs = 1.0e-8
#
# elastic.bc.type = constant
# elastic.bc.constant.type.xlo = disp trac trac
# elastic.bc.constant.type.xhi = disp trac trac
# elastic.bc.constant.type.ylo = disp disp disp
# elastic.bc.constant.type.yhi = trac trac trac
# elastic.bc.constant.type.zlo = trac trac disp
# elastic.bc.constant.type.zhi = trac trac disp
# elastic.bc.constant.type.xloylo = disp disp disp
# elastic.bc.constant.type.xhiylo = disp disp disp
# elastic.bc.constant.type.xloyhi = disp trac trac
# elastic.bc.constant.type.xhiyhi = disp trac trac
# elastic.bc.constant.type.ylozlo = disp disp disp
# elastic.bc.constant.type.ylozhi = disp disp disp
# elastic.bc.constant.type.yhizlo = trac trac disp
# elastic.bc.constant.type.yhizhi = trac trac disp
# elastic.bc.constant.type.zloxlo = disp trac disp
# elastic.bc.constant.type.zloxhi = disp trac disp
# elastic.bc.constant.type.zhixlo = disp trac disp
# elastic.bc.constant.type.zhixhi = disp trac disp
# elastic.bc.constant.type.xloylozlo = disp disp disp
# elastic.bc.constant.type.xloylozhi = disp disp disp
# elastic.bc.constant.type.xhiylozlo = disp disp disp
# elastic.bc.constant.type.xhiylozhi = disp disp disp
# elastic.bc.constant.type.xloyhizlo = disp trac disp
# elastic.bc.constant.type.xloyhizhi = disp trac disp
# elastic.bc.constant.type.xhiyhizlo = disp trac disp
# elastic.bc.constant.type.xhiyhizhi = disp trac disp
