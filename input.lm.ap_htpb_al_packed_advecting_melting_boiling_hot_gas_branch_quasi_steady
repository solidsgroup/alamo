Al_melting.phase_change.reversible = false
Al_melting.phase_change.latent_heat = 1.0e5_J/kg
Al_melting.phase_change.transition_temperature = 933.45_K

Al_melting_2.type = phase_change
Al_melting_2.phase_change.phase0 = Al_solid_2
Al_melting_2.phase_change.phase1 = Al_liquid
Al_melting_2.phase_change.kinetics = equilibrium_enthalpy
Al_melting_2.phase_change.reversible = false
Al_melting_2.phase_change.latent_heat = 1.0e5_J/kg
Al_melting_2.phase_change.transition_temperature = 933.45_K

Al_melting_3.type = phase_change
Al_melting_3.phase_change.phase0 = Al_solid_3
Al_melting_3.phase_change.phase1 = Al_liquid
Al_melting_3.phase_change.kinetics = equilibrium_enthalpy
Al_melting_3.phase_change.reversible = false
Al_melting_3.phase_change.latent_heat = 1.0e5_J/kg
Al_melting_3.phase_change.transition_temperature = 933.45_K

# Represent the unresolved aluminum oxidation flame as a moving heat flux on
# the diffuse liquid-gas surface.  The 100 MW/m^2 deposited flux corresponds
# to roughly 30% local retention of the nominal 31.05 MJ/kg oxidation enthalpy
# at an effective aluminum oxidation flux near 10.7 kg/m^2/s.  For the present
# particle size, that is an O(6 ms) oxidation timescale.  It supplies heat as
# soon as molten aluminum is exposed instead of requiring vapor to exist first.
Al_surface_oxidation.type = interfacial_heat_source
Al_surface_oxidation.interfacial_heat_source.liquid = Al_liquid
Al_surface_oxidation.interfacial_heat_source.heat_flux = 120.0_MW/m^2
Al_surface_oxidation.interfacial_heat_source.activation_temperature = 1200.0_K
Al_surface_oxidation.interfacial_heat_source.activation_width = 100.0_K

Al_evaporation.type = phase_change
Al_evaporation.phase_change.phase0 = Al_liquid
Al_evaporation.phase_change.phase1 = Al_gas
Al_evaporation.phase_change.kinetics = hertz_knudsen
Al_evaporation.phase_change.reversible = false
Al_evaporation.phase_change.latent_heat = 0.5897e7_J/kg
Al_evaporation.phase_change.accommodation_coefficient = 0.5
Al_evaporation.phase_change.saturation_reference_temperature = 2743.0_K
Al_evaporation.phase_change.saturation_reference_pressure = 101325.0_Pa

# Flow, projection, and diffusion
advection.type = muscl
advection.muscl.limiter.type = superbee
cfl = 0.8
phase_field.cfl = 1.5
include_viscosity = 1
implicit_viscosity = 1
include_conduction = 1
advect_temperature = 1
projection.enabled = 1
projection.tol_rel = 1.0e-6
projection.tol_abs = 1.0e-12_1/s
projection.verbose = 0
projection.update_pressure = 1
diffusion.tol_rel = 1.0e-11
diffusion.tol_abs = 1.0e-12
diffusion.verbose = 0

# Developed AP/HTPB condensed state paired with the sampled flame.  RG and BA
# encode 16-bit AP and HTPB volume fractions; multiplying by each reference
# density recovers the evolved extrinsic partial densities.  Keeping this
# regressed, mildly corrugated surface is necessary because it is part of the
# quasi-steady flame solution, not an independent geometric decoration.
AP_solid.density.ic.type = png
AP_solid.density.ic.png.filename = ap_htpb_developed_flame_propellant.png
AP_solid.density.ic.png.fit = cell
AP_solid.density.ic.png.channels = R G
AP_solid.density.ic.png.precision = 16
AP_solid.density.ic.png.value = 1950.0_kg/m^3

HTPB_solid.density.ic.type = png
HTPB_solid.density.ic.png.filename = ap_htpb_developed_flame_propellant.png
HTPB_solid.density.ic.png.fit = cell
HTPB_solid.density.ic.png.channels = B A
HTPB_solid.density.ic.png.precision = 16
HTPB_solid.density.ic.png.value = 920.0_kg/m^3

# Three unequal, slightly overlapping disks form one connected, bent branch.
# A 25 um liquid layer penetrates into the original envelope rather than being
# added outside it.
Al_solid.density.ic.type = expression
Al_solid.density.ic.expression.constant.surface_y = -0.0003_m
Al_solid.density.ic.expression.constant.surface_eps = 20.0_um
Al_solid.density.ic.expression.constant.al_eps = 20.0_um
Al_solid.density.ic.expression.constant.al_x1 = -95.0_um
Al_solid.density.ic.expression.constant.al_y1 = 300.0_um
Al_solid.density.ic.expression.constant.al_r1 = 82.0_um
Al_solid.density.ic.expression.constant.melt_depth = 25.0_um
Al_solid.density.ic.expression.region0 = "max(0.0,2700.0*(0.5+0.5*tanh(2.0*(y-surface_y)/surface_eps))*(0.5-0.5*tanh(2.0*(sqrt((x-al_x1)^2+(y-surface_y-al_y1)^2)-(al_r1-melt_depth))/al_eps)))"

Al_solid_2.density.ic.type = expression
Al_solid_2.density.ic.expression.constant.surface_y = -0.0003_m
Al_solid_2.density.ic.expression.constant.surface_eps = 20.0_um
Al_solid_2.density.ic.expression.constant.al_eps = 20.0_um
Al_solid_2.density.ic.expression.constant.al_x = 35.0_um
Al_solid_2.density.ic.expression.constant.al_y = 355.0_um
Al_solid_2.density.ic.expression.constant.al_r = 78.0_um
Al_solid_2.density.ic.expression.constant.melt_depth = 25.0_um
Al_solid_2.density.ic.expression.region0 = "max(0.0,2700.0*(0.5+0.5*tanh(2.0*(y-surface_y)/surface_eps))*(0.5-0.5*tanh(2.0*(sqrt((x-al_x)^2+(y-surface_y-al_y)^2)-(al_r-melt_depth))/al_eps)))"

Al_solid_3.density.ic.type = expression
Al_solid_3.density.ic.expression.constant.surface_y = -0.0003_m
Al_solid_3.density.ic.expression.constant.surface_eps = 20.0_um
Al_solid_3.density.ic.expression.constant.al_eps = 20.0_um
Al_solid_3.density.ic.expression.constant.al_x = 82.0_um
Al_solid_3.density.ic.expression.constant.al_y = 477.0_um
Al_solid_3.density.ic.expression.constant.al_r = 70.0_um
Al_solid_3.density.ic.expression.constant.melt_depth = 25.0_um
Al_solid_3.density.ic.expression.region0 = "max(0.0,2700.0*(0.5+0.5*tanh(2.0*(y-surface_y)/surface_eps))*(0.5-0.5*tanh(2.0*(sqrt((x-al_x)^2+(y-surface_y-al_y)^2)-(al_r-melt_depth))/al_eps)))"

Al_liquid.density.ic.type = expression
Al_liquid.density.ic.expression.constant.surface_y = -0.0003_m
Al_liquid.density.ic.expression.constant.surface_eps = 20.0_um
Al_liquid.density.ic.expression.constant.al_eps = 20.0_um
Al_liquid.density.ic.expression.constant.al_x1 = -95.0_um
Al_liquid.density.ic.expression.constant.al_y1 = 300.0_um
Al_liquid.density.ic.expression.constant.al_r1 = 82.0_um
Al_liquid.density.ic.expression.constant.al_x2 = 35.0_um
Al_liquid.density.ic.expression.constant.al_y2 = 355.0_um
Al_liquid.density.ic.expression.constant.al_r2 = 78.0_um
Al_liquid.density.ic.expression.constant.al_x3 = 82.0_um
Al_liquid.density.ic.expression.constant.al_y3 = 477.0_um
Al_liquid.density.ic.expression.constant.al_r3 = 70.0_um
Al_liquid.density.ic.expression.constant.melt_depth = 25.0_um
Al_liquid.density.ic.expression.constant.union_smoothing = 20.0_um
# Use the same smooth union for the outer envelope and the inset solid-core
# envelope.  Their difference is a connected penetrated melt layer without
# the derivative kinks and double-subtracted overlap holes produced by min()
# and by subtracting three independent core indicators.
Al_liquid.density.ic.expression.region0 = "max(0.0,2375.0*(0.5+0.5*tanh(2.0*(y-surface_y)/surface_eps))*((0.5-0.5*tanh(2.0*(-union_smoothing*log(exp(-(sqrt((x-al_x1)^2+(y-surface_y-al_y1)^2)-al_r1)/union_smoothing)+exp(-(sqrt((x-al_x2)^2+(y-surface_y-al_y2)^2)-al_r2)/union_smoothing)+exp(-(sqrt((x-al_x3)^2+(y-surface_y-al_y3)^2)-al_r3)/union_smoothing))/al_eps))-(0.5-0.5*tanh(2.0*(-union_smoothing*log(exp(-(sqrt((x-al_x1)^2+(y-surface_y-al_y1)^2)-(al_r1-melt_depth))/union_smoothing)+exp(-(sqrt((x-al_x2)^2+(y-surface_y-al_y2)^2)-(al_r2-melt_depth))/union_smoothing)+exp(-(sqrt((x-al_x3)^2+(y-surface_y-al_y3)^2)-(al_r3-melt_depth))/union_smoothing))/al_eps))))))"

# Initially inert aluminum-bearing gases
