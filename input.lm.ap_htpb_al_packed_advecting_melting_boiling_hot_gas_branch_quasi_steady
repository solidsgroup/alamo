AP_decomposition.phase_change.latent_heat = 100.0_cal/g
AP_decomposition.phase_change.reference_mass_flux = 11.70_kg/m^2/s
AP_decomposition.phase_change.reference_pressure = 3.0_MPa
AP_decomposition.phase_change.pressure_exponent = 0.4
AP_decomposition.phase_change.activation_temperature = 3145.0_K
AP_decomposition.phase_change.reference_temperature = 600.0_K

HTPB_pyrolysis.type = phase_change
HTPB_pyrolysis.phase_change.phase0 = HTPB_solid
HTPB_pyrolysis.phase_change.phase1 = HTPB_gas
HTPB_pyrolysis.phase_change.kinetics = arrhenius_surface_flux
HTPB_pyrolysis.phase_change.latent_heat = 300.0_cal/g
HTPB_pyrolysis.phase_change.reference_mass_flux = 5.52_kg/m^2/s
HTPB_pyrolysis.phase_change.reference_pressure = 3.0_MPa
HTPB_pyrolysis.phase_change.pressure_exponent = 0.4
HTPB_pyrolysis.phase_change.activation_temperature = 3145.0_K
HTPB_pyrolysis.phase_change.reference_temperature = 600.0_K

Al_melting.type = phase_change
