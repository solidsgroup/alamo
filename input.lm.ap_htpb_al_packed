# 3 MPa AP/HTPB packed-particle combustion with an inert aluminum obstacle
# Run with: mpirun -np 8 ./bin/lowmach-2d-clang++ input.lm.ap_htpb_al_packed
#
# The propellant bed is identical to input.lm.ap_htpb_packed. Aluminum is an
# inert, fixed rigid circle centered in the gas flow at (0, 0.25 mm), with a
# 75 um radius and 20 um diffuse boundary.

plot_file = output.lm.ap_htpb_al_packed
amr.plot_dt = 1.0e-4_s
amr.max_level = 2
amr.n_cell = 32 48
amr.max_grid_size = 16
amr.blocking_factor = 4
amr.regrid_int = 5
amr.grid_eff = 0.7
amr.nsubsteps = 1
amr.reinitialize_condensed_composition = 1
amr.reinitialize_condensed_composition_eta_min = 0.99

eta_refinement_criterion = 0.01
temperature_refinement_criterion = 500.0

timestep = 2.5e-6_s
stop_time = 1_s
dynamictimestep.on = 1
dynamictimestep.min = 1.0e-12
dynamictimestep.max = 2.5e-6
dynamictimestep.verbose = 0

integration.type = RungeKutta
integration.rk.type = 3

geometry.prob_lo = -0.0003_m -0.0004_m 0.0
geometry.prob_hi =  0.0003_m  0.0005_m 0.0
geometry.is_periodic = 1 0 0

# Gas species 0-5 retain the ordering required by the Rocfire mechanism:
# AP, binder, monopropellant, premixed, primary-flame, final-flame products.
system.amount = kmol
gas.mw = 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol
gas.thermo.type = rocfire
gas.thermo.rocfire.cp_mass = 0.3_cal/g/K
gas.thermo.rocfire.Tref = 273.15_K
gas.transport.type = rocfire
gas.transport.rocfire.prandtl = 0.69
gas.transport.rocfire.lewis = 1.0
gas.transport.rocfire.lambda_a = 2.13037e-7_cal/cm/s/K^2
gas.transport.rocfire.lambda_b = 5.32743e-6_cal/cm/s/K
gas.eos.type = rocfire

species.names = AP_gas HTPB_gas Mono Premixed Primary Final AP_solid HTPB_solid Al_solid
AP_gas.mechanics = fluid
HTPB_gas.mechanics = fluid
Mono.mechanics = fluid
Premixed.mechanics = fluid
Primary.mechanics = fluid
Final.mechanics = fluid
AP_solid.mechanics = rigid_solid
HTPB_solid.mechanics = rigid_solid
Al_solid.mechanics = rigid_solid
AP_solid.reference_density = 1950.0_kg/m^3
HTPB_solid.reference_density = 920.0_kg/m^3
Al_solid.reference_density = 2700.0_kg/m^3
AP_solid.specific_heat = 1297.90_J/kg/K
AP_solid.thermal_conductivity = 0.4186_W/m/K
HTPB_solid.specific_heat = 2418.29_J/kg/K
HTPB_solid.thermal_conductivity = 0.1300_W/m/K
Al_solid.specific_heat = 900.0_J/kg/K
Al_solid.thermal_conductivity = 237.0_W/m/K

chemistry.model.type = rocfire
chemistry.model.rocfire.A = 27.0e3_g/cm^3/s 25.3e3_g/cm^3/s 5.0e3_g/cm^3/s 0.4e3_g/cm^3/s
chemistry.model.rocfire.pressure_exponent = 1.6 1.7 1.7 1.7
chemistry.model.rocfire.activation_energy = 15.9_kcal/mol 14.5_kcal/mol 11.3_kcal/mol 14.5_kcal/mol
chemistry.model.rocfire.qgas = 430.0_cal/g 447.0_cal/g 8365.0_cal/g 2127.0_cal/g
chemistry.model.rocfire.qsolid = -100.0_cal/g -300.0_cal/g
chemistry.model.rocfire.pressure_reference = 1.0_bar
chemistry.solver.type = backward_euler
chemistry.solver.backward_euler.max_iter = 100
chemistry.solver.backward_euler.reltol = 1.0e-8
chemistry.solver.backward_euler.abstol = 1.0e-12

# AP and HTPB retain their phase-change mechanisms. Aluminum has no mechanism.
mechanisms.names = AP_decomposition HTPB_pyrolysis
AP_decomposition.type = phase_change
AP_decomposition.phase_change.phase0 = AP_solid
AP_decomposition.phase_change.phase1 = AP_gas
AP_decomposition.phase_change.rate_multiplier = 2450.0
AP_decomposition.phase_change.activation_temperature = 3145.0_K
AP_decomposition.phase_change.temperature_cutoff = 500.0_K
AP_decomposition.phase_change.phase_field.type = allencahn
AP_decomposition.phase_change.phase_field.allencahn.mobility = 0.01_1/Pa/s
AP_decomposition.phase_change.phase_field.allencahn.sigma = 0.001_J/m^2
AP_decomposition.phase_change.phase_field.allencahn.epsilon = 80.0_um
AP_decomposition.phase_change.phase_field.allencahn.w0 = 0.0
AP_decomposition.phase_change.phase_field.allencahn.w12 = 2.0
AP_decomposition.phase_change.phase_field.allencahn.w1 = 1.0

HTPB_pyrolysis.type = phase_change
HTPB_pyrolysis.phase_change.phase0 = HTPB_solid
HTPB_pyrolysis.phase_change.phase1 = HTPB_gas
HTPB_pyrolysis.phase_change.rate_multiplier = 2.333333333333333e5
HTPB_pyrolysis.phase_change.activation_temperature = 7500.0_K
HTPB_pyrolysis.phase_change.temperature_cutoff = 500.0_K
HTPB_pyrolysis.phase_change.phase_field.type = allencahn
HTPB_pyrolysis.phase_change.phase_field.allencahn.mobility = 0.01_1/Pa/s
HTPB_pyrolysis.phase_change.phase_field.allencahn.sigma = 0.001_J/m^2
HTPB_pyrolysis.phase_change.phase_field.allencahn.epsilon = 80.0_um
HTPB_pyrolysis.phase_change.phase_field.allencahn.w0 = 0.0
HTPB_pyrolysis.phase_change.phase_field.allencahn.w12 = 2.0
HTPB_pyrolysis.phase_change.phase_field.allencahn.w1 = 1.0

# All three condensed species use the same fixed rigid-body velocity.
rigid.relaxation_time = 1.0e-8_s
rigid.velocity = 0.0 0.0

advection.type = muscl
advection.muscl.limiter.type = minmod
cfl = 0.6
include_viscosity = 1
implicit_viscosity = 1
include_conduction = 1
advect_temperature = 1
projection.enabled = 1
projection.tol_rel = 1.0e-11
projection.tol_abs = 1.0e-12
projection.verbose = 0
projection.update_pressure = 1
diffusion.tol_rel = 1.0e-11
diffusion.tol_abs = 1.0e-12
diffusion.verbose = 0
#diagnostics.interval = 100
diagnostics.extended_fields = 0

# The common diffuse condensed/gas surface is y=0. The repeated minimum below
# is the signed distance to the nearest AP particle, including periodic x
# images. Its strict sign test gives a sharp AP/HTPB interface.
AP_solid.density.ic.type = expression
AP_solid.density.ic.expression.constant.lx = 0.0006_m
AP_solid.density.ic.expression.constant.surface_eps = 20.0_um
AP_solid.density.ic.expression.region0 = "max(0.0,1950.0*(0.5-0.5*tanh(2.0*y/surface_eps))*(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(sqrt(min(abs(x-0.000212027),lx-abs(x-0.000212027))^2+(y+0.000245644)^2)-0.000090469,sqrt(min(abs(x+0.000186936),lx-abs(x+0.000186936))^2+(y+0.000388514)^2)-0.000054547),sqrt(min(abs(x-0.000150453),lx-abs(x-0.000150453))^2+(y+0.000093352)^2)-0.000070068),sqrt(min(abs(x-0.000070208),lx-abs(x-0.000070208))^2+(y+0.000209450)^2)-0.000053770),sqrt(min(abs(x-0.000143329),lx-abs(x-0.000143329))^2+(y-0.000012354)^2)-0.000024986),sqrt(min(abs(x-0.000031362),lx-abs(x-0.000031362))^2+(y+0.000107995)^2)-0.000038929),sqrt(min(abs(x-0.000230716),lx-abs(x-0.000230716))^2+(y+0.000456106)^2)-0.000081700),sqrt(min(abs(x-0.000058581),lx-abs(x-0.000058581))^2+(y-0.000029289)^2)-0.000060200),sqrt(min(abs(x+0.000048469),lx-abs(x+0.000048469))^2+(y-0.000024128)^2)-0.000044095),sqrt(min(abs(x+0.000212179),lx-abs(x+0.000212179))^2+(y+0.000230820)^2)-0.000053568),sqrt(min(abs(x+0.000189514),lx-abs(x+0.000189514))^2+(y+0.000306588)^2)-0.000019553),sqrt(min(abs(x+0.000107792),lx-abs(x+0.000107792))^2+(y+0.000097680)^2)-0.000074271),sqrt(min(abs(x+0.000047578),lx-abs(x+0.000047578))^2+(y+0.000231102)^2)-0.000046028),sqrt(min(abs(x+0.000039162),lx-abs(x+0.000039162))^2+(y+0.000305670)^2)-0.000018794),sqrt(min(abs(x+0.000215391),lx-abs(x+0.000215391))^2+(y-0.000061670)^2)-0.000077416),sqrt(min(abs(x+0.000114102),lx-abs(x+0.000114102))^2+(y+0.000290286)^2)-0.000041517),sqrt(min(abs(x-0.000067205),lx-abs(x-0.000067205))^2+(y+0.000361096)^2)-0.000090053),sqrt(min(abs(x+0.000127409),lx-abs(x+0.000127409))^2+(y-0.000008924)^2)-0.000019393),sqrt(min(abs(x+0.000129299),lx-abs(x+0.000129299))^2+(y+0.000199588)^2)-0.000026344),sqrt(min(abs(x+0.000077346),lx-abs(x+0.000077346))^2+(y+0.000394822)^2)-0.000047122)<0.0))"

HTPB_solid.density.ic.type = expression
HTPB_solid.density.ic.expression.constant.lx = 0.0006_m
HTPB_solid.density.ic.expression.constant.surface_eps = 20.0_um
HTPB_solid.density.ic.expression.region0 = "max(0.0,920.0*(0.5-0.5*tanh(2.0*y/surface_eps))*(1.0-(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(min(sqrt(min(abs(x-0.000212027),lx-abs(x-0.000212027))^2+(y+0.000245644)^2)-0.000090469,sqrt(min(abs(x+0.000186936),lx-abs(x+0.000186936))^2+(y+0.000388514)^2)-0.000054547),sqrt(min(abs(x-0.000150453),lx-abs(x-0.000150453))^2+(y+0.000093352)^2)-0.000070068),sqrt(min(abs(x-0.000070208),lx-abs(x-0.000070208))^2+(y+0.000209450)^2)-0.000053770),sqrt(min(abs(x-0.000143329),lx-abs(x-0.000143329))^2+(y-0.000012354)^2)-0.000024986),sqrt(min(abs(x-0.000031362),lx-abs(x-0.000031362))^2+(y+0.000107995)^2)-0.000038929),sqrt(min(abs(x-0.000230716),lx-abs(x-0.000230716))^2+(y+0.000456106)^2)-0.000081700),sqrt(min(abs(x-0.000058581),lx-abs(x-0.000058581))^2+(y-0.000029289)^2)-0.000060200),sqrt(min(abs(x+0.000048469),lx-abs(x+0.000048469))^2+(y-0.000024128)^2)-0.000044095),sqrt(min(abs(x+0.000212179),lx-abs(x+0.000212179))^2+(y+0.000230820)^2)-0.000053568),sqrt(min(abs(x+0.000189514),lx-abs(x+0.000189514))^2+(y+0.000306588)^2)-0.000019553),sqrt(min(abs(x+0.000107792),lx-abs(x+0.000107792))^2+(y+0.000097680)^2)-0.000074271),sqrt(min(abs(x+0.000047578),lx-abs(x+0.000047578))^2+(y+0.000231102)^2)-0.000046028),sqrt(min(abs(x+0.000039162),lx-abs(x+0.000039162))^2+(y+0.000305670)^2)-0.000018794),sqrt(min(abs(x+0.000215391),lx-abs(x+0.000215391))^2+(y-0.000061670)^2)-0.000077416),sqrt(min(abs(x+0.000114102),lx-abs(x+0.000114102))^2+(y+0.000290286)^2)-0.000041517),sqrt(min(abs(x-0.000067205),lx-abs(x-0.000067205))^2+(y+0.000361096)^2)-0.000090053),sqrt(min(abs(x+0.000127409),lx-abs(x+0.000127409))^2+(y-0.000008924)^2)-0.000019393),sqrt(min(abs(x+0.000129299),lx-abs(x+0.000129299))^2+(y+0.000199588)^2)-0.000026344),sqrt(min(abs(x+0.000077346),lx-abs(x+0.000077346))^2+(y+0.000394822)^2)-0.000047122)<0.0)))"

# Inert aluminum occupies the gas-side circle. Multiplying by the gas-side
# complement of the bed profile prevents overlap with the propellant.
Al_solid.density.ic.type = expression
Al_solid.density.ic.expression.constant.surface_eps = 20.0_um
Al_solid.density.ic.expression.constant.al_y = 0.00025_m
Al_solid.density.ic.expression.constant.al_r = 75.0_um
Al_solid.density.ic.expression.constant.al_eps = 20.0_um
Al_solid.density.ic.expression.region0 = "max(0.0,2700.0*(0.5+0.5*tanh(2.0*y/surface_eps))*(0.5-0.5*tanh(2.0*(sqrt(x*x+(y-al_y)^2)-al_r)/al_eps)))"

# Final products fill the space outside both condensed regions.
Final.density.ic.type = expression
Final.density.ic.expression.constant.surface_eps = 20.0_um
Final.density.ic.expression.constant.al_y = 0.00025_m
Final.density.ic.expression.constant.al_r = 75.0_um
Final.density.ic.expression.constant.al_eps = 20.0_um
Final.density.ic.expression.region0 = "max(0.0,(0.5+0.5*tanh(2.0*y/surface_eps))*(0.5+0.5*tanh(2.0*(sqrt(x*x+(y-al_y)^2)-al_r)/al_eps))*3000000.0/(319.787*700.0))"

velocity.ic.type = constant
velocity.ic.constant.value = 0.0 0.0
temperature.ic.type = constant
temperature.ic.constant.value = 700.0
pressure.ic.type = constant
pressure.ic.constant.value = 3000000.0

