# 3D variant of input.lm.ap_htpb_packed_elastic_3d (diff against that file),
# created 2026-08-07 after root-causing that file's instability.
#
# BACKGROUND: input.lm.ap_htpb_packed_elastic_3d diverges at t~4e-5s (well
# before ignition) with a velocity blowup pinned to a fixed cell sitting
# inside an AP sphere that its domain's z_hi wall cuts through mid-grain. The
# cause is REFLECT_EVEN/REFLECT_ODD velocity BCs (used at x/z walls there)
# being fundamentally wrong for a randomly-packed bed truncated at the domain
# edge -- REFLECT synthesizes ghost cells as a MIRROR IMAGE of the interior,
# which has nothing to do with how a real random packing actually continues
# past the wall. An exhaustive scan of input.lm.ap_htpb_packed.xyzr showed NO
# cube half-width from 0.02mm to 0.30mm avoids sphere/wall crossings entirely
# (44% volume fraction bed, too dense for any crop to escape it), and that
# file's packing spans a large, non-cubic, non-periodic bounding box
# (x:+-0.945mm, y:-0.945 to +0.054mm settled bed, z:+-0.195mm) -- it was
# never designed to be periodic at any interior crop boundary, so simply
# setting geometry.is_periodic=1 on that data (tried first, see that file's
# history) is not self-consistent: it delayed the crash (t~4e-5s -> 6.9e-5s)
# but did not fix it, and also broke the elastic solve's well-posedness (a
# spatially-varying pressure load under periodic BCs is generally singular
# unless net force integrates to zero, which a random packed bed never
# satisfies exactly -- Newton line search failed immediately at STEP 1).
#
# FIX HERE: a genuinely periodic-in-x/z packing, generated fresh (not
# cropped from the old file) via periodic random sequential addition --
# spheres placed with minimum-image collision checking in x/z (not y, which
# stays the physical solid-substrate/open-gas axis, non-periodic). This is
# well-posed by construction: whatever crosses x=+h reappears exactly at
# x=-h because that IS how the data was generated, not an incidental
# property forced onto unrelated data.
#
# DOMAIN SIZE: the old 0.0625mm half-width domain cannot hold a periodic
# packing at a realistic volume fraction -- a single r=0.055mm sphere alone
# exceeds 44% of that domain's usable (y<0.15h slab) volume. Doubled to
# 0.125mm half-width (n_cell 40->80, dx held fixed at 3.125um) to fit ~5
# spheres at ~39% volume fraction -- see scripts/gen_periodic_packing.py.
#
# ELASTIC: left DISABLED here (elastic.type=disable) -- the periodic-BC
# well-posedness problem above is real and unresolved; the elastic solve is
# diagnostic-only (one-way, does not feed back into CFD/chemistry, see
# LowMach::UpdateModel) so disabling it does not affect the reacting-flow
# physics this file is meant to validate. Re-enable (copying the elastic
# block from input.lm.ap_htpb_packed_elastic_3d) only after separately
# resolving the periodic-load null-space issue.
#
#   mpirun -np 12 ./bin/lowmach-3d-clang++ input.lm.ap_htpb_packed_elastic_3d_periodic
#
# AP occupies ~39% of this generated bed's volume (target was 44%, matching
# input.lm.ap_htpb_packed.xyzr, but RSA placement fell slightly short within
# the attempt budget -- see the generator script). AP and HTPB partial volume
# fractions are exact complements (HTPB_solid.density.ic.psread.invert=1
# below).

plot_file = output.lm.ap_htpb_packed_elastic_3d_periodic
amr.plot_dt = 1.0e-4_s
amr.max_level = 0
amr.n_cell = 80 80 80
# max_grid_size=blocking_factor=8: 8=2^3 divides n_cell=80 evenly and
# cleanly (10x10x10=1000 boxes) -- see the box-decomposition tuning note in
# input.lm.ap_htpb_packed_elastic_3d (ported here for the same reason).
amr.max_grid_size = 8
amr.blocking_factor = 8
amr.regrid_int = 5
amr.grid_eff = 0.7
amr.nsubsteps = 1
amr.reinitialize_condensed_composition = 1
amr.reinitialize_condensed_composition_eta_min = 0.99
# Elastic fields would be nodal; harmless to leave these mirroring flags in
# place even with elastic.type=disable above.
amr.cell.all = 1
amr.node.any = 0

# Inert with amr.max_level = 0 above -- left in place in case AMR is ever
# restorable here.
eta_refinement_criterion = 0.5
temperature_refinement_criterion = 1.0
velocity_refinement_criterion = 1.0

timestep = 1.0e-7_s
stop_time = 35_ms
dynamictimestep.on = 1
dynamictimestep.min = 1.0e-12
dynamictimestep.max = 5.0e-6
dynamictimestep.verbose = 0

integration.type = RungeKutta
integration.rk.type = 3

# Domain doubled from input.lm.ap_htpb_packed_elastic_3d's 0.0625mm
# half-width to 0.125mm -- see the DOMAIN SIZE note above. dx held fixed at
# 3.125um (0.25mm/80 = 0.125mm/... wait: 0.25mm total / 80 cells = 3.125um,
# matching the old file's dx exactly, so psread eps/plane.eps below are
# unchanged).
geometry.prob_lo = -0.125_mm -0.125_mm -0.125_mm
geometry.prob_hi =  0.125_mm  0.125_mm  0.125_mm
geometry.is_periodic = 1 0 1

# Gas species 0-5 retain the ordering required by the Rocfire mechanism:
# AP, binder, monopropellant, premixed, primary-flame, final-flame products.
system.amount = kmol
gas.mw = 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol
gas.thermo.type = rocfire
gas.thermo.rocfire.mw = 26.0_g/mol
gas.thermo.rocfire.cp_mass = 0.3_cal/g/K
gas.thermo.rocfire.Tref = 273.15_K
gas.transport.type = rocfire
gas.transport.rocfire.mw = 26.0_g/mol
gas.transport.rocfire.prandtl = 0.69
gas.transport.rocfire.lewis = 1.0
gas.transport.rocfire.lambda_a = 2.13037e-7_cal/cm/s/K^2
gas.transport.rocfire.lambda_b = 5.32743e-6_cal/cm/s/K
gas.eos.type = tpg

species.names = AP_gas HTPB_gas Mono Premixed Primary Final AP_solid HTPB_solid
AP_gas.mechanics = fluid
HTPB_gas.mechanics = fluid
Mono.mechanics = fluid
Premixed.mechanics = fluid
Primary.mechanics = fluid
Final.mechanics = fluid
AP_solid.mechanics = rigid_solid
HTPB_solid.mechanics = rigid_solid
AP_solid.reference_density = 1950.0_kg/m^3
HTPB_solid.reference_density = 920.0_kg/m^3
AP_solid.specific_heat = 1297.90_J/kg/K
AP_solid.thermal_conductivity = 0.4186_W/m/K
HTPB_solid.specific_heat = 2418.29_J/kg/K
HTPB_solid.thermal_conductivity = 0.1300_W/m/K

chemistry.model.type = rocfire
chemistry.model.rocfire.A = 27.0e3_g/cm^3/s 25.3e3_g/cm^3/s 5.0e3_g/cm^3/s 0.4e3_g/cm^3/s
chemistry.model.rocfire.pressure_exponent = 1.6 1.7 1.7 1.7
chemistry.model.rocfire.activation_energy = 15.9_kcal/mol 14.5_kcal/mol 11.3_kcal/mol 14.5_kcal/mol
chemistry.model.rocfire.qgas = 430.0_cal/g 447.0_cal/g 8365.0_cal/g 2127.0_cal/g
chemistry.model.rocfire.qsolid = -100.0_cal/g -300.0_cal/g
chemistry.model.rocfire.pressure_reference = 1.0_bar
chemistry.solver.type = backward_euler
chemistry.solver.backward_euler.max_iter = 100
chemistry.solver.backward_euler.reltol = 1.0e-8
chemistry.solver.backward_euler.abstol = 1.0e-12

# AP uses the 1-6 MPa monopropellant calibration from LMRFMonoAP. HTPB uses the
# approximately 4 mm/s calibration from the 3 MPa sandwich configuration.
# The phase-field gradient terms are integrated implicitly.
mechanisms.names = AP_decomposition HTPB_pyrolysis
AP_decomposition.type = phase_change
AP_decomposition.phase_change.in = AP_solid
AP_decomposition.phase_change.out = AP_gas
AP_decomposition.phase_change.rate_multiplier = 2.75e6
AP_decomposition.phase_change.activation_temperature = 3145.0_K
AP_decomposition.phase_change.temperature_cutoff = 360.0_K
AP_decomposition.phase_change.phase_field.type = allencahn
AP_decomposition.phase_change.phase_field.allencahn.mobility = 0.01_1/Pa/s
AP_decomposition.phase_change.phase_field.allencahn.lambda = 8.333333333333333_Pa
AP_decomposition.phase_change.phase_field.allencahn.kappa = 1.0e-8_J/m
AP_decomposition.phase_change.phase_field.allencahn.w0 = 0.0
AP_decomposition.phase_change.phase_field.allencahn.w12 = 2.0
AP_decomposition.phase_change.phase_field.allencahn.w1 = 1.0

HTPB_pyrolysis.type = phase_change
HTPB_pyrolysis.phase_change.in = HTPB_solid
HTPB_pyrolysis.phase_change.out = HTPB_gas
HTPB_pyrolysis.phase_change.rate_multiplier = 1.85e5
HTPB_pyrolysis.phase_change.activation_temperature = 3145.0_K
HTPB_pyrolysis.phase_change.temperature_cutoff = 360.0_K
HTPB_pyrolysis.phase_change.phase_field.type = allencahn
HTPB_pyrolysis.phase_change.phase_field.allencahn.mobility = 0.01_1/Pa/s
HTPB_pyrolysis.phase_change.phase_field.allencahn.lambda = 8.333333333333333_Pa
HTPB_pyrolysis.phase_change.phase_field.allencahn.kappa = 1.0e-8_J/m
HTPB_pyrolysis.phase_change.phase_field.allencahn.w0 = 0.0
HTPB_pyrolysis.phase_change.phase_field.allencahn.w12 = 2.0
HTPB_pyrolysis.phase_change.phase_field.allencahn.w1 = 1.0

rigid.relaxation_time = 1.0e-8_s
rigid.velocity = 0.0 0.0 0.0

advection.type = muscl
advection.muscl.limiter.type = minmod
cfl = 0.8
phase_field.cfl = 1.5
include_viscosity = 1
implicit_viscosity = 1
include_conduction = 1
advect_temperature = 1
projection.enabled = 1
projection.tol_rel = 1.0e-11
projection.tol_abs = 1.0e-12
projection.verbose = 0
projection.update_pressure = 1
diffusion.tol_rel = 1.0e-11
diffusion.tol_abs = 1.0e-12
diffusion.verbose = 0
#diagnostics.interval = 100
diagnostics.extended_fields = 0

# The common diffuse condensed/gas surface is y=0. Both species read the same
# packing; inversion makes HTPB the exact complement of AP inside the bed.
# eps/plane.eps unchanged from input.lm.ap_htpb_packed_elastic_3d -- dx is
# the same (3.125um), see the geometry.prob_lo/hi note above.
AP_solid.density.ic.type = psread
AP_solid.density.ic.psread.file.name = input.lm.ap_htpb_packed_periodic_250um.xyzr
AP_solid.density.ic.psread.file.unit = mm
AP_solid.density.ic.psread.eps = 10.0_um
AP_solid.density.ic.psread.value = 1950.0_kg/m^3
AP_solid.density.ic.psread.plane.point = 0.0_mm 0.0_mm 0.0_mm
AP_solid.density.ic.psread.plane.normal = 0.0 -1.0 0.0
AP_solid.density.ic.psread.plane.eps = 40.0_um

HTPB_solid.density.ic.type = psread
HTPB_solid.density.ic.psread.file.name = input.lm.ap_htpb_packed_periodic_250um.xyzr
HTPB_solid.density.ic.psread.file.unit = mm
HTPB_solid.density.ic.psread.eps = 10.0_um
HTPB_solid.density.ic.psread.value = 920.0_kg/m^3
HTPB_solid.density.ic.psread.invert = 1
HTPB_solid.density.ic.psread.plane.point = 0.0_mm 0.0_mm 0.0_mm
HTPB_solid.density.ic.psread.plane.normal = 0.0 -1.0 0.0
HTPB_solid.density.ic.psread.plane.eps = 40.0_um

# The gas initially contains final products above the packed bed. Initialize
# the gas consistently with the thermal penetration profile so that pressure
# is uniform at startup.
Final.density.ic.type = expression
Final.density.ic.expression.constant.P = 3.0e6
Final.density.ic.expression.constant.Tambient = 300.0_K
Final.density.ic.expression.constant.Tignite = 400.0_K
Final.density.ic.expression.constant.Lsolid = 100.0_um
Final.density.ic.expression.constant.Lgas = 250.0_um
Final.density.ic.expression.region0 = "max(0.0,(0.5+0.5*tanh(2.0*y/20.0e-6))*P/(319.787*(Tambient+(Tignite-Tambient)*exp(-max(-y,0.0)/Lsolid-max(y,0.0)/Lgas))))"

velocity.ic.type = constant
velocity.ic.constant.value = 0.0
temperature.ic.type = expression
temperature.ic.expression.constant.Tambient = 300.0_K
temperature.ic.expression.constant.Tignite = 400.0_K
temperature.ic.expression.constant.Lsolid = 100.0_um
temperature.ic.expression.constant.Lgas = 250.0_um
temperature.ic.expression.region0 = "Tambient+(Tignite-Tambient)*exp(-max(-y,0.0)/Lsolid-max(y,0.0)/Lgas)"
pressure.ic.type = constant
pressure.ic.constant.value = 3000000.0

# Ignition flux, localized to a circular patch (radius = 1/8 of the domain's
# x length, centered on x=z=0) rather than spanning the whole x-z extent.
# The radial cutoff is smoothed with the same tanh transition width used for
# the through-thickness (y) profile. radius = 31.25um = 1/8 of this file's
# 250um domain x length (unchanged numeric value from
# input.lm.ap_htpb_packed_elastic_3d purely by coincidence -- that file's
# domain was also sized so 1/8 its x length came out to the same number
# after an earlier, since-reverted, doubling).
heat_source.ic.type = expression
heat_source.ic.expression.unit = W/m^3
heat_source.ic.expression.constant.qflux = 1.0e7_W/m^2
heat_source.ic.expression.constant.width = 6.25e-6_m
heat_source.ic.expression.constant.norm = 1.772453850905516
heat_source.ic.expression.constant.toff = 2.5e-4_s
heat_source.ic.expression.constant.tramp = 1.0e-5_s
heat_source.ic.expression.constant.radius = 31.25e-6_m
heat_source.ic.expression.region0 = "qflux*exp(-(y/width)^2)/(norm*width)*0.5*(1.0-tanh((t-toff)/tramp))*0.5*(1.0-tanh((sqrt(x^2+z^2)-radius)/width))"

# x/z faces are periodic (see geometry.is_periodic above). y (ylo/yhi) is
# the physical solid-substrate/open-gas axis, unchanged.
component_density.bc.type = constant
component_density.bc.constant.type.xlo = periodic
component_density.bc.constant.type.xhi = periodic
component_density.bc.constant.type.ylo = neumann
component_density.bc.constant.type.yhi = neumann
component_density.bc.constant.type.zlo = periodic
component_density.bc.constant.type.zhi = periodic

velocity.bc.type = constant
velocity.bc.constant.type.xlo = periodic periodic periodic
velocity.bc.constant.type.xhi = periodic periodic periodic
velocity.bc.constant.type.ylo = dirichlet
velocity.bc.constant.type.yhi = neumann
velocity.bc.constant.type.zlo = periodic periodic periodic
velocity.bc.constant.type.zhi = periodic periodic periodic
velocity.bc.constant.val.ylo = 0.0

temperature.bc.type = constant
temperature.bc.constant.type.xlo = periodic
temperature.bc.constant.type.xhi = periodic
temperature.bc.constant.type.ylo = neumann
temperature.bc.constant.type.yhi = neumann
temperature.bc.constant.type.zlo = periodic
temperature.bc.constant.type.zhi = periodic

pressure.bc.type = constant
pressure.bc.constant.type.xlo = periodic
pressure.bc.constant.type.xhi = periodic
pressure.bc.constant.type.ylo = neumann
pressure.bc.constant.type.yhi = dirichlet
pressure.bc.constant.type.zlo = periodic
pressure.bc.constant.type.zhi = periodic
pressure.bc.constant.val.yhi = 3000000.0

# Elastic solve DISABLED -- see the ELASTIC note at the top of this file.
elastic.type = disable
allow_unused=True
