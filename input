plot_file = ./output

### MESHING ###

amr.plot_dt = 5.0
#amr.plot_int = 1000
amr.max_grid_size = 500000
amr.blocking_factor = 4
amr.regrid_int = 100
amr.grid_eff = 0.8
amr.cell.all = 1


amr.max_level = 1
timestep  = 1.0e-4
amr.n_cell = 60 32

system.amount = kmol
gas.mw = 28.0_g/mol

gas.thermo.type = cpconstant
gas.thermo.cpconstant.cp_moles = 29.1_J/mol/K
gas.thermo.cpconstant.h0 = 0.0
gas.thermo.cpconstant.s0 = 0.0
gas.thermo.cpconstant.Tref = 0.0_K

gas.transport.type = mixture_averaged
gas.transport.mixture_averaged.type = constant
gas.transport.mixture_averaged.mu = 3.0_Pa*s
gas.transport.mixture_averaged.k = 0.023_W/m/K

gas.eos.type = cpg

solver.type = hllc

### DIMENSIONS ###

solid.model.type = finite.neohookean
solid.model.finite.neohookean.mu = 10000.0
solid.model.finite.neohookean.kappa = 1000.0
solid.model.eta_threshold = 0.1
solid.model.viscosity = 1.0
solid.model.bulk_viscosity = 0.0
solid.model.J_floor = 1.0e-3
solid.model.stress_cap = 1.0e6
solid.model.stress_rhs_sign = 1.0
solid.model.pressure_split = 1
solid.model.pressure_reference = 0.0
solid.model.reference_density = 100.0
solid.reference_map.relaxation = 0.0
solid.reference_map.relaxation_eta_cutoff = 0.5
solid.reference_map.extrapolation_cutoff = 0.5
solid.reference_map.extrapolation_sweeps = 4
solid.reference_map.smoothing_sweeps = 2
eta.ch.enabled = 1
eta.ch.mobility = 1.0e-4
eta.ch.kappa = 1.0e-2
eta.ch.barrier = 1.0


integration.type = RungeKutta
integration.rk.type = 4


geometry.prob_lo = -6.0 -5.0 0.0 # [ m ] 
geometry.prob_hi =  14.0 5.0 0.0 # [ m ]

geometry.is_periodic = 0 0 0

### TIME STEP ###

stop_time = 100.0

