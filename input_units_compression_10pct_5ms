crack.ic.png.coord.hi = 0.125 -0.125
crack.ic.png.channel = r

crack.bc.type.xhi = NEUMANN
crack.bc.type.xlo = NEUMANN
crack.bc.type.yhi = NEUMANN
crack.bc.type.ylo = NEUMANN

material.ic.type = png
material.ic.png.filename = "output_red_nonblue_blurred.png"
#material.ic.png.fit = stretch
material.ic.png.fit = coord
material.ic.png.coord.lo = -0.125 0.125
material.ic.png.coord.hi = 0.125 -0.125
material.ic.png.channel = b

#material.model1.type = isotropic
material.model1.E = 5.0 # inclusion
material.model1.nu = 0.21

#material.model2.type = isotropic
material.model2.E = 2.0
material.model2.nu = 0.28

material.refinement_threshold = 100 #1.e-1

### Mode-I test
# Tension testing
bc.type = constant
bc.constant.type.xloylo = disp disp
bc.constant.type.xlo    = disp trac
bc.constant.type.xloyhi = disp disp
bc.constant.type.ylo    = trac disp
bc.constant.type.yhi    = trac disp
bc.constant.type.xhi    = disp trac
bc.constant.type.xhiylo = disp disp
bc.constant.type.xhiyhi = disp disp
bc.constant.val.xlo =    (0,1.25e-3:0,-0.00275) 0.0
bc.constant.val.xhi =    (0,1.25e-3:0,0.00275) 0.0
bc.constant.val.xloylo = (0,1.25e-3:0,-0.00275) 0.0
