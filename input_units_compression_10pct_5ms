alamo.program = fracture

system.length = m
system.time = s

timestep = 1.25e-5_s
stop_time = 5.0e-3_s

plot_file = output_debonding_compression_10pct_5ms
amr.plot_int = 20
amr.max_level = 2
amr.n_cell = 128 128
amr.blocking_factor = 32
amr.regrid_int = 10
amr.grid_eff = 0.9
amr.thermo.int = 1
amr.thermo.plot_int = 1
amr.nsubsteps = 1
amr.node.any = 0
amr.cell.all = 1

geometry.prob_lo = -0.125_m -0.125_m
geometry.prob_hi = 0.125_m 0.125_m
geometry.is_periodic = 0 0

crack.refinement_threshold = 0.1
crack.df.tol_rel = 0.01
crack.df.tol_abs = 0.0

crack.df.mult_Gc = 0.3
crack.df.mult_lap = 1.0
crack.df.beta = 0.0
crack.df.el_mult = 1.e11

crack.model1.G_c = 2.e6_N/m # crystal toughness 1000x baseline
crack.model1.fracture_strength = 1.e10_Pa # scaled to preserve PFCZM process-zone length
crack.model1.E = 4.e11_Pa
crack.model1.zeta = 2.e-4
crack.model1.mobility = 2.4e-5
crack.model1.gtype = wu_linear
crack.model1.wtype = wu
crack.model1.threshold = 0.0 

crack.model2.G_c = 4.e1_N/m # soften binder for interface debonding
crack.model2.fracture_strength = 1.e8_Pa
crack.model2.E = 4.e11_Pa
crack.model2.zeta = 2.e-4
crack.model2.mobility = 1.0e-6
crack.model2.gtype = wu_linear
crack.model2.wtype = wu
crack.model2.threshold = 0.0 # permit binder debonding

