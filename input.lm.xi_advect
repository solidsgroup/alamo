# LowMach reference-map advection case
# Run with: ./bin/lowmach-2d-clang++ input.lm.xi_advect

plot_file = output.lm.xi_advect
amr.plot_int = 10
amr.max_grid_size = 64
amr.blocking_factor = 4
amr.regrid_int = 2
amr.max_level = 0
amr.nsubsteps = 1
amr.n_cell = 96 64
eta_refinement_criterion = 1.0e100

timestep = 5.0e-4
stop_time = 0.2

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 0.75 0.5 0.0
geometry.is_periodic = 1 1 0

system.amount = kmol
gas.mw = 28.0_g/mol
gas.thermo.type = cpconstant
gas.thermo.cpconstant.cp_moles = 29.1_J/mol/K
gas.thermo.cpconstant.h0 = 0.0
gas.thermo.cpconstant.s0 = 0.0
gas.thermo.cpconstant.Tref = 0.0_K
gas.transport.type = mixture_averaged
gas.transport.mixture_averaged.type = constant
gas.transport.mixture_averaged.mu = 1.0e-3_Pa*s
gas.transport.mixture_averaged.k = 0.02_W/m/K
gas.eos.type = cpg
species.names = ambient_gas solid
ambient_gas.mechanics = fluid
solid.mechanics = deformable_solid

cfl = 0.25
include_viscosity = 0
include_conduction = 0
advect_temperature = 0
projection.enabled = 0

reference_map.eta_core = 0.65
reference_map.eta_extension = 1.0e-3
reference_map.extrapolation_sweeps = 6
reference_map.smoothing_sweeps = 3

solid.model.type = finite.neohookean
solid.model.reference_density = 1.0_kg/m^3
solid.model.eta_threshold = 0.5
solid.model.J_floor = 1.0e-6
solid.model.deviatoric_stress_divergence_sign = 0.0
solid.model.viscosity = 0.0
solid.model.finite.neohookean.mu = 5.0e-2_Pa
solid.model.finite.neohookean.kappa = 5.0e-1_Pa

component_density.ic.type = expression
component_density.ic.expression.constant.rhog = 1.12254198039921
component_density.ic.expression.constant.rhos = 1.0
component_density.ic.expression.constant.eps = 0.012
component_density.ic.expression.constant.x0 = 0.25
component_density.ic.expression.constant.y0 = 0.22
component_density.ic.expression.constant.R = 0.07
component_density.ic.expression.region0 = "rhog*0.5*(1.0+tanh((sqrt((x-x0)*(x-x0)+(y-y0)*(y-y0))-R)/eps))"
component_density.ic.expression.region1 = "rhos*(1.0-0.5*(1.0+tanh((sqrt((x-x0)*(x-x0)+(y-y0)*(y-y0))-R)/eps)))"
velocity.ic.type = constant
velocity.ic.constant.value = 0.08 0.03
temperature.ic.type = constant
temperature.ic.constant.value = 300.0
pressure.ic.type = constant
pressure.ic.constant.value = 100000.0

# Passive solid component for reference-map advection tests.
# xi is initialized internally as xi(x,0)=x.
component_density.bc.type = constant
component_density.bc.constant.type.xlo = periodic periodic
component_density.bc.constant.type.xhi = periodic periodic
component_density.bc.constant.type.ylo = periodic periodic
component_density.bc.constant.type.yhi = periodic periodic
component_density.bc.constant.val.xlo = 0.0 0.0
component_density.bc.constant.val.xhi = 0.0 0.0
component_density.bc.constant.val.ylo = 0.0 0.0
component_density.bc.constant.val.yhi = 0.0 0.0

velocity.bc.type = constant
velocity.bc.constant.type.xlo = periodic periodic
velocity.bc.constant.type.xhi = periodic periodic
velocity.bc.constant.type.ylo = periodic periodic
velocity.bc.constant.type.yhi = periodic periodic
velocity.bc.constant.val.xlo = 0.08 0.03
velocity.bc.constant.val.xhi = 0.08 0.03
velocity.bc.constant.val.ylo = 0.08 0.03
velocity.bc.constant.val.yhi = 0.08 0.03

temperature.bc.type = constant
temperature.bc.constant.type.xlo = periodic
temperature.bc.constant.type.xhi = periodic
temperature.bc.constant.type.ylo = periodic
temperature.bc.constant.type.yhi = periodic
temperature.bc.constant.val.xlo = 0.0
temperature.bc.constant.val.xhi = 0.0
temperature.bc.constant.val.ylo = 0.0
temperature.bc.constant.val.yhi = 0.0

pressure.bc.type = constant
pressure.bc.constant.type.xlo = periodic
pressure.bc.constant.type.xhi = periodic
pressure.bc.constant.type.ylo = periodic
pressure.bc.constant.type.yhi = periodic
pressure.bc.constant.val.xlo = 0.0
pressure.bc.constant.val.xhi = 0.0
pressure.bc.constant.val.ylo = 0.0
pressure.bc.constant.val.yhi = 0.0


xi.bc.type = constant
xi.bc.constant.type.xlo = periodic
xi.bc.constant.type.xhi = periodic
xi.bc.constant.type.ylo = periodic
xi.bc.constant.type.yhi = periodic
xi.bc.constant.val.xlo = 0.0 0.0
xi.bc.constant.val.xhi = 0.0 0.0
xi.bc.constant.val.ylo = 0.0 0.0
xi.bc.constant.val.yhi = 0.0 0.0
