#!/usr/bin/env bash
# .githooks/pre-commit -- fast gate. Device-pattern lint.
# Keep it fast: no build/test steps here.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ ! -x benchmark/lint_device_patterns.sh ]; then
  echo "pre-commit: benchmark/lint_device_patterns.sh missing or not executable" >&2
  exit 1
fi

benchmark/lint_device_patterns.sh
lint_status=$?
if [ "$lint_status" -ne 0 ]; then
  exit "$lint_status"
fi
