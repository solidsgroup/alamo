set -euo pipefail
cd /work/brunnels/mungerct/alamo
module purge
module load git
module load openmpi gcc eigen
make clean
./configure --get-eigen --dim=2 --comp=g++
srun --ntasks=1 --cpus-per-task=16 make -j16 bin/lowmach-2d-g++
