# Allen-Cahn recession of a dense diffuse rigid sphere in a cross flow
# Run with: mpirun -np 2 ./bin/lowmach-2d-clang++ input.lm.rigid_effusion

plot_file = output.lm.rigid_effusion
amr.plot_dt = 0.01
amr.max_grid_size = 24
amr.blocking_factor = 4
amr.regrid_int = 5
amr.max_level = 2
amr.nsubsteps = 1
amr.n_cell = 96 48
amr.grid_eff = 0.7

eta_refinement_criterion = 0.01

timestep = 2.0e-4
stop_time = 0.2
dynamictimestep.on = 1
dynamictimestep.min = 1.0e-8
dynamictimestep.max = 5.0e-4
dynamictimestep.verbose = 0
integration.type = RungeKutta
integration.rk.type = 3

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 2.0 1.0 0.0
geometry.is_periodic = 0 1 0

system.amount = kmol
gas.mw = 26.98_g/mol 28.0_g/mol
gas.thermo.type = cpconstant
gas.thermo.cpconstant.cp_moles = 20.8_J/mol/K 29.1_J/mol/K
gas.thermo.cpconstant.h0 = 0.0 0.0
gas.thermo.cpconstant.s0 = 0.0 0.0
gas.thermo.cpconstant.Tref = 0.0_K 0.0_K
gas.transport.type = mixture_averaged
gas.transport.mixture_averaged.type = constant
gas.transport.mixture_averaged.mu = 1.0e-3_Pa*s 1.0e-3_Pa*s
gas.transport.mixture_averaged.k = 0.02_W/m/K 0.02_W/m/K
gas.eos.type = cpg

# Component order remains significant for the corresponding gas property arrays.
species.names = Al_gas ambient_gas Al_solid

Al_gas.mechanics = fluid
ambient_gas.mechanics = fluid
Al_solid.mechanics = rigid_solid
Al_solid.reference_density = 100.0_kg/m^3
Al_solid.rigid.motion = free

mechanisms.names = Al_sublimation
Al_sublimation.type = phase_change
Al_sublimation.phase_change.phase0 = Al_solid
Al_sublimation.phase_change.phase1 = Al_gas
Al_sublimation.phase_change.phase_field.type = allencahn

Al_solid.rigid.relaxation_time = 5.0e-5_s

Al_sublimation.phase_change.phase_field.allencahn.mobility = 20.0_1/Pa/s
Al_sublimation.phase_change.phase_field.allencahn.sigma = 0.02_J/m^2
Al_sublimation.phase_change.phase_field.allencahn.epsilon = 0.025_m

advection.type = muscl
advection.muscl.limiter.type = minmod
cfl = 0.2
include_viscosity = 1
include_conduction = 0
advect_temperature = 0
projection.enabled = 1
projection.tol_rel = 1.0e-11
projection.tol_abs = 1.0e-12
projection.verbose = 0
projection.update_pressure = 1
diagnostics.interval = 20
diagnostics.extended_fields = 0

# This is the equilibrium planar-interface profile for the sigma/epsilon
# conversion used by Model::PhaseField::AllenCahn.
ambient_gas.density.ic.type = expression
ambient_gas.density.ic.expression.constant.rhog = 1.12254198039921
ambient_gas.density.ic.expression.constant.x0 = 0.5
ambient_gas.density.ic.expression.constant.y0 = 0.5
ambient_gas.density.ic.expression.constant.R = 0.12
ambient_gas.density.ic.expression.constant.eps = 0.025
ambient_gas.density.ic.expression.region0 = "rhog*0.5*(1.0+tanh(2.0*(sqrt((x-x0)*(x-x0)+(y-y0)*(y-y0))-R)/eps))"
Al_solid.density.ic.type = expression
Al_solid.density.ic.expression.constant.rhos = 100.0
Al_solid.density.ic.expression.constant.x0 = 0.5
Al_solid.density.ic.expression.constant.y0 = 0.5
Al_solid.density.ic.expression.constant.R = 0.12
Al_solid.density.ic.expression.constant.eps = 0.025
Al_solid.density.ic.expression.region0 = "rhos*(1.0-0.5*(1.0+tanh(2.0*(sqrt((x-x0)*(x-x0)+(y-y0)*(y-y0))-R)/eps)))"

velocity.ic.type = constant
velocity.ic.constant.value = 5.0 0.0
temperature.ic.type = constant
temperature.ic.constant.value = 300.0
pressure.ic.type = constant
pressure.ic.constant.value = 100000.0

component_density.bc.type = constant
component_density.bc.constant.type.xlo = dirichlet dirichlet dirichlet
component_density.bc.constant.type.xhi = neumann neumann neumann
component_density.bc.constant.type.ylo = neumann neumann neumann
component_density.bc.constant.type.yhi = neumann neumann neumann
component_density.bc.constant.val.xlo = 0.0 1.12254198039921 0.0
component_density.bc.constant.val.xhi = 0.0 0.0 0.0
component_density.bc.constant.val.ylo = 0.0 0.0 0.0
component_density.bc.constant.val.yhi = 0.0 0.0 0.0

velocity.bc.type = constant
velocity.bc.constant.type.xlo = dirichlet dirichlet
velocity.bc.constant.type.xhi = neumann neumann
velocity.bc.constant.type.ylo = neumann neumann
velocity.bc.constant.type.yhi = neumann neumann
velocity.bc.constant.val.xlo = 5.0 0.0
velocity.bc.constant.val.xhi = 0.0 0.0
velocity.bc.constant.val.ylo = 0.0 0.0
velocity.bc.constant.val.yhi = 0.0 0.0

temperature.bc.type = constant
temperature.bc.constant.type.xlo = neumann
temperature.bc.constant.type.xhi = neumann
temperature.bc.constant.type.ylo = neumann
temperature.bc.constant.type.yhi = neumann
temperature.bc.constant.val.xlo = 0.0
temperature.bc.constant.val.xhi = 0.0
temperature.bc.constant.val.ylo = 0.0
temperature.bc.constant.val.yhi = 0.0

# The pressure correction is zero at the downstream ambient boundary.
pressure.bc.type = constant
pressure.bc.constant.type.xlo = neumann
pressure.bc.constant.type.xhi = dirichlet
pressure.bc.constant.type.ylo = neumann
pressure.bc.constant.type.yhi = neumann
pressure.bc.constant.val.xlo = 0.0
pressure.bc.constant.val.xhi = 100000.0
pressure.bc.constant.val.ylo = 0.0
pressure.bc.constant.val.yhi = 0.0
