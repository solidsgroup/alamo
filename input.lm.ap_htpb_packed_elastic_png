# Localized ignition, following input.lm.ap_htpb_packed_ignition_10MWm2: a
# Gaussian spot in x (z=0 in 2D) centered at x=0, restricted to the condensed
# side of the interface by (0.5-0.5*tanh(y/width)), with a compensating
# factor of 2.0 so qflux is still the flux integral through y. radius = 10um
# is scaled down from that file's 100um so the spot stays clearly localized
# within the crop rather than spanning most of it. NOTE: domain x half-width
# is now 0.4mm (see amr.n_cell/geometry.prob_lo comments above), so
# radius=10um is a much smaller fraction of the domain than originally tuned
# (~2.5% vs. ~10%) -- revisit if/when heat_source is re-enabled (currently
# qflux=0 for debugging, see below).
# DEBUG: qflux forced to 0 to isolate whether the NaN blowup at step ~4 is
# driven by the ignition heat source (active from t=0 -- the ramp factor
# 0.5*(1-tanh((t-toff)/tramp)) is ~1, i.e. full heating, for all t << toff)
# or by the elastic solve's loosened tolerance. Restore to 1.0e7_W/m^2 once
# isolated.
heat_source.ic.type = expression
heat_source.ic.expression.unit = W/m^3
heat_source.ic.expression.constant.qflux = 0.0_W/m^2
heat_source.ic.expression.constant.radius = 10.0_um
heat_source.ic.expression.constant.width = 6.25e-6_m
heat_source.ic.expression.constant.norm = 1.772453850905516
heat_source.ic.expression.constant.toff = 2.5e-4_s
heat_source.ic.expression.constant.tramp = 1.0e-5_s
heat_source.ic.expression.region0 = "2.0*qflux*exp(-(x*x)/(radius*radius))*exp(-(y/width)^2)/(norm*width)*(0.5-0.5*tanh(y/width))*0.5*(1.0-tanh((t-toff)/tramp))"

