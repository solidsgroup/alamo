velocity.bc.constant.type.xhi = REFLECT_ODD REFLECT_EVEN REFLECT_EVEN
velocity.bc.constant.type.ylo = dirichlet
velocity.bc.constant.type.yhi = neumann
velocity.bc.constant.type.zlo = REFLECT_EVEN REFLECT_EVEN REFLECT_ODD
velocity.bc.constant.type.zhi = REFLECT_EVEN REFLECT_EVEN REFLECT_ODD
velocity.bc.constant.val.ylo = 0.0

temperature.bc.type = constant
temperature.bc.constant.type.xlo = neumann
temperature.bc.constant.type.xhi = neumann
temperature.bc.constant.type.ylo = neumann
temperature.bc.constant.type.yhi = neumann
temperature.bc.constant.type.zlo = neumann
temperature.bc.constant.type.zhi = neumann

pressure.bc.type = constant
pressure.bc.constant.type.xlo = neumann
pressure.bc.constant.type.xhi = neumann
pressure.bc.constant.type.ylo = neumann
pressure.bc.constant.type.yhi = dirichlet
pressure.bc.constant.type.zlo = neumann
pressure.bc.constant.type.zhi = neumann
pressure.bc.constant.val.yhi = 3000000.0

# Elastic solve over the condensed (rigid_solid) phase, driven purely by the
# local gas pressure (elastic.traction = 0, elastic.apply_fluid_pressure = 1
# -- see LowMach::UpdateModel and tests/LowMachElasticPressure). The bed
# regresses (mechanisms.names above), so rigid_eta moves and the elastic
# solve must be re-run periodically to track it; elastic.interval throttles
# this against the ~1e-7-5e-6s advective/chemistry timestep so the 1-Newton-
# iteration MLMG solve (default elastic.nriters = 1, see
# Base::Mechanics::Register) does not dominate runtime.
elastic.type = static
# Confirmed via output.lm.ap_htpb_packed_elastic_coarse_mesh (completed run
# of input.lm.ap_htpb_packed_elastic, 68713 steps to t=25ms, DT steady at
# ~3.7e-7 throughout): interval=1000 is what that run used and it never
# diverged. elastic.interval=1 (re-solving every single step under this
# file's real ~3 MPa forcing) was tested this session and reproducibly
# diverges within 20-40 steps via an exponential MLMG/Newton blowup,
# independent of void modulus, coarsening cap, zero_out_displacement, or the
# PNG-vs-sphere-packing IC -- the tight per-step elastic/fluid coupling
# itself is the compounding-error feedback loop.
#elastic.interval = 1000
# 500 elastic solves over the full 100ms stop_time, matching amr.plot_dt --
# lower frequency than the interval=1000 setting above (~3.1e-5s period at
# the steady DT~3.1e-8s), so it stays well clear of the interval=1
# per-step-coupling divergence documented above.
elastic.dt = 2.0e-4_s
elastic.traction = 0.0
elastic.apply_fluid_pressure = 1
elastic.etacutoff = 0.0
elastic.print_model = 1
elastic.solver.verbose = 4
# Tolerance-based (not elastic.solver.fixed_iter): a stalled/non-converged
# solve should be visible rather than silently accepted at these moduli --
# see input.lm.ap_htpb_packed_elastic's WARNING.
# Tightened from the 1.0e-1 debug-testing value (see history above) now that
# elastic re-solves are infrequent (elastic.dt=2e-4s, ~500 total over the
# run) -- each one can afford to be much more accurate without hurting
# runtime, and a loose 1e-1 tolerance risks a stale/inaccurate displacement
# field persisting for ~0.2ms of simulated time between resolves.
elastic.tol_rel = 1.0e-6
elastic.tol_abs = 1.0e-6
# Required alongside elastic.void.model.* above: MLMG coarsens right
# through the diffuse solid/void interface, and at this modulus contrast
# that produces garbage coarse-level operators (verified in
# tests/LowMachElasticPressure's 2d-pressure-1Pa-softvoid sub-case, which
# diverges outright without this cap). See input.lm.ap_htpb_packed_elastic's
# WARNING -- raised from 2 to 3 (verified stable, ~2x faster); do not push
# further (uncapped diverges within a handful of iterations).
elastic.max_coarsening_level = 3
elastic.solver.conservative_face_flux = 1
elastic.solver.line_search = 1
elastic.solver.resync_coeffs = 1
# A single Newton iteration is exact for this problem regardless: from the
# zeroed initial guess set by elastic.zero_out_displacement (Base::Mechanics
# default), NeoHookeanPredeformed linearizes exactly about F = I (see
# tests/LowMachElasticPressure/Readme.rst's derivation), so nriters > 1 buys
# no accuracy here. It does cost stability -- see
# input.lm.ap_htpb_packed_elastic's comment on this key for the full
# derivation.
elastic.solver.nriters = 1
#elastic.solver.nrtolerance = 0
# Raised from 1500 -- see input.lm.ap_htpb_packed_elastic's WARNING
# (max_coarsening_level=3 caps MG effectiveness, so convergence to tol_rel is
# slow, not divergent; verified needing ~1650-2050 iterations).
elastic.solver.max_iter = 10000000
elastic.solver.pre_smooth = 2
elastic.solver.post_smooth = 2
elastic.solver.bottom_solver = smoother
elastic.zero_out_displacement = 1
# Don't hard-abort if MLMG doesn't reach tol_rel/tol_abs within max_iter --
# with max_coarsening_level=3 the solve converges very slowly (~200000
# iterations observed) and MLMG throws right at/near convergence; continue
# the timestep with whatever solution it has instead of killing the run.
# Also auto-sets amrex.signal_handling=0 / amrex.throw_exception=1, which
# this flag requires internally (see Solver::Nonlocal::Linear::Parse).
elastic.solver.abort_on_fail = 0
# Tried elastic.solver.fgmres=1 (restarted FGMRES w/ MLMG as preconditioner,
# see Solver::Nonlocal::Linear::solveFGMRES) here: converged steadily and
# much faster than plain MLMG in serial (residual 3.5e13 -> 5.3e6 in 9 outer
# cycles, target 3.5e5), but failed when run in parallel (multiple MPI
# ranks) -- not yet debugged, possibly a global-reduction issue in the
# hand-rolled dot()/vnorm() helpers in solveFGMRES. Reverted to plain MLMG
# below, which is confirmed working (just slow -- see the comment on
# elastic.solver.max_iter above) in both serial and parallel.

# BCs mirror the velocity slip-wall/open-top setup above, per component
# (x,y[,z]): x/z faces are rollers (normal displacement clamped, shear
# traction-free, matching REFLECT_ODD/REFLECT_EVEN); ylo (solid substrate) is
# fully clamped; yhi (open gas boundary) is fully traction-free. Edges and
# corners take the per-component intersection of their adjacent faces
# (displacement wins over traction where they conflict) -- see the
# consistency warning in BC/Operator/Elastic/Constant.H.
elastic.bc.type = constant
elastic.bc.constant.type.xlo = disp trac trac
elastic.bc.constant.type.xhi = disp trac trac
elastic.bc.constant.type.ylo = disp disp disp
elastic.bc.constant.type.yhi = trac trac trac
elastic.bc.constant.type.zlo = trac trac disp
elastic.bc.constant.type.zhi = trac trac disp
# 3D edges / 2D corners
elastic.bc.constant.type.xloylo = disp disp disp
elastic.bc.constant.type.xhiylo = disp disp disp
elastic.bc.constant.type.xloyhi = disp trac trac
elastic.bc.constant.type.xhiyhi = disp trac trac
elastic.bc.constant.type.ylozlo = disp disp disp
elastic.bc.constant.type.ylozhi = disp disp disp
elastic.bc.constant.type.yhizlo = trac trac disp
elastic.bc.constant.type.yhizhi = trac trac disp
elastic.bc.constant.type.zloxlo = disp trac disp
elastic.bc.constant.type.zloxhi = disp trac disp
elastic.bc.constant.type.zhixlo = disp trac disp
elastic.bc.constant.type.zhixhi = disp trac disp
# 3D corners
elastic.bc.constant.type.xloylozlo = disp disp disp
elastic.bc.constant.type.xloylozhi = disp disp disp
elastic.bc.constant.type.xhiylozlo = disp disp disp
elastic.bc.constant.type.xhiylozhi = disp disp disp
elastic.bc.constant.type.xloyhizlo = disp trac disp
elastic.bc.constant.type.xloyhizhi = disp trac disp
elastic.bc.constant.type.xhiyhizlo = disp trac disp
elastic.bc.constant.type.xhiyhizhi = disp trac disp
