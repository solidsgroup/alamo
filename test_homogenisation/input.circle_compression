# AP-sphere / HTPB-matrix compression test.  The normalized packing is scaled
# uniformly from [0,1]^2 to a physical 50 um square by assigning 50_um to
# file.unit.  system.length=um only nondimensionalizes the internal algebra:
# this remains a 50 um physical specimen and all dimensional inputs/outputs
# retain their micrometre/MPa interpretation.  Its mean radius is
# 0.0325735007935 * 50 um = 1.62867503968 um.

# Use micrometres as the internal length unit to avoid an ill-scaled operator
# (Pa / m^2) while preserving the physical problem.
system.length = um

alamo.program = mechanics
alamo.program.mechanics.model = finite.neohookeanpre

plot_file = test_homogenisation/output.test_homogenisation_per

# One static elastic solve.
timestep  = 0.1
stop_time = 0.1

# No AMR.  dx = 50 um / 1280 = 0.0390625 um, so the 0.1628675 um
# diffuse interface is 4.17 cells wide.
amr.max_level = 0
amr.n_cell = 320 320 # 1280 1280
amr.blocking_factor = 64
amr.max_grid_size = 64
amr.regrid_int = -1
amr.plot_int = 1
amr.cell.all = 1
amr.node.any = 0

# 100 micrometer square, periodic in both x and y (this is a 2-D build).
geometry.prob_lo = 0_um 0_um
geometry.prob_hi = 50_um 50_um
geometry.is_periodic = 1 1

# AP is model 1 and occupies the packed spheres; model 2 is the complementary
# HTPB matrix.  file.unit scales both coordinates and radii from the normalized
# packing file.  eps is 10% of the scaled mean sphere radius.
nmodels = 2
# ic.type = constant
# ic.constant.value = 1
ic.type = psread
ic.psread.file.name = test_homogenisation/test_pack_1.txt
ic.psread.file.unit = 50_um
ic.psread.eps = 0.35_um # 0.16286750396764_um

# For the finite neo-Hookean model, mu = E/(2*(1+nu)) and
# kappa = E/(3*(1-2*nu)); this avoids the near-incompressible tangent.
model1.mu = 14191.376_MPa # AP
model1.kappa = 15162.134_MPa # AP
# RVE loading: Fbar = diag(1.01, 1).  With periodic displacement
# fluctuations, NeoHookeanPredeformed uses F0 = Fbar^{-1}.
model1.F0 = 0.9900990099009901 0 0 1
model2.mu = 2.479062_MPa # HTPB, nu = 0.4925
model2.kappa = 164.444444 _MPa # HTPB
model2.F0 = 0.9900990099009901 0 0 1

solver.verbose = 4
solver.nriters = 20
solver.nrtolerance = 1e-6
solver.max_iter = 300000
solver.pre_smooth = 2
solver.post_smooth = 2
solver.bottom_solver = bicgstab
solver.conservative_face_flux = 1
solver.line_search = 1
solver.resync_coeffs = 1

# Do not coarsen through the high-contrast diffuse AP/HTPB interfaces.
max_coarsening_level = 1
tol_rel = 2.0e-5
tol_abs = 1.0e-8

# Fully periodic displacement boundary conditions.  Each pair gives the
# x- and y-displacement components, respectively.
bc.type = constant
bc.constant.type.xlo = periodic periodic
bc.constant.type.xhi = periodic periodic
bc.constant.type.ylo = periodic periodic
bc.constant.type.yhi = periodic periodic

# Keep the corners periodic as well; the elastic BC parser handles corners
# separately from edges.
bc.constant.type.xloylo = periodic periodic
bc.constant.type.xhiylo = periodic periodic
bc.constant.type.xloyhi = periodic periodic
bc.constant.type.xhiyhi = periodic periodic

