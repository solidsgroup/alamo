#!/usr/bin/env python3
"""Check 1D projection, transport, diagnostics and AMR startup with Rocfire."""
from pathlib import Path
import sys

import numpy as np
import yt

yt.funcs.mylog.setLevel(40)
output = Path(sys.argv[1])
plots = sorted(output.glob('*cell'))
assert len(plots) == 2, plots

for path in plots:
    ds = yt.load(str(path))
    assert ds.dimensionality == 1
    if output.name.endswith('-amr'):
        assert ds.max_level == 1, 'The interface should refine in 1D'
    dimensions = ds.domain_dimensions.copy()
    dimensions[0] *= 2**ds.max_level
    grid = ds.covering_grid(ds.max_level, ds.domain_left_edge, dimensions)
    fields = {key[1]: np.asarray(grid[key])
              for key in ds.field_list if key[0] == 'boxlib'}
    assert all(np.isfinite(value).all() for value in fields.values())
    assert fields['temperature'].min() > 0.0
    assert 'velocity' in fields and 'velocityy' not in fields
    assert 'momentum' in fields and 'momentumy' not in fields
    np.testing.assert_allclose(fields['momentum'],
                               fields['density'] * fields['velocity'], rtol=1e-12)
    np.testing.assert_array_equal(fields['vorticity'], 0.0)
    species = [value for name, value in fields.items()
               if name.startswith('component_density_')]
    assert len(species) == 7
    assert min(value.min() for value in species) >= -1e-12
    np.testing.assert_allclose(sum(species), fields['density'], rtol=1e-12)

np.testing.assert_allclose(float(ds.current_time), 5e-8, rtol=1e-12)
assert fields['temperature'].max() > 300.0, 'The surface heat pulse should warm the material'
print('1D Rocfire startup, field layout and finite diagnostics passed')
