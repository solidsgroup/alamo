#@ [2d-*]
#@ exe = lowmach
#@ dim = 2
#@ timeout = 300
#@
#@ [2d-inclusion]
#@ check-file = reference/inclusion.csv
#@
#@ [2d-pressure-off]
#@ check-file = reference/pressure-off.csv
#@ args = elastic.apply_fluid_pressure=0

# Analytic validation of a two-phase circular elastic inclusion (a single
# rigid_solid AP particle at the center of a square domain, embedded in the
# LowMach "soft void" ersatz-elastic Gas -- see elastic.void.model.* below
# and tests/LowMachElasticPressure) against the classical Kolosov-
# Muskhelishvili two-phase circular-inhomogeneity solution -- see Readme.rst
# for the full derivation, INCLUDING the (non-obvious) traction-jump interface
# condition elastic.apply_fluid_pressure actually imposes (not the ordinary
# matched-material continuity a naive two-phase read would assume).
#
# Unlike input.lm.ap_htpb_packed_elastic (the production packed-bed case
# this input is descended from), there is no HTPB, no reacting chemistry,
# and no bed regression: chemistry is frozen and the temperature field is
# held at a uniform 300K everywhere, well below any phase-change activation
# temperature, so the AP/Gas interface is static for the life of the run --
# "the surface doesn't move" is a structural property of this input (frozen
# chemistry), not merely a consequence of the low temperature.
# AP_solid.elastic.model.mu/kappa below are the real (rescaled) AP crystal
# moduli from that production file, per the user's request -- not the
# nondimensional-style values tests/LowMachElasticPressure uses.
#
# The fluid pressure P is uniform and time-frozen (projection.update_pressure
# = 0, see tests/LowMachElasticPressure) inside the domain. Loading enters
# the elastic solve ONLY through elastic.apply_fluid_pressure's interfacial
# body force at the AP/Gas boundary -- "the fluid pressure IS the traction"
# (see below and Readme.rst) -- the domain's outer boundary is traction-free
# (except for one clamped face needed purely to remove rigid-body motion,
# see below), not a separately hand-derived remote traction BC. This is a
# self-equilibrated pressurized-inclusion problem, not an inclusion immersed
# in an externally-pressurized infinite matrix.
#
# elastic.void.model.mu/kappa below is a soft ersatz modulus (NOT HTPB's
# real value -- there is no HTPB in this test), needed purely so MLMG stays
# well-conditioned at the real AP contrast; see Readme.rst "Setup" and
# elastic.max_coarsening_level below for the stability tradeoffs this
# forces. Because the void region has a real (if soft) modulus here rather
# than being psi-masked, it is a first-class physical parameter that enters
# the analytic reference formula directly (see generate_reference.py), not
# just a numerical convenience as in tests/LowMachElasticPressure.
#
# The [2d-pressure-off] sub-case is a wiring control: with
# elastic.apply_fluid_pressure=0, the interfacial RHS is identically zero,
# the boundary is already unloaded (traction-free faces default to 0.0, the
# one clamped face is 0.0 by definition), so the solve must return zero
# displacement everywhere.

plot_file = tests/LowMachElasticInclusion/output
amr.plot_dt = 2.0e-7_s
amr.max_level = 0
amr.n_cell = 160 160
amr.max_grid_size = 40
amr.blocking_factor = 2
amr.regrid_int = -1
# Write elastic fields (disp/stress/strain, nodal) into the *cell* plotfiles
# too, so the analytic comparison can use the same ray-extraction path
# (testlib.readContours) used by tests/LowMachElasticPressure.
amr.cell.all = 1

timestep = 1.0e-7_s
stop_time = 3.0e-7_s
dynamictimestep.on = 0

geometry.prob_lo = -1.5e-3 -1.5e-3 0.0
geometry.prob_hi =  1.5e-3  1.5e-3 0.0
geometry.is_periodic = 0 0 0

system.amount = kmol
gas.mw = 29.0_g/mol
gas.thermo.type = cpconstant
gas.thermo.cpconstant.cp_moles = 29113.0_J/kmol/K
gas.thermo.cpconstant.h0 = 0.0
gas.thermo.cpconstant.s0 = 0.0
gas.thermo.cpconstant.Tref = 0.0_K
gas.transport.type = mixture_averaged
gas.transport.mixture_averaged.type = constant
gas.transport.mixture_averaged.mu = 1.8e-5_Pa*s
gas.transport.mixture_averaged.k = 3.0_W/m/K
gas.eos.type = cpg

species.names = Gas AP_solid
Gas.mechanics     = fluid
AP_solid.mechanics = rigid_solid

AP_solid.reference_density = 1950.0_kg/m^3

# Real (rescaled) AP crystal moduli, reused verbatim from
# input.lm.ap_htpb_packed_elastic: E ~ 21.6 GPa, nu ~ 0.14 -> mu ~ 9.47 GPa,
# kappa ~ 10.0 GPa, then scaled by 1e-4 (true SI mu=9.47e9, kappa=1.00e10)
# for the same reason documented there -- literal SI moduli push the
# modulus/dx^2 ratio far out of the MLMG solver's well-behaved range.
AP_solid.elastic.model.mu    = 9.47e6
AP_solid.elastic.model.kappa = 1.00e8

# The "matrix" phase of the two-phase inclusion problem (see Readme.rst) --
# a soft ersatz modulus rather than HTPB's real value, chosen (like
# input.lm.ap_htpb_packed_elastic's elastic.void.model) purely for MLMG
# stability/accuracy: contrast against AP above (mu ~1,894x, kappa ~250x)
# lands in that file's verified accuracy-plateau + stability-margin window
# ([~250x, ~2,100x], see its WARNING comment), and this exact (mu,kappa)
# pair is reused verbatim from there.
elastic.void.model.mu    = 5.0e3
elastic.void.model.kappa = 4.0e5

chemistry.model.type = frozen
chemistry.solver.type = forward_euler

rigid.relaxation_time = 1.0e-8_s
rigid.velocity = 0.0 0.0

advection.type = muscl
advection.muscl.limiter.type = minmod
cfl = 0.8
include_viscosity = 1
implicit_viscosity = 1
include_conduction = 1
advect_temperature = 1
projection.enabled = 1
projection.tol_rel = 1.0e-10
projection.tol_abs = 1.0e-12
# Freeze pressure_mf at its IC -- see tests/LowMachElasticPressure/Readme.rst.
projection.update_pressure = 0
diffusion.tol_rel = 1.0e-10
diffusion.tol_abs = 1.0e-12
diagnostics.interval = 0

# A single circular AP inclusion of radius R at the domain center; Gas is
# the exact ideal-gas-consistent volume-fraction complement (required -- see
# tests/LowMachElastic/input's volume-fraction-consistency note). The
# diffuse interface width w=4.0e-5 (~2.1 dx at this grid, R/w=3.75) must
# match generate_reference.py's `w` if changed. A finer grid (n_cell=320,
# w=1.875e-5, R/w=8) was tried and verified NOT worth it: interior stress
# error did not improve (still ~10%, if anything slightly worse -- the
# residual error here is not simply diffuse-interface smoothing that
# refines away), elastic.max_coarsening_level has to drop to 2 to stay
# stable, and the solve slows down ~40x (152s vs 3.6s). See `test`'s
# tolerances, which are set from the actual measured error at this grid.
AP_solid.density.ic.type = expression
AP_solid.density.ic.expression.constant.rho = 1950.0
AP_solid.density.ic.expression.constant.R   = 1.5e-4
AP_solid.density.ic.expression.constant.w   = 4.0e-5
AP_solid.density.ic.expression.region0 = "rho*0.5*(1.0-tanh((sqrt(x^2+y^2)-R)/w))"

Gas.density.ic.type = expression
Gas.density.ic.expression.constant.P = 1.0
Gas.density.ic.expression.constant.Rgas = 286.7  # ~8314.4 J/kmol/K / 29.0 g/mol
Gas.density.ic.expression.constant.T  = 300.0
Gas.density.ic.expression.constant.R  = 1.5e-4
Gas.density.ic.expression.constant.w  = 4.0e-5
Gas.density.ic.expression.region0 = "(P/(Rgas*T))*0.5*(1.0+tanh((sqrt(x^2+y^2)-R)/w))"

velocity.ic.type = constant
velocity.ic.constant.value = 0.0 0.0

temperature.ic.type = constant
temperature.ic.constant.value = 300.0

pressure.ic.type = constant
pressure.ic.constant.value = 1.0

component_density.bc.type = constant
component_density.bc.constant.type.xlo = neumann neumann
component_density.bc.constant.type.xhi = neumann neumann
component_density.bc.constant.type.ylo = neumann neumann
component_density.bc.constant.type.yhi = neumann neumann

velocity.bc.type = constant
velocity.bc.constant.type.xlo = dirichlet dirichlet
velocity.bc.constant.type.xhi = dirichlet dirichlet
velocity.bc.constant.type.ylo = dirichlet dirichlet
velocity.bc.constant.type.yhi = dirichlet dirichlet
velocity.bc.constant.val.xlo = 0.0 0.0
velocity.bc.constant.val.xhi = 0.0 0.0
velocity.bc.constant.val.ylo = 0.0 0.0
velocity.bc.constant.val.yhi = 0.0 0.0

temperature.bc.type = constant
temperature.bc.constant.type.xlo = neumann
temperature.bc.constant.type.xhi = neumann
temperature.bc.constant.type.ylo = neumann
temperature.bc.constant.type.yhi = neumann

# Dirichlet P on all four faces keeps the (already time-frozen,
# projection.update_pressure=0 below) fluid pressure field at a uniform P
# everywhere, including right at the AP/Gas interface that
# elastic.apply_fluid_pressure samples -- this is what makes the
# interfacial elastic loading equal to a clean, spatially uniform P rather
# than something that varies with the (here nonexistent) flow field.
pressure.bc.type = constant
pressure.bc.constant.type.xlo = dirichlet
pressure.bc.constant.type.xhi = dirichlet
pressure.bc.constant.type.ylo = dirichlet
pressure.bc.constant.type.yhi = dirichlet
pressure.bc.constant.val.xlo = 1.0
pressure.bc.constant.val.xhi = 1.0
pressure.bc.constant.val.ylo = 1.0
pressure.bc.constant.val.yhi = 1.0

# Elastic solve over the AP phase, driven by the local fluid pressure
# (elastic.apply_fluid_pressure, see LowMach::UpdateModel and
# tests/LowMachElasticPressure). elastic.traction is left at zero so the
# pressure term is the only interfacial driver.
elastic.type = static
elastic.traction = 0.0
elastic.apply_fluid_pressure = 1
elastic.etacutoff = 0.0
elastic.print_model = 1
elastic.solver.verbose = 0
# One Newton iteration from a zeroed initial guess linearizes about F = I,
# giving the exact plane-strain linear-elastic solution -- see
# tests/LowMachElasticPressure/Readme.rst's derivation, which applies
# unchanged here (same NeoHookeanPredeformed model).
elastic.solver.nriters = 1
elastic.zero_out_displacement = 1
# Required alongside elastic.void.model.* above: at this modulus contrast
# MLMG genuinely diverges through the diffuse interface unless multigrid
# coarsening is capped -- see input.lm.ap_htpb_packed_elastic's WARNING
# (identical contrast, identical cap, verified stable there) and
# tests/LowMachElasticPressure/Readme.rst for the general mechanism.
elastic.max_coarsening_level = 3
elastic.solver.bottom_solver = smoother
elastic.tol_rel = 1.0e-8
elastic.tol_abs = 1.0e-8
elastic.solver.max_iter = 10000

# Rollers on all four faces (normal displacement clamped, tangential
# traction-free -- e.g. xlo/xhi: disp trac; ylo/yhi: trac disp), the same
# convention input.lm.ap_htpb_packed_elastic uses on its x-faces, applied
# symmetrically on every side since this problem (unlike that one) has no
# privileged direction. The domain boundary still imposes NO tangential
# loading of its own; the only DRIVING force anywhere is elastic.apply_
# fluid_pressure's interfacial body force above -- "the fluid pressure IS
# the traction," not a separately hand-derived remote BC (there is no
# framework mechanism for a boundary BC to read the pressure field
# directly -- see Readme.rst).
#
# An all-traction boundary is required to be well-posed only up to
# rigid-body motion (2 translations + 1 rotation in 2D): the interfacial
# load happens to be self-equilibrated (net force/torque zero by symmetry)
# so the discrete system wouldn't blow up, but it would still be
# singular/rank-deficient. A single clamped face (tried first) technically
# removes the null space too, but concentrates the constraint at one edge
# far from the load; empirically the MLMG "smoother" bottom solver handled
# that badly -- residual bottomed out around 3e-6 by iteration ~100, then
# crept back up geometrically, diverging by iteration ~10000. Rollers
# distribute the (much weaker, purely normal) constraint along the entire
# boundary instead, which converges cleanly. Since the domain half-width is
# 10a, the correction this introduces to the "fully free at infinity"
# solution the analytic reference assumes is O((a/L)^2) ~ 1e-4 relative,
# per the "Domain size" argument in Readme.rst -- negligible next to the
# ~5-6% diffuse-interface discretization error.
elastic.bc.type = constant
elastic.bc.constant.type.xlo = disp trac
elastic.bc.constant.type.xhi = disp trac
elastic.bc.constant.type.ylo = trac disp
elastic.bc.constant.type.yhi = trac disp
elastic.bc.constant.type.xloylo = disp disp
elastic.bc.constant.type.xhiylo = disp disp
elastic.bc.constant.type.xloyhi = disp disp
elastic.bc.constant.type.xhiyhi = disp disp
