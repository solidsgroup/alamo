#@ [2d]
#@ exe=lowmach
#@ dim=2
#@ timeout=240
#@
#@ [2d-no-capillary]
#@ exe=lowmach
#@ dim=2
#@ timeout=240
#@ args=liquid.capillary.enabled=0
#@ args=liquid.capillary.include_solids=1
#@ args=max_step=1
#@ args=stop_time=1.0e-4
#@ args=amr.plot_int=1

# Static diffuse droplet used to validate the face-balanced capillary force.
plot_file = tests/LMLiquidCapillary/output
amr.plot_int = 8
amr.plot_dt = -1
amr.max_level = 0
amr.max_grid_size = 32
amr.blocking_factor = 8
amr.n_cell = 32 32

max_step = 8
timestep = 1.0e-4
stop_time = 8.0e-4
dynamictimestep.on = 0
integration.type = RungeKutta
integration.rk.type = 3

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 0.0
geometry.is_periodic = 1 1 0

system.amount = kmol
gas.mw = 28.0_kg/kmol
gas.thermo.type = cpconstant
gas.thermo.cpconstant.cp_moles = 29.1_kJ/kmol/K
gas.thermo.cpconstant.h0 = 0.0
gas.thermo.cpconstant.s0 = 0.0
gas.thermo.cpconstant.Tref = 300.0_K
gas.transport.type = mixture_averaged
gas.transport.mixture_averaged.type = constant
gas.transport.mixture_averaged.mu = 0.10_Pa*s
gas.transport.mixture_averaged.k = 0.10_W/m/K
gas.eos.type = cpg

species.names = ambient Al_liquid Al2O3_liquid tracer_liquid
ambient.mechanics = fluid
Al_liquid.mechanics = liquid
Al2O3_liquid.mechanics = liquid
tracer_liquid.mechanics = liquid

Al_liquid.reference_density = 10.0_kg/m^3
Al_liquid.dynamic_viscosity = 0.10_Pa*s
Al_liquid.specific_heat = 1000.0_J/kg/K
Al_liquid.thermal_conductivity = 1.0_W/m/K
Al2O3_liquid.reference_density = 10.0_kg/m^3
Al2O3_liquid.dynamic_viscosity = 0.10_Pa*s
Al2O3_liquid.specific_heat = 1000.0_J/kg/K
Al2O3_liquid.thermal_conductivity = 1.0_W/m/K
tracer_liquid.reference_density = 10.0_kg/m^3
tracer_liquid.dynamic_viscosity = 0.10_Pa*s
tracer_liquid.specific_heat = 1000.0_J/kg/K
tracer_liquid.thermal_conductivity = 1.0_W/m/K

liquid.interface_thickness = 0.125
liquid.surface_tension.Al_liquid_gas = 1.0
liquid.surface_tension.Al2O3_liquid_gas = 1.0
liquid.surface_tension.Al_liquid_Al2O3_liquid = 1.0
liquid.surface_tension.Al_liquid_tracer_liquid = 1.0
liquid.surface_tension.Al2O3_liquid_tracer_liquid = 1.0
liquid.surface_tension.tracer_liquid_gas = 1.0

chemistry.model.type = frozen
chemistry.solver.type = forward_euler

advection.type = muscl
advection.muscl.limiter.type = minmod
cfl = 0.20
include_viscosity = 1
implicit_viscosity = 0
include_conduction = 0
advect_temperature = 0
projection.enabled = 1
projection.tol_rel = 1.0e-11
projection.tol_abs = 1.0e-13
projection.verbose = 0
projection.update_pressure = 1
diagnostics.interval = 0

Al_liquid.density.ic.type = expression
Al_liquid.density.ic.expression.constant.rho = 10.0
Al_liquid.density.ic.expression.constant.x0 = 0.5
Al_liquid.density.ic.expression.constant.y0 = 0.5
Al_liquid.density.ic.expression.constant.R = 0.20
Al_liquid.density.ic.expression.constant.eps = 0.125
Al_liquid.density.ic.expression.region0 = "rho*0.5*(1.0-tanh(2.0*(sqrt((x-x0)*(x-x0)+(y-y0)*(y-y0))-R)/eps))"

Al2O3_liquid.density.ic.type = constant
Al2O3_liquid.density.ic.constant.value = 0.0

tracer_liquid.density.ic.type = constant
tracer_liquid.density.ic.constant.value = 0.0

ambient.density.ic.type = expression
ambient.density.ic.expression.constant.rho = 1.12254198039921
ambient.density.ic.expression.constant.x0 = 0.5
ambient.density.ic.expression.constant.y0 = 0.5
ambient.density.ic.expression.constant.R = 0.20
ambient.density.ic.expression.constant.eps = 0.125
ambient.density.ic.expression.region0 = "rho*0.5*(1.0+tanh(2.0*(sqrt((x-x0)*(x-x0)+(y-y0)*(y-y0))-R)/eps))"

velocity.ic.type = expression
velocity.ic.expression.constant.A = 0.0
velocity.ic.expression.constant.dx = 0.03125
velocity.ic.expression.constant.pi = 3.141592653589793
velocity.ic.expression.region0 = "A*cos(pi*(x-0.5*dx)/dx)"
velocity.ic.expression.region1 = "0.0"
temperature.ic.type = constant
temperature.ic.constant.value = 300.0
pressure.ic.type = constant
pressure.ic.constant.value = 1.0e5

component_density.bc.type = constant
component_density.bc.constant.type.xlo = periodic periodic periodic periodic
component_density.bc.constant.type.xhi = periodic periodic periodic periodic
component_density.bc.constant.type.ylo = periodic periodic periodic periodic
component_density.bc.constant.type.yhi = periodic periodic periodic periodic
velocity.bc.type = constant
velocity.bc.constant.type.xlo = periodic periodic
velocity.bc.constant.type.xhi = periodic periodic
velocity.bc.constant.type.ylo = periodic periodic
velocity.bc.constant.type.yhi = periodic periodic
temperature.bc.type = constant
temperature.bc.constant.type.xlo = periodic
temperature.bc.constant.type.xhi = periodic
temperature.bc.constant.type.ylo = periodic
temperature.bc.constant.type.yhi = periodic
pressure.bc.type = constant
pressure.bc.constant.type.xlo = periodic
pressure.bc.constant.type.xhi = periodic
pressure.bc.constant.type.ylo = periodic
pressure.bc.constant.type.yhi = periodic
