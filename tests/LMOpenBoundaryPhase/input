#@ [2d]
#@ exe = lowmach
#@ dim = 2
#@ timeout = 120

# A liquid cap intersects an open pressure boundary while a uniform backflow
# carries it into the domain.  The exterior state is gas: condensed material
# must not be supplied by the outlet ghosts, and the clipped diffuse interface
# must not exert a spurious capillary traction.
plot_file = tests/LMOpenBoundaryPhase/output
amr.plot_int = 50
amr.plot_dt = -1
amr.max_level = 0
amr.n_cell = 64 64
amr.max_grid_size = 32
amr.blocking_factor = 4
amr.regrid_int = -1

max_step = 50
timestep = 2.0e-4_s
stop_time = 1.0_s
dynamictimestep.on = 0
integration.type = RungeKutta
integration.rk.type = 3

geometry.prob_lo = 0.0_m 0.0_m 0.0_m
geometry.prob_hi = 1.0_m 1.0_m 0.0_m
geometry.is_periodic = 1 0 0

system.amount = kmol
gas.mw = 28.0_kg/kmol
gas.thermo.type = cpconstant
gas.thermo.cpconstant.cp_moles = 29.1_J/mol/K
gas.thermo.cpconstant.h0 = 0.0_J/mol
gas.thermo.cpconstant.s0 = 0.0_J/mol/K
gas.thermo.cpconstant.Tref = 300.0_K
gas.transport.type = mixture_averaged
gas.transport.mixture_averaged.type = constant
gas.transport.mixture_averaged.mu = 1.0e-5_Pa*s
gas.transport.mixture_averaged.k = 0.02_W/m/K
gas.eos.type = cpg

species.names = ambient_gas test_liquid
ambient_gas.mechanics = fluid
test_liquid.mechanics = liquid
test_liquid.reference_density = 10.0_kg/m^3
test_liquid.dynamic_viscosity = 0.10_Pa*s
test_liquid.specific_heat = 1000.0_J/kg/K
test_liquid.thermal_conductivity = 1.0_W/m/K

chemistry.model.type = frozen
chemistry.solver.type = forward_euler

interface.enabled = 1
interface.thickness = 6.25e-2_m
interface.transport.type = advected
interface.surface_tension.test_liquid_gas = 1.0_J/m^2

advection.type = muscl
advection.muscl.limiter.type = minmod
cfl = 0.8
include_viscosity = 0
include_conduction = 0
advect_temperature = 0
projection.enabled = 1
projection.tol_rel = 1.0e-11
projection.tol_abs = 1.0e-12
projection.verbose = 0
projection.update_pressure = 1
diagnostics.interval = 0

test_liquid.density.ic.type = expression
test_liquid.density.ic.expression.constant.rho = 10.0_kg/m^3
test_liquid.density.ic.expression.constant.x0 = 0.50_m
test_liquid.density.ic.expression.constant.y0 = 0.98_m
test_liquid.density.ic.expression.constant.radius = 0.15_m
test_liquid.density.ic.expression.constant.width = 6.25e-2_m
test_liquid.density.ic.expression.region0 = "rho*0.5*(1.0-tanh(2.0*(sqrt((x-x0)^2+(y-y0)^2)-radius)/width))"

ambient_gas.density.ic.type = expression
ambient_gas.density.ic.expression.constant.rho = 1.12254198039921_kg/m^3
ambient_gas.density.ic.expression.constant.x0 = 0.50_m
ambient_gas.density.ic.expression.constant.y0 = 0.98_m
ambient_gas.density.ic.expression.constant.radius = 0.15_m
ambient_gas.density.ic.expression.constant.width = 6.25e-2_m
ambient_gas.density.ic.expression.region0 = "rho*(1.0-0.5*(1.0-tanh(2.0*(sqrt((x-x0)^2+(y-y0)^2)-radius)/width)))"

velocity.ic.type = constant
velocity.ic.constant.value = 0.0_m/s -2.0_m/s
temperature.ic.type = constant
temperature.ic.constant.value = 300.0_K
pressure.ic.type = constant
pressure.ic.constant.value = 1.0e5_Pa

component_density.bc.type = constant
component_density.bc.constant.type.xlo = periodic
component_density.bc.constant.type.xhi = periodic
component_density.bc.constant.type.ylo = neumann
component_density.bc.constant.type.yhi = neumann

velocity.bc.type = constant
velocity.bc.constant.type.xlo = periodic
velocity.bc.constant.type.xhi = periodic
velocity.bc.constant.type.ylo = neumann
velocity.bc.constant.type.yhi = neumann

temperature.bc.type = constant
temperature.bc.constant.type.xlo = periodic
temperature.bc.constant.type.xhi = periodic
temperature.bc.constant.type.ylo = neumann
temperature.bc.constant.type.yhi = neumann

pressure.bc.type = constant
pressure.bc.constant.type.xlo = periodic
pressure.bc.constant.type.xhi = periodic
pressure.bc.constant.type.ylo = dirichlet
pressure.bc.constant.type.yhi = dirichlet
pressure.bc.constant.val.ylo = 1.0e5_Pa
pressure.bc.constant.val.yhi = 1.0e5_Pa
