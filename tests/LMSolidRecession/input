#@ [2d-muscl]
#@ exe=lowmach
#@ dim=2
#@ timeout=300
#@ args=advection.muscl.limiter.type=minmod
#@ args=amr.n_cell=8 768

#@ [2d-upwind]
#@ exe=lowmach
#@ dim=2
#@ timeout=120
#@ args=advection.type=upwind
#@ args=amr.max_grid_size=64

# Isothermal constant-speed erosion with matching gas/solid specific volumes.
# The front must advance beyond the initial diffuse support without remnants.
# Both selected advection models must preserve the speed and mass balance.
# The MUSCL case resolves the initial width with 24 cells to keep contour
# interpolation/profile error below the same 0.2% rate tolerance.
# These artificial kinetics are not calibration values.
plot_file = tests/LMSolidRecession/output
amr.plot_int = 200
amr.max_level = 0
amr.n_cell = 8 256
amr.max_grid_size = 256
amr.blocking_factor = 8
max_step = 1600
timestep = 5e-4_s
stop_time = 0.8_s
integration.type = RungeKutta
integration.rk.type = 3
geometry.prob_lo = 0 -1 0
geometry.prob_hi = 0.0625 1 0
geometry.is_periodic = 1 0 0
system.amount = kmol
gas.mw = 26.0_kg/kmol 26.0_kg/kmol
gas.thermo.type = cpconstant
gas.thermo.cpconstant.cp_moles = 26000.0_J/kmol/K 26000.0_J/kmol/K
gas.thermo.cpconstant.h0 = 0.0_J/kmol 0.0_J/kmol
gas.thermo.cpconstant.s0 = 0.0_J/kmol/K 0.0_J/kmol/K
gas.thermo.cpconstant.Tref = 300.0_K 300.0_K
gas.transport.type = mixture_averaged
gas.transport.mixture_averaged.type = constant
gas.transport.mixture_averaged.mu = 2.0e-5_Pa*s 2.0e-5_Pa*s
gas.transport.mixture_averaged.k = 0.1_W/m/K 0.1_W/m/K
gas.eos.type = cpg
species.names = AP_gas binder_gas AP_solid binder_solid
AP_gas.mechanics = fluid
binder_gas.mechanics = fluid
AP_solid.mechanics = rigid_solid
binder_solid.mechanics = rigid_solid
AP_solid.reference_density = 1950_kg/m^3
AP_solid.specific_heat = 1000_J/kg/K
AP_solid.thermal_conductivity = 0.4186_W/m/K
binder_solid.reference_density = 920_kg/m^3
binder_solid.specific_heat = 1000_J/kg/K
binder_solid.thermal_conductivity = 0.213_W/m/K
AP_solid.rigid.relaxation_time = 1e-4_s
AP_solid.rigid.velocity = 0 0
binder_solid.rigid.relaxation_time = 1e-4_s
binder_solid.rigid.velocity = 0 0
chemistry.model.type = frozen
chemistry.solver.type = forward_euler
mechanisms.names = AP_regression binder_regression
AP_regression.type = phase_change
AP_regression.phase_change.phase0 = AP_solid
AP_regression.phase_change.phase1 = AP_gas
AP_regression.phase_change.kinetics = arrhenius_surface_flux
AP_regression.phase_change.pre_exponential_speed = 1_m/s
AP_regression.phase_change.reference_pressure = 3e6_Pa
AP_regression.phase_change.pressure_exponent = 0
AP_regression.phase_change.reference_temperature = 1000_K
AP_regression.phase_change.activation_temperature = 2000_K
AP_regression.phase_change.coupled_enthalpy_change = 100_cal/g
binder_regression.type = phase_change
binder_regression.phase_change.phase0 = binder_solid
binder_regression.phase_change.phase1 = binder_gas
binder_regression.phase_change.kinetics = arrhenius_surface_flux
binder_regression.phase_change.reference_pressure = 3e6_Pa
binder_regression.phase_change.pressure_exponent = 0
binder_regression.phase_change.reference_temperature = 1000_K
binder_regression.phase_change.pre_exponential_speed = 1_m/s
binder_regression.phase_change.activation_temperature = 0_K
binder_regression.phase_change.coupled_enthalpy_change = 0_J/kg
interface.thickness = 0.0625_m
advection.type = muscl
cfl = 0.2
include_viscosity = 0
include_conduction = 0
advect_temperature = 0
projection.update_pressure = 0
projection.tol_rel = 1e-10
projection.tol_abs = 1e-12
projection.verbose = 0
diagnostics.extended_fields = 0
AP_gas.density.ic.type = constant
AP_gas.density.ic.constant.value = 0
AP_solid.density.ic.type = constant
AP_solid.density.ic.constant.value = 0
binder_solid.density.ic.type = expression
binder_solid.density.ic.expression.region0 = "920*(0.5-0.5*tanh(2*(y-0.5)/0.0625))"
binder_gas.density.ic.type = expression
binder_gas.density.ic.expression.region0 = "920*(0.5+0.5*tanh(2*(y-0.5)/0.0625))"
velocity.ic.type = constant
velocity.ic.constant.value = 0 0
temperature.ic.type = constant
temperature.ic.constant.value = 1000
pressure.ic.type = constant
pressure.ic.constant.value = 294204061.87311465

component_density.bc.type = constant
component_density.bc.constant.type.xlo = periodic periodic periodic periodic
component_density.bc.constant.type.xhi = periodic periodic periodic periodic
component_density.bc.constant.type.ylo = neumann
component_density.bc.constant.type.yhi = neumann

velocity.bc.type = constant
velocity.bc.constant.type.xlo = periodic periodic
velocity.bc.constant.type.xhi = periodic periodic
velocity.bc.constant.type.ylo = neumann
velocity.bc.constant.type.yhi = neumann

temperature.bc.type = constant
temperature.bc.constant.type.xlo = periodic
temperature.bc.constant.type.xhi = periodic
temperature.bc.constant.type.ylo = neumann
temperature.bc.constant.type.yhi = neumann

pressure.bc.type = constant
pressure.bc.constant.type.xlo = periodic
pressure.bc.constant.type.xhi = periodic
pressure.bc.constant.type.ylo = neumann
pressure.bc.constant.type.yhi = neumann
pressure.bc.constant.type.yhi = dirichlet
pressure.bc.constant.val.yhi = 294204061.87311465
velocity.bc.constant.type.ylo = dirichlet
velocity.bc.constant.val.ylo = 0 0
