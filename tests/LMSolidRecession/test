#!/usr/bin/env python3
"""Check propagation into initially pure solid and monotone interface motion."""
from pathlib import Path
import sys

import numpy as np
import yt

yt.set_log_level(50)
plots = sorted(Path(sys.argv[1]).glob("*cell"))
assert len(plots) >= 3, "Need a recession history"
times, columns, surfaces = [], [], []
for path in plots:
    dataset = yt.load(str(path))
    grid = dataset.covering_grid(0, dataset.domain_left_edge,
                                 dataset.domain_dimensions)
    solid = grid["component_density_binder_solid"].v[:, :, 0]
    gas = grid["component_density_binder_gas"].v[:, :, 0]
    eta = solid.mean(axis=0) / 920
    dy = float(dataset.domain_width[1] / dataset.domain_dimensions[1])
    y = float(dataset.domain_left_edge[1]) + (np.arange(len(eta)) + 0.5) * dy
    assert eta.min() >= -1e-12 and eta.max() <= 1+1e-12
    assert np.max(np.diff(eta)) < 1e-9, "Regression left oscillatory solid remnants"
    np.testing.assert_allclose(solid + gas, 920, rtol=1e-9)
    np.testing.assert_allclose(grid["temperature"].v, 1000, atol=1e-8)
    surfaces.append(np.interp(0.5, eta[::-1], y[::-1]))
    columns.append(eta.sum() * dy)
    times.append(float(dataset.current_time))
assert times[-1] >= 0.8-1e-12
# The endpoint is far beyond the initially nonzero gas fraction. A local
# eta_gas>0 gate pins this front, even though the requested rate stays finite.
np.testing.assert_allclose(surfaces[-1], -0.3, atol=0.002)
np.testing.assert_allclose(-np.polyfit(times, columns, 1)[0], 1, rtol=0.002)
np.testing.assert_allclose(-np.polyfit(times, surfaces, 1)[0], 1, rtol=0.002)
print("Solid regression remains monotone and advances at the prescribed speed")
