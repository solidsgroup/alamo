#@ [2d-void-model]
#@ exe = topop
#@ dim = 2
#@ timeout = 300

# Analytic validation of TopOpLowMach::UpdateModel, with psi_TO and eta_LM
# both frozen at their (matching) ICs -- see src/Integrator/TopOpLowMach.H.
# This is the coupled-integrator analogue of
# tests/LowMachElasticPressure's [2d-pressure-1Pa-softvoid] case: same
# geometry, same moduli, same applied pressure, same soft ersatz void
# model. Setting topop.L.str = 0 (psi_TO immobile) and giving psi_TO/eta_LM
# ICs equal to the same tanh profile the solid density uses means
# TopOpLowMach::UpdateModel must produce the identical model_mf/rhs_mf that
# LowMach::UpdateModel produces for that case, so the run must reproduce
# the same closed-form 1-D confined (oedometric) compression solution (see
# tests/LowMachElasticPressure/Readme.rst for the derivation):
#
#   sigma_yy(y) = -P
#   disp_y(y)   = -P*y/M,  M = kappa + 4*mu/3
#   disp_x(y)   = 0
#   sigma_xx    = -P*lambda/M,  lambda = kappa - 2*mu/3
#
# The `test` script is a copy of tests/LowMachElasticPressure/test, which
# checks these closed-form values inline (no reference CSV needed here).

alamo.program = topop_lowmach
plot_file = tests/TopOpLowMachPressure/output

amr.plot_dt = 2.0e-7_s
amr.max_level = 0
amr.n_cell = 32 64
amr.max_grid_size = 64
amr.blocking_factor = 2
amr.regrid_int = -1
amr.cell.all = 1

timestep = 1.0e-7_s
stop_time = 3.0e-7_s
dynamictimestep.on = 0

geometry.prob_lo = 0.0    0.0     0.0
geometry.prob_hi = 3.2e-3 6.4e-3  0.0
geometry.is_periodic = 0 0 0

system.amount = kmol
gas.mw = 29.0_g/mol
gas.thermo.type = cpconstant
gas.thermo.cpconstant.cp_moles = 29113.0_J/kmol/K
gas.thermo.cpconstant.h0 = 0.0
gas.thermo.cpconstant.s0 = 0.0
gas.thermo.cpconstant.Tref = 0.0_K
gas.transport.type = mixture_averaged
gas.transport.mixture_averaged.type = constant
gas.transport.mixture_averaged.mu = 1.8e-5_Pa*s
gas.transport.mixture_averaged.k = 3.0_W/m/K
gas.eos.type = cpg

species.names = Gas Solid
Gas.mechanics   = fluid
Solid.mechanics = rigid_solid

Solid.reference_density = 1950.0_kg/m^3

# Single rigid_solid species -> the elastic model field is spatially
# uniform (see tests/LowMachElasticPressure/input for why).
Solid.elastic.model.mu    = 140.0
Solid.elastic.model.kappa = 150.0

chemistry.model.type = frozen
chemistry.solver.type = forward_euler

rigid.relaxation_time = 1.0e-8_s
rigid.velocity = 0.0 0.0

advection.type = muscl
advection.muscl.limiter.type = minmod
cfl = 0.8
include_viscosity = 1
implicit_viscosity = 1
include_conduction = 1
advect_temperature = 1
projection.enabled = 1
projection.tol_rel = 1.0e-10
projection.tol_abs = 1.0e-12
# Freeze pressure_mf at its IC -- see tests/LowMachElasticPressure/input.
projection.update_pressure = 0
diffusion.tol_rel = 1.0e-10
diffusion.tol_abs = 1.0e-12
diagnostics.interval = 0

# Complementary smooth density profiles (rigid_eta = solid fraction, Gas
# density = the ideal-gas-consistent complement). psi_TO and eta_LM below
# use the identical tanh profile so TopOpLowMach's model/rhs construction
# matches LowMach's own for this geometry exactly.
Solid.density.ic.type = expression
Solid.density.ic.expression.constant.rho = 1950.0
Solid.density.ic.expression.constant.y0  = 3.2e-3
Solid.density.ic.expression.constant.wy  = 2.0e-4
Solid.density.ic.expression.region0 = "rho*0.5*(1.0-tanh((y-y0)/wy))"

Gas.density.ic.type = expression
Gas.density.ic.expression.constant.P  = 1.0
Gas.density.ic.expression.constant.R  = 286.7
Gas.density.ic.expression.constant.T  = 300.0
Gas.density.ic.expression.constant.y0 = 3.2e-3
Gas.density.ic.expression.constant.wy = 2.0e-4
Gas.density.ic.expression.region0 = "(P/(R*T))*0.5*(1.0+tanh((y-y0)/wy))"

velocity.ic.type = constant
velocity.ic.constant.value = 0.0 0.0

temperature.ic.type = constant
temperature.ic.constant.value = 300.0

pressure.ic.type = constant
pressure.ic.constant.value = 1.0

component_density.bc.type = constant
component_density.bc.constant.type.xlo = neumann neumann
component_density.bc.constant.type.xhi = neumann neumann
component_density.bc.constant.type.ylo = neumann neumann
component_density.bc.constant.type.yhi = neumann neumann

velocity.bc.type = constant
velocity.bc.constant.type.xlo = dirichlet dirichlet
velocity.bc.constant.type.xhi = dirichlet dirichlet
velocity.bc.constant.type.ylo = dirichlet dirichlet
velocity.bc.constant.type.yhi = neumann neumann
velocity.bc.constant.val.xlo = 0.0 0.0
velocity.bc.constant.val.xhi = 0.0 0.0
velocity.bc.constant.val.ylo = 0.0 0.0

temperature.bc.type = constant
temperature.bc.constant.type.xlo = neumann
temperature.bc.constant.type.xhi = neumann
temperature.bc.constant.type.ylo = neumann
temperature.bc.constant.type.yhi = neumann

pressure.bc.type = constant
pressure.bc.constant.type.xlo = neumann
pressure.bc.constant.type.xhi = neumann
pressure.bc.constant.type.ylo = neumann
pressure.bc.constant.type.yhi = dirichlet
pressure.bc.constant.val.yhi = 1.0

# Elastic solve over the rigid solid phase. Pressure drives the interfacial
# body force; the constant traction is left at zero so the pressure term
# is the only driver.
elastic.type = static
elastic.traction = 0.0
elastic.apply_fluid_pressure = 1
elastic.etacutoff = 0.0
elastic.solver.verbose = 0
# One Newton iteration from a zeroed initial guess linearizes about F = I,
# giving the exact plane-strain linear-elastic solution.
elastic.solver.nriters = 1
elastic.zero_out_displacement = 0

# Soft ersatz void model -- required by TopOpLowMach. Soft enough (1e-4 of
# the solid moduli) to leave the solid's analytic solution unaffected.
# max_coarsening_level follows tests/LowMachElasticPressure's
# [2d-pressure-1Pa-softvoid] case: at this dx and modulus contrast, MLMG
# genuinely diverges (not just converges slowly) unless coarsening is
# capped -- see that test's Readme.rst/input for the full explanation.
elastic.void.model.mu    = 0.014
elastic.void.model.kappa = 0.015
elastic.max_coarsening_level = 2

# Base (y=ylo) is clamped. The x-faces are rollers (u_x = 0, zero shear) so
# the problem is exactly 1-D; the top (fluid side) is traction-free.
elastic.bc.type = constant
elastic.bc.constant.type.xlo = disp trac
elastic.bc.constant.type.xhi = disp trac
elastic.bc.constant.type.ylo = disp disp
elastic.bc.constant.type.yhi = trac trac
elastic.bc.constant.type.xloylo = disp disp
elastic.bc.constant.type.xhiylo = disp disp
elastic.bc.constant.type.xloyhi = disp trac
elastic.bc.constant.type.xhiyhi = disp trac

# TopOp: uniform solid model matching Solid.elastic.model above.
topop.model.mu    = 140.0
topop.model.kappa = 150.0

# psi_TO IC = the same tanh solid-fraction profile as Solid.density.ic, so
# the model blend in UpdateModel reproduces LowMach's own rigid_eta-masked
# model exactly. L.str = 0 keeps it immobile (no phase logic yet).
topop.psi.ic.type = expression
topop.psi.ic.expression.constant.y0 = 3.2e-3
topop.psi.ic.expression.constant.wy = 2.0e-4
topop.psi.ic.expression.region0 = "0.5*(1.0-tanh((y-y0)/wy))"
topop.psi.bc.type.xlo = NEUMANN
topop.psi.bc.type.xhi = NEUMANN
topop.psi.bc.type.ylo = NEUMANN
topop.psi.bc.type.yhi = NEUMANN

topop.alpha = 1.0
topop.beta  = 1.0
topop.gamma = 1.0
topop.L.str = 0.0
topop.lambda.str = 0.0
topop.volume0frac = 0.5

# eta_LM IC = the identical profile, so grad(eta_LM) lands exactly where
# LowMach's grad(rigid_eta) does for this geometry.
eta_lm.ic.type = expression
eta_lm.ic.expression.constant.y0 = 3.2e-3
eta_lm.ic.expression.constant.wy = 2.0e-4
eta_lm.ic.expression.region0 = "0.5*(1.0-tanh((y-y0)/wy))"
