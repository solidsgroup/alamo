alamo.program = fracture
type = dynamic
dynamic_only = false
time_evolving = true

system.time = s
system.length = m

timestep = 5e-9
stop_time = 5.0e-5

plot_file = tests/FracturePFCZM/output_kalthoff_winkler_50us
amr.plot_int = 1000
amr.max_level = 0
amr.n_cell = 512 512
amr.blocking_factor = 32
amr.regrid_int = 1000
amr.grid_eff = 0.9
amr.thermo.int = 1
amr.nsubsteps = 2
amr.node.any = 0
amr.cell.all = 1

viscous.mu_newton = 0.0
mechanics.rho = 8000

geometry.prob_lo = 0_m 0_m
geometry.prob_hi = 0.1_m 0.1_m
geometry.is_periodic = 0 0

crack.refinement_threshold = 0.1
crack.driving_force_refinement_threshold = 0.1
crack.df.tol_rel = 0.01
crack.df.tol_abs = 0.0
crack.df.mult_Gc = 1.0
crack.df.mult_lap = 1.0
crack.df.beta = 0.0
crack.df.el_mult = 1.0
crack.diagnostics = 0

crack.model1.G_c = 2.213e4_N/m
crack.model1.fracture_strength = 1.0e9_Pa
crack.model1.E = 1.9e11_Pa
crack.model1.zeta = 7.5e-4_m
crack.model1.mobility = 20.0
crack.model1.gtype = wu_linear
crack.model1.wtype = wu
crack.model1.threshold = 1.0

# Kalthoff-Winkler half-specimen: 50 mm notch at y=50 mm.
crack.ic.type = notch
crack.ic.notch.center = 0.025_m 0.05_m
crack.ic.notch.orientation = 1 0
crack.ic.notch.length = 0.05_m
crack.ic.notch.thickness = 3e-4_m
crack.ic.notch.eps = 1e-4
crack.ic.notch.mollifier = erf

crack.bc.type.xhi = NEUMANN
crack.bc.type.xlo = NEUMANN
crack.bc.type.yhi = NEUMANN
crack.bc.type.ylo = NEUMANN

material.model1.E = 1.9e11
material.model1.nu = 0.3
material.refinement_threshold = 100

# Tapered anti-symmetric shear plus normal closure. This is a controlled
# Mode-II surrogate for the Kalthoff-Winkler initiation angle; at 35 us the
# c < 0.5 crack core kinks 61.1 degrees from the initial horizontal notch.
bc.type = expression
bc.expression.type.xloylo = trac disp
bc.expression.type.xlo    = trac trac
bc.expression.type.xloyhi = trac trac
bc.expression.type.ylo    = trac disp
bc.expression.type.yhi    = trac trac
bc.expression.type.xhi    = trac trac
bc.expression.type.xhiylo = trac disp
bc.expression.type.xhiyhi = trac trac
bc.expression.val.xloylo = "0.0" "0.0"
bc.expression.val.xlo = "0.0" "0.0"
bc.expression.val.xloyhi = "0.0" "0.0"
bc.expression.val.ylo = "-sin(31.4159265359*x)*((t<1e-6)*3.0e14*t + (t>=1e-6)*3.0e8)" "0.0"
bc.expression.val.yhi = "sin(31.4159265359*x)*((t<1e-6)*3.0e14*t + (t>=1e-6)*3.0e8)" "-((t<1e-6)*4.5e14*t + (t>=1e-6)*4.5e8)"
bc.expression.val.xhiylo = "0.0" "0.0"
bc.expression.val.xhiyhi = "0.0" "0.0"

elasticop.small = 1.e-3
solver.bottom_solver = smoother
solver.tol_abs = 1E-16
solver.tol_rel = 1e-7
solver.verbose = 0
solver.nriters = 1
solver.fixed_iter = 10000
solver.normalize_ddw = 1
solver.average_down_coeffs = 1

interval = 1
print_residual = 0
print_model = 0
plot_psi = 1
elastic_ref_threshold = 0.0001
zero_out_displacement = 0
amrex.throw_exception = 1
