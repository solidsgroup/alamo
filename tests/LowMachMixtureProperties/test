#!/usr/bin/env python3
import glob
import sys

sys.path.insert(0, "../../scripts")
import testlib


# Golden values are from multicomponent_master:tests/FlowDiffusion0D.
EXPECTED = {
    "viscous-thermal-constant": {
        "viscosity": 1.7142991458692116e-05,
        "thermal_conductivity_coeff": 0.024446070520350752,
        "diffusion_coeff001": 1.3957619455684473e-05,
    },
    "viscous-thermal-LJ": {
        "viscosity": 1.6884124446477103e-05,
        "thermal_conductivity_coeff": 0.0240145886371462,
        "diffusion_coeff001": 1.4573514272511353e-05,
    },
    "species-constant": {
        "viscosity": 1.5815104346700175e-05,
        "thermal_conductivity_coeff": 0.01907231139644361,
        "diffusion_coeff001": 1.5060017708001669e-05,
    },
    "species-LJ": {
        "viscosity": 1.620866188510972e-05,
        "thermal_conductivity_coeff": 0.019795463972170718,
        "diffusion_coeff001": 1.5249863744230164e-05,
    },
}


outdir = sys.argv[1]
case = next((name for name in EXPECTED if outdir.endswith("_" + name)), None)
if case is None:
    raise RuntimeError(f"Cannot identify LowMach mixture-property case from {outdir}")

plotfiles = sorted(glob.glob(f"{outdir}/*cell/"))
if not plotfiles:
    raise RuntimeError(f"No cell plotfiles found in {outdir}")

for plotfile in plotfiles:
    data = testlib.yt.load(plotfile).all_data()
    for field, expected in EXPECTED[case].items():
        values = data[field].to_ndarray()
        if not testlib.numpy.all(testlib.numpy.isfinite(values)):
            raise RuntimeError(f"{field} contains non-finite values in {plotfile}")
        testlib.numpy.testing.assert_allclose(
            values,
            expected,
            rtol=2.0e-12,
            atol=2.0e-15,
            err_msg=f"{case} {field} differs from the hydro reference",
        )

print(f"LowMach mixture properties match hydro for {case}")
