#@ [2d]
#@ exe = lowmach
#@ dim = 2
#@ timeout = 120

# A uniform one-step test isolates phase transfer from transport. Kinetic and
# heat-release values are chosen for verification, not physical calibration.
plot_file = tests/LMHomogeneousBinder/output
amr.plot_int = 1
amr.max_level = 0
amr.n_cell = 4 4
amr.max_grid_size = 4
amr.blocking_factor = 2
amr.regrid_int = -1
timestep = 1.0e-4_s
stop_time = 1.0e-4_s
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 1.0 1.0
geometry.is_periodic = 0 0 0
system.amount = kmol
gas.mw = 20.0_g/mol 40.0_g/mol
gas.thermo.type = cpconstant
gas.thermo.cpconstant.cp_moles = 20.0_J/mol/K 40.0_J/mol/K
gas.thermo.cpconstant.h0 = 0.0 0.0
gas.thermo.cpconstant.s0 = 0.0 0.0
gas.thermo.cpconstant.Tref = 300.0_K 300.0_K
gas.transport.type = rocfire
gas.transport.rocfire.lambda_a = 0.0
gas.transport.rocfire.lambda_b = 0.1_W/m/K
gas.eos.type = tpg
species.names = HTPB_gas AP_gas HTPB_solid AP_solid
HTPB_gas.mechanics = fluid
AP_gas.mechanics = fluid
HTPB_solid.mechanics = rigid_solid
AP_solid.mechanics = rigid_solid
HTPB_solid.reference_density = 920.0_kg/m^3
AP_solid.reference_density = 1950.0_kg/m^3
HTPB_solid.specific_heat = 2418.29_J/kg/K
AP_solid.specific_heat = 1297.90_J/kg/K
HTPB_solid.thermal_conductivity = 0.1300_W/m/K
AP_solid.thermal_conductivity = 0.4186_W/m/K
chemistry.model.type = frozen
chemistry.solver.type = forward_euler
mechanisms.names = HTPB_pyrolysis
HTPB_pyrolysis.type = phase_change
HTPB_pyrolysis.phase_change.in = HTPB_solid
HTPB_pyrolysis.phase_change.out = HTPB_gas
HTPB_pyrolysis.phase_change.rate_multiplier = 1.0
HTPB_pyrolysis.phase_change.activation_temperature = 0.0_K
HTPB_pyrolysis.phase_change.homogeneous = true
HTPB_pyrolysis.phase_change.homogeneous.ap_solid = AP_solid
HTPB_pyrolysis.phase_change.homogeneous.total_mass_fraction = 0.85
HTPB_pyrolysis.phase_change.homogeneous.resolved_mass_fraction = 0.65
HTPB_pyrolysis.phase_change.homogeneous.ap_gas = AP_gas
HTPB_pyrolysis.phase_change.homogeneous.ap_rate_multiplier = 4.0
HTPB_pyrolysis.phase_change.homogeneous.ap_activation_temperature = 0.0_K
HTPB_pyrolysis.phase_change.homogeneous.binder_heat_release = -1.0e5_J/kg
HTPB_pyrolysis.phase_change.homogeneous.ap_heat_release = 2.0e5_J/kg
HTPB_pyrolysis.phase_change.phase_field.type = allencahn
HTPB_pyrolysis.phase_change.phase_field.allencahn.mobility = 0.01_1/Pa/s
HTPB_pyrolysis.phase_change.phase_field.allencahn.lambda = 8.0_Pa
HTPB_pyrolysis.phase_change.phase_field.allencahn.kappa = 1.0e-8_J/m
HTPB_pyrolysis.phase_change.phase_field.allencahn.w1 = 1.0
rigid.relaxation_time = 1.0e-8_s
rigid.velocity = 0.0 0.0
advection.type = upwind
cfl = 0.25
include_viscosity = 0
include_conduction = 1
advect_temperature = 0
projection.enabled = 1
projection.tol_rel = 1.0e-11
projection.tol_abs = 1.0e-12
projection.verbose = 0
diffusion.tol_rel = 1.0e-11
diffusion.tol_abs = 1.0e-12
diffusion.verbose = 0
diagnostics.extended_fields = 1
# IC densities describe the blend, using additive constituent volumes.
# rho_blend = 1 / [(3/7)/920 + (4/7)/1950] = 1317.7334732423922.
HTPB_solid.density.ic.type = constant
HTPB_solid.density.ic.constant.value = 658.8667366211961_kg/m^3
HTPB_gas.density.ic.type = constant
HTPB_gas.density.ic.constant.value = 3.608171
velocity.ic.type = constant
velocity.ic.constant.value = 0.0 0.0
temperature.ic.type = constant
temperature.ic.constant.value = 1000.0
pressure.ic.type = constant
pressure.ic.constant.value = 3.0e6
component_density.bc.type = constant
component_density.bc.constant.type.xlo = neumann
component_density.bc.constant.type.xhi = neumann
component_density.bc.constant.type.ylo = neumann
component_density.bc.constant.type.yhi = neumann
velocity.bc.type = constant
velocity.bc.constant.type.xlo = neumann
velocity.bc.constant.type.xhi = neumann
velocity.bc.constant.type.ylo = neumann
velocity.bc.constant.type.yhi = neumann
temperature.bc.type = constant
temperature.bc.constant.type.xlo = neumann
temperature.bc.constant.type.xhi = neumann
temperature.bc.constant.type.ylo = neumann
temperature.bc.constant.type.yhi = neumann
pressure.bc.type = constant
pressure.bc.constant.type.xlo = neumann
pressure.bc.constant.type.xhi = neumann
pressure.bc.constant.type.ylo = neumann
pressure.bc.constant.type.yhi = dirichlet
pressure.bc.constant.val.yhi = 3.0e6
