#!/usr/bin/env python3
from pathlib import Path
import sys

import numpy as np
import yt

yt.funcs.mylog.setLevel(40)
output = Path(sys.argv[1])
plots = sorted(output.glob("*cell"))
if len(plots) < 2:
    raise RuntimeError("Wall-flow test requires initial and final plotfiles")
ds = yt.load(str(plots[-1]))
data = ds.all_data()
y = data["index", "y"].to_ndarray()
time = float(ds.current_time)
nu = 1.1229e-2 / 1.12254198039921
viscous = "inviscid" not in output.name
amplitude = np.exp(-nu * np.pi**2 * time) if viscous else 1.0
expected = y + 0.2 * np.sin(np.pi * y) * amplitude
error = data["velocityx"].to_ndarray() - expected
volume = data["index", "cell_volume"].to_ndarray()
rms = np.sqrt(np.sum(volume * error**2) / np.sum(volume))
# Resolves the former O(1e-3) wall bias while allowing second-order spatial
# error and backward-Euler temporal error at the prescribed grid/timestep.
tolerance = 2.0e-5 if viscous else 1.0e-10
if rms > tolerance:
    raise AssertionError(f"Wall-flow RMS velocity error {rms} exceeds {tolerance}")
if np.max(np.abs(data["velocityy"].to_ndarray())) > 1.0e-10:
    raise AssertionError("Wall flow developed a transverse velocity")
if "amr" in output.name and ds.max_level != 1:
    raise AssertionError("AMR wall-flow test requires refinement level 1")
print(f"Wall-flow analytic regression passed: RMS velocity error = {rms:.6g}")
