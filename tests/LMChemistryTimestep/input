#@ [2d-*]
#@ exe = lowmach
#@ dim = 2
#@ timeout = 30
#@
#@ [2d-report]
#@ args = chemistry.timestep.mode=report

# Homogeneous hot AP/HTPB gas exercises the optional source-based chemistry
# timescale.  In limit mode the first step must be smaller than the configured
# hydrodynamic step; report mode must leave the step unchanged.

plot_file = tests/LMChemistryTimestep/output
amr.plot_int = 1
amr.max_level = 0
amr.n_cell = 4 4
amr.max_grid_size = 4
amr.blocking_factor = 2
amr.regrid_int = -1

max_step = 1
timestep = 1.0e-7_s
stop_time = 1.0e-6_s
dynamictimestep.on = 1
dynamictimestep.min = 1.0e-12_s
dynamictimestep.max = 1.0e-4_s
dynamictimestep.verbose = 0
integration.type = RungeKutta
integration.rk.type = 3

geometry.prob_lo = 0.0_m 0.0_m 0.0_m
geometry.prob_hi = 1.0e-4_m 1.0e-4_m 0.0_m
geometry.is_periodic = 1 0 0

system.amount = kmol
gas.mw = 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol
gas.thermo.type = gross_model
gas.thermo.gross_model.cp_mass = 0.3_cal/g/K
gas.thermo.gross_model.Tref = 273.15_K
gas.transport.type = gross_model
gas.transport.gross_model.prandtl = 0.69
gas.transport.gross_model.lewis = 1.0
gas.transport.gross_model.lambda_a = 2.13037e-7_cal/cm/s/K^2
gas.transport.gross_model.lambda_b = 5.32743e-6_cal/cm/s/K
gas.eos.type = tpg

species.names = AP_gas HTPB_gas Mono Premixed Primary Final
AP_gas.mechanics = fluid
HTPB_gas.mechanics = fluid
Mono.mechanics = fluid
Premixed.mechanics = fluid
Primary.mechanics = fluid
Final.mechanics = fluid

chemistry.model.type = gross_model
chemistry.model.gross_model.A = 27.0e3_g/cm^3/s 25.3e3_g/cm^3/s 5.0e3_g/cm^3/s 0.4e3_g/cm^3/s
chemistry.model.gross_model.pressure_exponent = 1.6 1.7 1.7 1.7
chemistry.model.gross_model.activation_energy = 15.9_kcal/mol 14.5_kcal/mol 11.3_kcal/mol 14.5_kcal/mol
chemistry.model.gross_model.qgas = 430.0_cal/g 447.0_cal/g 8365.0_cal/g 2127.0_cal/g
chemistry.model.gross_model.pressure_reference = 1.0_bar
chemistry.solver.type = backward_euler
chemistry.solver.backward_euler.nsubsteps = 1
chemistry.solver.backward_euler.max_iter = 100
chemistry.solver.backward_euler.reltol = 1.0e-8
chemistry.solver.backward_euler.abstol = 1.0e-12
chemistry.timestep.mode = limit
chemistry.timestep.max_fractional_change = 0.1
chemistry.timestep.reactant_mass_fraction_floor = 1.0e-4

advection.type = muscl
advection.muscl.limiter.type = minmod
cfl = 0.8
include_viscosity = 0
include_conduction = 0
advect_temperature = 1
projection.enabled = 1
projection.tol_rel = 1.0e-10
projection.tol_abs = 1.0e-12
projection.verbose = 0
projection.update_pressure = 1
diagnostics.interval = 1

AP_gas.density.ic.type = expression
AP_gas.density.ic.expression.constant.P = 3.0_MPa
AP_gas.density.ic.expression.constant.R = 319.7870238_J/kg/K
AP_gas.density.ic.expression.constant.T = 1500.0_K
AP_gas.density.ic.expression.region0 = "0.5*P/(R*T)"
HTPB_gas.density.ic.type = expression
HTPB_gas.density.ic.expression.constant.P = 3.0_MPa
HTPB_gas.density.ic.expression.constant.R = 319.7870238_J/kg/K
HTPB_gas.density.ic.expression.constant.T = 1500.0_K
HTPB_gas.density.ic.expression.region0 = "0.5*P/(R*T)"
Mono.density.ic.type = constant
Mono.density.ic.constant.value = 0.0_kg/m^3
Premixed.density.ic.type = constant
Premixed.density.ic.constant.value = 0.0_kg/m^3
Primary.density.ic.type = constant
Primary.density.ic.constant.value = 0.0_kg/m^3
Final.density.ic.type = constant
Final.density.ic.constant.value = 0.0_kg/m^3

velocity.ic.type = constant
velocity.ic.constant.value = 0.0_m/s 0.0_m/s
temperature.ic.type = constant
temperature.ic.constant.value = 1500.0_K
pressure.ic.type = constant
pressure.ic.constant.value = 3.0_MPa

component_density.bc.type = expression
component_density.bc.expression.constant.P = 3.0_MPa
component_density.bc.expression.constant.R = 319.7870238_J/kg/K
component_density.bc.expression.constant.T = 1500.0_K
component_density.bc.expression.type.xlo = periodic
component_density.bc.expression.type.xhi = periodic
component_density.bc.expression.type.ylo = neumann
component_density.bc.expression.type.yhi = dirichlet
component_density.bc.expression.val.yhi = "0.5*P/(R*T)" "0.5*P/(R*T)" "0.0" "0.0" "0.0" "0.0"
velocity.bc.type = constant
velocity.bc.constant.type.xlo = periodic
velocity.bc.constant.type.xhi = periodic
velocity.bc.constant.type.ylo = dirichlet
velocity.bc.constant.type.yhi = neumann
velocity.bc.constant.val.ylo = 0.0_m/s 0.0_m/s
temperature.bc.type = constant
temperature.bc.constant.type.xlo = periodic
temperature.bc.constant.type.xhi = periodic
temperature.bc.constant.type.ylo = neumann
temperature.bc.constant.type.yhi = neumann
pressure.bc.type = constant
pressure.bc.constant.type.xlo = periodic
pressure.bc.constant.type.xhi = periodic
pressure.bc.constant.type.ylo = neumann
pressure.bc.constant.type.yhi = dirichlet
pressure.bc.constant.val.yhi = 3.0_MPa
