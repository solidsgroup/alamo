#!/usr/bin/env python3
import glob
import sys

sys.path.insert(0, "../../scripts")
import testlib


outdir = sys.argv[1]
plotfiles = sorted(glob.glob(f"{outdir}/*cell/"))
if len(plotfiles) < 2:
    raise RuntimeError(
        "LMGrossModelLewisDiffusion requires initial and final plotfiles")


def state(path):
    data = testlib.yt.load(path).all_data()
    fractions = testlib.numpy.array([
        data[f"mass_fraction_{name}"].to_ndarray()
        for name in ("left", "right", "slow")
    ])
    return fractions


initial = state(plotfiles[0])
final = state(plotfiles[-1])
if not testlib.numpy.all(testlib.numpy.isfinite(final)):
    raise RuntimeError("Implicit species diffusion produced non-finite values")
if testlib.numpy.min(final) < -1.0e-12 or testlib.numpy.max(final) > 1.0 + 1.0e-12:
    raise RuntimeError("Implicit species diffusion produced unbounded fractions")
testlib.numpy.testing.assert_allclose(
    testlib.numpy.sum(final, axis=0), 1.0, rtol=0.0, atol=2.0e-12)
testlib.numpy.testing.assert_allclose(
    testlib.numpy.mean(final, axis=1),
    testlib.numpy.mean(initial, axis=1),
    rtol=0.0,
    atol=2.0e-12,
)
initial_amplitudes = 0.5 * (
    testlib.numpy.max(initial, axis=1) - testlib.numpy.min(initial, axis=1))
final_amplitudes = 0.5 * (
    testlib.numpy.max(final, axis=1) - testlib.numpy.min(final, axis=1))
if not testlib.numpy.all(
        (final_amplitudes > 0.0) &
        (final_amplitudes < initial_amplitudes)):
    raise RuntimeError(
        "The species did not diffuse across the implicit large timestep: "
        f"initial={initial_amplitudes}, final={final_amplitudes}")
if not final_amplitudes[2] > final_amplitudes[0]:
    raise RuntimeError(
        "The Le=5 species did not diffuse more slowly than the Le=1 species")

print("LowMach implicit per-species Lewis diffusion regression passed")
