#!/usr/bin/env python3
import glob
import sys

sys.path.insert(0, "../../scripts")
import testlib


def particle_moments(path):
    ds = testlib.yt.load(path)
    data = ds.all_data()
    rho = data["component_density_Al_solid"].to_ndarray()
    vapor = data["component_density_Al_vapor"].to_ndarray()
    volume = data[("index", "cell_volume")].to_ndarray()
    x = data[("index", "x")].to_ndarray()
    y = data[("index", "y")].to_ndarray()
    ux = data["velocityx"].to_ndarray()
    uy = data["velocityy"].to_ndarray()
    weight = rho * volume
    mass = weight.sum()
    vapor_mass = (vapor * volume).sum()
    def periodic_center(coordinate, dimension):
        # yt's BoxLib frontend does not retain geometry.is_periodic in the
        # plotfile metadata.  Every LMFreeRigidParticle variant is periodic
        # in x and y, so use the circular moment unconditionally here.
        lo = float(ds.domain_left_edge[dimension])
        length = float(ds.domain_width[dimension])
        angle = 2.0 * testlib.numpy.pi * (coordinate - lo) / length
        mean_angle = testlib.numpy.arctan2(
            (weight * testlib.numpy.sin(angle)).sum(),
            (weight * testlib.numpy.cos(angle)).sum())
        return lo + (mean_angle % (2.0 * testlib.numpy.pi)) * \
            length / (2.0 * testlib.numpy.pi)

    def minimum_image(displacement, dimension):
        length = float(ds.domain_width[dimension])
        return displacement - length * testlib.numpy.floor(
            displacement / length + 0.5)

    center_x = periodic_center(x, 0)
    center_y = periodic_center(y, 1)
    # Measure acceleration in the particle core.  The diffuse initial
    # interface overlaps the imposed gas velocity and would otherwise make a
    # nominally stationary particle appear to have finite initial momentum.
    core_weight = weight * (rho > 0.8 * 5.0)
    core_mass = core_weight.sum()
    velocity_x = (core_weight * ux).sum() / core_mass
    velocity_y = (core_weight * uy).sum() / core_mass
    dx = minimum_image(x - center_x, 0)
    dy = minimum_image(y - center_y, 1)
    radius = testlib.numpy.sqrt(
        (weight * (dx**2 + dy**2)).sum() / mass)
    covariance = testlib.numpy.array([
        [(weight * dx * dx).sum(), (weight * dx * dy).sum()],
        [(weight * dx * dy).sum(), (weight * dy * dy).sum()]]) / mass
    principal_moments = testlib.numpy.linalg.eigvalsh(covariance)
    anisotropy = principal_moments[-1] / principal_moments[0]
    # The configured disk has R=0.15 and eps=0.025.  Material outside 0.25
    # is therefore a sensitive measure of a shear-peeled rigid tail while
    # retaining the intended diffuse interface in the initial reference.
    tail_fraction = weight[dx * dx + dy * dy > 0.25**2].sum() / mass
    return (mass, vapor_mass, center_x, center_y, velocity_x, velocity_y,
            radius, anisotropy, tail_fraction)


outdir = sys.argv[1]
plotfiles = sorted(glob.glob(f"{outdir}/*cell/"))
if len(plotfiles) < 2:
    raise RuntimeError("LMFreeRigidParticle requires initial and final plotfiles")

initial = particle_moments(plotfiles[0])
final = particle_moments(plotfiles[-1])

is_sublimation = "sublimation" in outdir
is_periodic_crossing = "periodic-crossing" in outdir
if is_sublimation:
    total_initial = initial[0] + initial[1]
    total_final = final[0] + final[1]
    mass_change = abs(total_final - total_initial) / total_initial
    if mass_change > 1.0e-2:
        raise RuntimeError(f"Total aluminum mass changed by {mass_change:.3e}")
    if not final[0] < 0.995 * initial[0] or not final[1] > initial[1]:
        raise RuntimeError("Sublimation did not transfer solid aluminum to vapor")
else:
    mass_change = abs(final[0] - initial[0]) / initial[0]
    if mass_change > 1.0e-2:
        raise RuntimeError(f"Solid aluminum mass changed by {mass_change:.3e}")

if not final[4] > initial[4] + 2.0e-3:
    raise RuntimeError(
        f"Particle did not accelerate naturally: ux {initial[4]:.6e} -> {final[4]:.6e}")
domain_length_x = 1.0
downstream_displacement = final[2] - initial[2]
downstream_displacement -= domain_length_x * testlib.numpy.floor(
    downstream_displacement / domain_length_x + 0.5)
if not downstream_displacement > 0.0:
    raise RuntimeError(
        f"Particle center did not move downstream: x {initial[2]:.6e} -> {final[2]:.6e}")
transverse_displacement = final[3] - initial[3]
transverse_displacement -= testlib.numpy.floor(transverse_displacement + 0.5)
if abs(transverse_displacement) > 2.0e-3 or abs(final[5]) > 2.0e-3:
    raise RuntimeError("Symmetric particle developed excessive transverse motion")
shape_change = abs(final[6] - initial[6]) / initial[6]
if not is_sublimation and shape_change > 5.0e-2:
    raise RuntimeError(f"Particle radius of gyration changed by {shape_change:.3e}")
# Crossing the periodic seam on the deliberately coarse single-level grid
# adds measurable conservative-advection diffusion in the direction of
# travel.  Keep the original tight shape check elsewhere and bound that
# known crossing error independently.
anisotropy_limit = 1.10 if is_periodic_crossing else 1.02
if not is_sublimation and final[7] > anisotropy_limit:
    raise RuntimeError(
        f"Rigid particle became anisotropic: principal-moment ratio {final[7]:.6e}")
tail_limit = 5.0e-4 if is_periodic_crossing else 1.25 * initial[8]
if not is_sublimation and final[8] > tail_limit:
    raise RuntimeError(
        f"Rigid particle developed an excessive tail: mass fraction "
        f"{initial[8]:.6e} -> {final[8]:.6e}")

print("LowMach freely moving rigid particle regression passed")
