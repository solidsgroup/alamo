#@ [2d-smoke]
#@ exe = topop
#@ dim = 2
#@ timeout = 3600
#@ check = false

# Second Integrator::TopOpLowMach validation domain (see tests/TopOpCrossFlow
# for the first): a 3m x 1m channel with a rigid, non-design wall standing
# 1m from the inlet, and a 0.5m x 0.5m design region immediately behind it
# (in the flow direction) that the optimizer is free to fill with a
# supporting structure. Re = 1, parabolic inlet profile, slip top/bottom
# channel walls (unlike TopOpCrossFlow's no-slip walls), and the elastic
# solve fixed (disp) only on the floor -- the wall/support are cantilevered
# off the bottom, not clamped top and bottom.
#
# This is the first real use of topop.rigid_eta (src/Integrator/TopOp.H):
# the wall is a separate, permanently-solid field that psi never writes to
# and no mask ever gates -- unlike the design_mask approach tried earlier
# (freezing psi's own rate wherever mask == 0), which turned out to leak at
# its diffuse-interpolation boundary and let the "frozen" wall region
# actually change. psi itself is left completely unmasked and free to
# evolve everywhere; wherever the elastic model, the interfacial pressure
# traction, and the density LowMach sees are built (TopOpLowMach::
# UpdateModel / PushEtaToComponentDensity), they union rigid_eta with
# psi_TO/eta_LM, so the wall reads as solid unconditionally regardless of
# what psi is doing underneath it. This still fully participates in the
# elastic solve like any other solid, loading the support structure behind
# it exactly as before.
#
# Smoke test (check = false): proves the coupled FLOW/TOPOP/RELAX cycle
# runs stably on this more complex, two-region-with-a-frozen-obstacle
# geometry. Not a converged-optimum reference; see tests/TopOpCrossFlow's
# header for why that's a separate, much longer exercise. Reuses
# TopOpCrossFlow's validated constants wherever this domain doesn't force a
# change (moduli, void contrast, alpha/beta/gamma, L, air properties) rather
# than re-deriving them.

alamo.program = topop_lowmach
plot_file = tests/TopOpFixedWall/output

# Every 10th cycle, not every cycle (unlike the 20-cycle run) -- ~495
# cycles at 1 plotfile/cycle would be excessive I/O for this domain size.
amr.plot_int = 1010
amr.max_level = 1
amr.n_cell = 240 80
amr.max_grid_size = 40
amr.blocking_factor = 4
amr.regrid_int = 100
amr.grid_eff = 0.7
amr.cell.all = 1
amr.node.any = 0

# Required once amr.max_level > 0 -- see tests/TopOpCrossFlow/input's note:
# tags cells for refinement wherever the velocity gradient exceeds this.
velocity_refinement_criterion = 5.0e-2

# ~495 full FLOW/TOPOP/RELAX cycles (101 steps each, ~49995 steps): long
# enough, at topop.max_dpsidt = 0.002/cycle, to actually see psi move --
# the first 20-cycle run (stop_time = 8.08) barely changed at all, since
# 20 cycles * 0.002 is only a ~4% bound on psi's total possible drift
# anywhere. Not the full-length validation; see tests/TopOpCrossFlow's
# header for that pattern (short run committed, full run validated
# separately).
timestep = 4.0e-3
stop_time = 200.0
dynamictimestep.on = 0

geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 3.0 1.0 0.0
geometry.is_periodic = 0 0 0

system.amount = kmol
gas.mw = 28.0_g/mol
gas.thermo.type = cpconstant
gas.thermo.cpconstant.cp_moles = 29.1_J/mol/K
gas.thermo.cpconstant.h0 = 0.0
gas.thermo.cpconstant.s0 = 0.0
gas.thermo.cpconstant.Tref = 0.0_K
gas.transport.type = mixture_averaged
gas.transport.mixture_averaged.type = constant
# rho ~= 1.12254198039921 kg/m^3 for P=1e5 Pa, T=300 K, MW=28 g/mol (see
# tests/TopOpCrossFlow/input). Re = rho*U*L/mu with the channel height
# L = 1.0 and the parabolic inlet's centerline velocity Umax = 1.0 as the
# characteristic velocity, so mu = rho gives Re = 1, same as TopOpCrossFlow.
gas.transport.mixture_averaged.mu = 1.12254198039921_Pa*s
gas.transport.mixture_averaged.k = 0.02_W/m/K
gas.eos.type = cpg

species.names = Gas Solid
Gas.mechanics   = fluid
Solid.mechanics = rigid_solid

Solid.reference_density = 1950.0_kg/m^3
# Same rescaled moduli as tests/TopOpCrossFlow -- see that input's note by
# elastic.void.model for why (keeps the fluid pressure well below the
# material stiffness so the elastic solve doesn't saturate AdvancePsi's
# driving force in a single step).
Solid.elastic.model.mu    = 1.4e7
Solid.elastic.model.kappa = 1.5e7

chemistry.model.type = frozen
chemistry.solver.type = forward_euler

rigid.relaxation_time = 1.0e-3_s
rigid.velocity = 0.0 0.0

advection.type = muscl
advection.muscl.limiter.type = minmod
cfl = 0.5
include_viscosity = 1
implicit_viscosity = 1
include_conduction = 0
advect_temperature = 0
projection.enabled = 1
projection.tol_rel = 1.0e-10
projection.tol_abs = 1.0e-12
projection.update_pressure = 1
diagnostics.interval = 0
diagnostics.extended_fields = 1

# Geometry: rigid wall spans x in [1.0,1.05], y in [0,0.45] (1m from the
# inlet, 0.05m wide, 0.45m tall). The design region -- the support the wall
# stands on -- is the 0.5m square immediately behind it, x in [1.05,1.55],
# y in [0,0.5]. w is the tanh smoothing width shared by every field IC in
# this file (density, psi, rigid_eta, eta_LM) so all the interfaces line up.
Solid.density.ic.type = expression
Solid.density.ic.expression.constant.rho = 1950.0
Solid.density.ic.expression.constant.x0  = 1.0
Solid.density.ic.expression.constant.x1  = 1.05
Solid.density.ic.expression.constant.x2  = 1.55
Solid.density.ic.expression.constant.hw  = 0.45
Solid.density.ic.expression.constant.hs  = 0.50
Solid.density.ic.expression.constant.w   = 0.02
Solid.density.ic.expression.constant.volfrac0 = 1.0
Solid.density.ic.expression.region0 = "rho*((0.5*(1.0+tanh((x-x0)/w))*0.5*(1.0-tanh((x-x1)/w))*0.5*(1.0-tanh((y-hw)/w))) + volfrac0*(0.5*(1.0+tanh((x-x1)/w))*0.5*(1.0-tanh((x-x2)/w))*0.5*(1.0-tanh((y-hs)/w))))"

Gas.density.ic.type = expression
Gas.density.ic.expression.constant.P  = 100000.0
Gas.density.ic.expression.constant.R  = 296.9
Gas.density.ic.expression.constant.T  = 300.0
Gas.density.ic.expression.constant.x0  = 1.0
Gas.density.ic.expression.constant.x1  = 1.05
Gas.density.ic.expression.constant.x2  = 1.55
Gas.density.ic.expression.constant.hw  = 0.45
Gas.density.ic.expression.constant.hs  = 0.50
Gas.density.ic.expression.constant.w   = 0.02
Gas.density.ic.expression.constant.volfrac0 = 1.0
Gas.density.ic.expression.region0 = "(P/(R*T))*(1.0 - ((0.5*(1.0+tanh((x-x0)/w))*0.5*(1.0-tanh((x-x1)/w))*0.5*(1.0-tanh((y-hw)/w))) + volfrac0*(0.5*(1.0+tanh((x-x1)/w))*0.5*(1.0-tanh((x-x2)/w))*0.5*(1.0-tanh((y-hs)/w)))))"

# Parabolic inlet: 0 at ylo/yhi, Umax at the centerline y = H/2. Outlet
# (xhi) natural (neumann). Top/bottom channel walls (ylo/yhi) are slip: the
# tangential (x) component is neumann (free), the normal (y) component is
# dirichlet 0 -- see src/BC/Expression.H's "type.<face>" ordering, which is
# always x-component-then-y-component regardless of which face it's on.
velocity.bc.type = expression
velocity.bc.expression.constant.Umax = 1.0
velocity.bc.expression.constant.H    = 1.0
velocity.bc.expression.type.xlo = dirichlet dirichlet
velocity.bc.expression.val.xlo  = "4.0*Umax*(y/H)*(1.0-y/H)" "0.0"
velocity.bc.expression.type.xhi = neumann neumann
velocity.bc.expression.val.xhi  = "0.0" "0.0"
velocity.bc.expression.type.ylo = neumann dirichlet
velocity.bc.expression.val.ylo  = "0.0" "0.0"
velocity.bc.expression.type.yhi = neumann dirichlet
velocity.bc.expression.val.yhi  = "0.0" "0.0"

velocity.ic.type = constant
velocity.ic.constant.value = 0.0 0.0

temperature.ic.type = constant
temperature.ic.constant.value = 300.0

pressure.ic.type = constant
pressure.ic.constant.value = 100000.0

component_density.bc.type = constant
component_density.bc.constant.type.xlo = neumann neumann
component_density.bc.constant.type.xhi = neumann neumann
component_density.bc.constant.type.ylo = neumann neumann
component_density.bc.constant.type.yhi = neumann neumann

temperature.bc.type = constant
temperature.bc.constant.type.xlo = neumann
temperature.bc.constant.type.xhi = neumann
temperature.bc.constant.type.ylo = neumann
temperature.bc.constant.type.yhi = neumann

# Outlet pressure pinned at the IC value; slip walls get neumann pressure
# same as TopOpCrossFlow's no-slip walls (velocity is prescribed there
# instead, not pressure).
pressure.bc.type = constant
pressure.bc.constant.type.xlo = neumann
pressure.bc.constant.type.xhi = dirichlet
pressure.bc.constant.type.ylo = neumann
pressure.bc.constant.type.yhi = neumann
pressure.bc.constant.val.xhi = 100000.0

elastic.type = static
elastic.traction = 0.0
elastic.apply_fluid_pressure = 1
elastic.etacutoff = 0.0
elastic.solver.verbose = 4
elastic.solver.nriters = 1

# The repeated elastic-solve MLMG failures (steps ~910/1516/1617 across
# several parameter sweeps) traced to two independent causes, not to the
# psi/mask geometry: (1) the Newton solve warm-starts disp_mf from the
# previous cycle's converged displacement (Base/Mechanics.H:243), which let
# the residual blow up outright at cycle 9 once the RHS drifted enough
# between cycles; (2) once that was fixed, a slower stall remained where
# the *bottom* solve specifically failed to converge (repeated "MLMG:
# Bottom solve failed") -- the default bicgstab bottom solver couldn't
# handle the ~20x void/solid modulus contrast at the coarsest level.
# zero_out_displacement removes the bad warm start; bottom_solver=smoother
# with a much higher bottom_max_iter fixes the bottom-solve stall. Verified
# clean past step 7500 (vs. failing by step ~1600 before) with both fixes.
elastic.zero_out_displacement = 1
elastic.solver.max_iter = 500
elastic.solver.bottom_solver = smoother
elastic.solver.bottom_max_iter = 1000

# 20x void contrast, same as tests/TopOpCrossFlow (see that input's note).
elastic.void.model.mu    = 7.0e5
elastic.void.model.kappa = 7.5e5
elastic.max_coarsening_level = 2

# Force AMR refinement wherever adjacent nodes' mu or kappa differ by more
# than 2x, so coarse-fine boundaries track the solid/void modulus contrast
# (including as it moves inside the solid) instead of landing on top of
# it -- crossing a large modulus jump at a refinement boundary can
# destabilize the elastic MLMG solve independent of amr.regrid_int.
modulus_refinement_criterion = 2.0

# One full FLOW/TOPOP/RELAX cycle: 90 FLOW steps, 1 TOPOP step, 10 RELAX
# steps, 101 total. n_flow scaled up 3x from TopOpCrossFlow's 30 to match
# this domain's 3x longer length (same dt, same Umax).
elastic.interval = 101

# Only the floor (ylo) is a displacement BC -- the wall and its support are
# cantilevered off the bottom of the channel, not clamped at yhi too (unlike
# TopOpCrossFlow, where the solid strip spans and touches both channel
# walls). xlo/xhi/yhi are traction-free: nothing in this geometry reaches
# those boundaries.
elastic.bc.type = constant
elastic.bc.constant.type.xlo = trac trac
elastic.bc.constant.type.xhi = trac trac
elastic.bc.constant.type.ylo = disp disp
elastic.bc.constant.type.yhi = trac trac
elastic.bc.constant.type.xloylo = disp disp
elastic.bc.constant.type.xhiylo = disp disp
elastic.bc.constant.type.xloyhi = trac trac
elastic.bc.constant.type.xhiyhi = trac trac

topop.n_flow  = 90
topop.n_relax = 10
# Parse placeholder only -- TopOp::ComputePsiDt overwrites the actual
# TOPOP-step pseudo-dt every cycle via topop.max_dpsidt. See
# tests/TopOpCrossFlow/input's note for why.
topop.dt = 0.02
topop.relax.dt = 1.0e-2

topop.model.mu    = 1.4e7
topop.model.kappa = 1.5e7

# Design-square term only (dropped the wall term that used to live here) --
# psi_TO now represents only the evolvable support, not the wall. Nothing
# masks its evolution anymore; the wall staying fixed is now rigid_eta's
# job entirely (below), combined with psi via a union wherever the model,
# traction, or LowMach's density are built.
topop.psi.ic.type = expression
topop.psi.ic.expression.constant.x1  = 1.05
topop.psi.ic.expression.constant.x2  = 1.55
topop.psi.ic.expression.constant.hs  = 0.50
topop.psi.ic.expression.constant.w   = 0.02
topop.psi.ic.expression.constant.volfrac0 = 1.0
topop.psi.ic.expression.region0 = "volfrac0*(0.5*(1.0+tanh((x-x1)/w))*0.5*(1.0-tanh((x-x2)/w))*0.5*(1.0-tanh((y-hs)/w)))"
topop.psi.bc.type.xlo = NEUMANN
topop.psi.bc.type.xhi = NEUMANN
topop.psi.bc.type.ylo = NEUMANN
topop.psi.bc.type.yhi = NEUMANN

# rigid_eta: the wall, x in [1.0,1.05], y in [0,0.45]. Permanently solid --
# never written to by AdvancePsi, RelaxEtaLM, or PushEtaToComponentDensity
# (see TopOp.H / TopOpLowMach.H class comments). tanh-smoothed with the same
# width w as every other field IC in this file, since its gradient is now
# actually taken (for the interfacial pressure traction in UpdateModel), not
# just pointwise-multiplied the way the old design_mask was.
topop.rigid_eta.ic.type = expression
topop.rigid_eta.ic.expression.constant.x0 = 1.0
topop.rigid_eta.ic.expression.constant.x1 = 1.05
topop.rigid_eta.ic.expression.constant.hw = 0.45
topop.rigid_eta.ic.expression.constant.w  = 0.02
topop.rigid_eta.ic.expression.region0 = "0.5*(1.0+tanh((x-x0)/w))*0.5*(1.0-tanh((x-x1)/w))*0.5*(1.0-tanh((y-hw)/w))"
topop.rigid_eta.bc.type.xlo = NEUMANN
topop.rigid_eta.bc.type.xhi = NEUMANN
topop.rigid_eta.bc.type.ylo = NEUMANN
topop.rigid_eta.bc.type.yhi = NEUMANN

# alpha/beta from prior group work, alpha then re-tuned down from 200.0: at
# 200.0 the equilibrium interface width sqrt(beta/alpha) = sqrt(0.01/200)
# ~= 0.007m was only ~1 cell wide at this run's finest level
# (dx_level1 = 0.00625m) -- an under-resolved interface, which is what
# caused a genuine MLMG failure in the elastic solve at cycle 9 (STEP 910)
# once the interface actually started moving under max_dpsidt=0.0075 (see
# below). alpha=10.0 gave a ~5-cell-wide interface (sqrt(0.01/10)/dx_level1
# = 0.0316/0.00625 ~= 5.06), the low edge of the 5-7 cell band wanted for
# the elastic solve to resolve the modulus contrast smoothly without
# smearing it across the whole design region. Retuned to alpha=7.0 to
# center it instead: sqrt(0.01/7) ~= 0.0378m, ~6.05 cells at
# dx_level1 = 0.00625m -- same beta, same reasoning, just more margin on
# both sides (still far sharper than the original 4.0/1.0, which gave a
# 0.5m-wide interface that smeared across the whole back end of the design
# region instead of forming a sharp psi = 0/1 shape).
topop.alpha = 7.0
topop.beta  = 0.01
topop.gamma = 1.0
topop.L.str = 1.0e-3
# Volume cap, same mechanism as tests/TopOpCrossFlow: at most 25% of the
# original 0.5m x 0.5m design square (0.25*0.25 = 0.0625 m^2), over the
# 3.0 m^2 domain: 0.0625/3.0 = 0.02083(3). Unlike before, the frozen wall's
# area is not added here -- psi_TO (and therefore the integrated `volume`
# variable this constrains) no longer includes the wall at all, since the
# wall is rigid_eta now, a field the volume integral never reads.
#
# volfrac0 above is 1.0, not 0.25: the square starts fully solid, ~0.19 m^2
# away from this target, so the constraint has to carve material away
# rather than merely hold the IC in place -- the void-forming behavior
# this test is meant to exercise.
#
# lambda.str ramps 10x slower than tests/TopOpCrossFlow's schedule
# (end time 60.0, not 6.0) -- that schedule was tuned for a volume error
# that starts near zero and drifts slowly (~0.0002/cycle); here the error
# starts at ~0.19, two orders of magnitude larger. At the original 6.0
# end-time, lambda(topop_time=0.04, i.e. cycle 2) was already ~334, so
# lambda*(volume-volume0) contributed a uniform driving-force term of
# ~334*0.19 ~= 63 -- on top of whatever local term set the dynamic dt via
# ComputePsiDt, which does not itself bound this term's absolute
# contribution to the driving force, only the fastest-moving cell's total
# rate. A run with amr.max_level=1 diverged (genuine MLMG failure) at the
# start of cycle 3, right after this term's second application -- ruled in
# by the failing solve's backtrace (Solver::Nonlocal::Newton::solve, the
# elastic solve, not the flow's projection solve) landing exactly one
# TOPOP step after lambda first became non-negligible. At end time 60.0,
# lambda(0.04) ~= 34 instead of ~334, a 10x weaker uniform push while the
# volume error is still this large.
#
# max_dpsidt: 0.0075 (tuned at alpha=200/beta=0.01) let the elastic solve
# diverge at cycle 9 once alpha=200 sharpened the interface below the grid
# resolution (see the alpha comment above). Dropped to 0.005 alongside the
# alpha=10.0 change, both to add margin against the now-resolved-but-still
# sharp interface and because 0.005 was already confirmed stable for 6
# full cycles in the earlier alpha=200/beta=0.01 sweep.
topop.max_dpsidt = 0.005
topop.lambda.str = (0.0,60.0:1.0,5.0e4)
topop.volume0frac = 0.020833333333333333

# Design-square term only, matching topop.psi.ic above -- eta_LM relaxes
# toward psi_TO (RelaxEtaLM), which no longer carries the wall. The wall
# reaches LowMach's density via the union with rigid_eta in
# PushEtaToComponentDensity, not through eta_LM's own IC/relaxation.
eta_lm.ic.type = expression
eta_lm.ic.expression.constant.x1  = 1.05
eta_lm.ic.expression.constant.x2  = 1.55
eta_lm.ic.expression.constant.hs  = 0.50
eta_lm.ic.expression.constant.w   = 0.02
eta_lm.ic.expression.constant.volfrac0 = 1.0
eta_lm.ic.expression.region0 = "volfrac0*(0.5*(1.0+tanh((x-x1)/w))*0.5*(1.0-tanh((x-x2)/w))*0.5*(1.0-tanh((y-hs)/w)))"
