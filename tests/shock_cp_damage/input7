alamo.program = lagrangian_shock_cp_damage
alamo.program.mechanics.model = finite.crystalplastic

### 512x256: x refined 2x AND y refined 4x relative to the DIV04 base (256 64). NOTE: this CHANGES the cell aspect ratio.
### 512x256: dx = 0.003504/512 = 6.84375e-6 (= DIV04 dx / 2 = 1.36875e-5/2); dy = 0.0027/256 = 1.0546875e-5 (= DIV04 dy / 4).
### 512x256: dy/dx = 1.541 (was 3.082 in DIV04/4X/64x16). Cells are ~2x closer to square.
### 512x256: this is NOT a uniform refinement of DIV04 or 4X, so it does not lie on their convergence line.
### OLD: amr.n_cell = 256 64                     ### DIV04 (dx=1.36875e-5, dy=4.21875e-5, aspect 3.082)
### OLD: amr.n_cell = 1024 256                   ### 4X   (dx=3.421875e-6, dy=1.0546875e-5, aspect 3.082)
amr.n_cell           = 64 16                  ### 512x256 (aspect 1.541)
geometry.prob_lo     = 0.0   0.0
### OLD: geometry.prob_hi     = 0.003504 0.0108     # full y
### OLD: geometry.prob_hi     = 0.003504 0.0012     # DIV09
geometry.prob_hi     = 0.003504 0.0027             ### DIV04 y-domain (UNCHANGED)
geometry.is_periodic = 0 1
amr.blocking_factor  = 4                           ### 512x256: divides 512 and 256 (-> 128, 64); OK
amr.regrid_int       = 100
amr.grid_eff         = 1.0
amr.node.all         = 1
### OLD: amr.plot_int = 1000
amr.plot_int         = 100                         ### 512x256: dx = 2x that of 4X => ~half the steps; halved to keep a comparable frame count
amr.nsubsteps        = 1
ref_threshold.euler  = 0.005
amr.n_error_buff     = 0
amr.max_level        = 0
amr.max_grid_size    = 512

### 512x256: dt is CFL-adapted every step; STEP 0 uses this seed at the unshocked state (c = C0 = 3430).
### 512x256: CFL uses min(dx,dy) = dx = 6.84375e-6. Ceiling = 0.4*dx/3430 = 7.98e-10. Seed = 5e-10 (~0.63 of ceiling).
### OLD: timestep  = 1e-9      ### DIV04 seed
### OLD: timestep  = 2.5e-11   ### 4X seed
timestep  = 1e-9      ### 512x256
stop_time = 2.5e-6      ### UNCHANGED (x-transit timing untouched by mesh)

### OLD: plot_file = tests/shock_cp_damage/output_at1
### OLD: plot_file = tests/shock_cp_damage/output_at1_1024x256
plot_file = tests/shock_cp_damage/output_at1_512x256   ### 512x256

type = dynamic
time_evolving = true
viscous.mu_dashpot = 0
viscous.mu_newton  = 0

euler.ic.type                 = eulerangles
euler.ic.eulerangles.fit      = coord
euler.ic.eulerangles.coord.lo = 0.00105 0.0
euler.ic.eulerangles.coord.hi = 0.003504 0.0027    ### DIV04 (UNCHANGED: same PNG; fit=coord supersamples it at 512x256 -> finer grain resolution than DIV04)
euler.ic.eulerangles.filename = tests/shock_cp_damage/orient_100_div04_slice0.png

nmodels = 1
model1.C11 = 261.0
model1.C12 = 156.3
model1.C44 = 82.60
model1.euler1 = 0.0
model1.euler2 = 0.0
model1.euler3 = 0.0
model1.gammadot0   = 2.5143e9
model1.DeltaG      = 1.5762e-19
model1.p_exp       = 0.3387
model1.q_exp       = 1.9519
model1.burg        = 2.863e-7
model1.theta       = 294.0
model1.tstart      = 0
model1.B0          = 2.9574e-5
model1.cs          = 1.937e6
