model1.tau_p_110   = 0.406
model1.tau_p_112T  = 0.349
model1.tau_p_112AT = 0.555
model1.tau_a0      = 0.027
model1.tau_r0      = 0.525
model1.Cfor        = 0.0
model1.Ccop        = 0.5
model1.CM          = 0.3502
