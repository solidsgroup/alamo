#bc.expression.type.yhi    = disp trac
bc.expression.type.xloylo = trac trac
bc.expression.type.xloyhi = trac trac
bc.expression.type.xhiylo = trac trac
bc.expression.type.xhiyhi = trac trac

bc.expression.val.xlo     = 0.0 0.0
bc.expression.val.xhi     = 0.0 0.0
bc.expression.val.ylo     = 0.0 0.0
bc.expression.val.yhi     = 0.0 0.0
