#@ [2d-serial]
#@ exe = mechanics
#@ dim = 2
#@ nprocs = 1
#@ check = true
#@
#@ [2d-mpi]
#@ exe = mechanics
#@ dim = 2
#@ nprocs = 2
#@ check = true
#@
#@ [2d-scaled-traction]
#@ exe = mechanics
#@ dim = 2
#@ nprocs = 1
#@ check = true
#@ args = bc.expression.traction_scale=0.25
#@
alamo.program = mechanics
alamo.program.mechanics.model = linear.isotropic
type = static
time_evolving = 1
nmodels = 1
model1.lambda = 1
model1.mu = 1
timestep = 0.5
stop_time = 1
amr.n_cell = 32 16
amr.max_grid_size = 8
amr.blocking_factor = 4
amr.max_level = 0
amr.plot_int = 1
amr.cell.all = 1
amr.node.any = 0
geometry.prob_lo = -2 -1
geometry.prob_hi = 2 1
geometry.is_periodic = 0 0
plot_file = tests/ElasticTypeExpression/output
solver.nriters = 2
solver.max_iter = 200
solver.verbose = 0
tol_rel = 1e-10
tol_abs = 1e-12
bc.type = expression
bc.expression.val.xlo = "0" "0.001*(y+1)"
bc.expression.val.xhi = "0" "0.001*(y+1)"
bc.expression.val.xloyhi = "0" "0.002"
bc.expression.val.xhiyhi = "0" "0.002"
bc.expression.type.yhi = trac "if(x<0.5*t,disp,trac)"
bc.expression.val.yhi = "0" "if(x<0.5*t,0.002,0.003)"
