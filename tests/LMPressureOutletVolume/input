#@ [2d]
#@ exe = lowmach
#@ dim = 2
#@ timeout = 120

# A mixed gas/solid configuration has an intentionally under-dense gas layer
# at the pressure outlet.  Low-Mach initialization must reconcile this state
# with the EOS without creating a velocity impulse.  During advancement the
# open boundary must retain the EOS state without driving backflow or a
# tangential circulation.
plot_file = tests/LMPressureOutletVolume/output
amr.plot_dt = 5.0e-3_s
amr.max_level = 0
amr.n_cell = 64 64
amr.max_grid_size = 32
amr.blocking_factor = 4
amr.regrid_int = -1

timestep = 1.0e-4_s
stop_time = 1.5e-2_s
dynamictimestep.on = 1
dynamictimestep.min = 1.0e-10_s
dynamictimestep.max = 2.0e-4_s
dynamictimestep.verbose = 0
integration.type = RungeKutta
integration.rk.type = 3

geometry.prob_lo = 0.0_m 0.0_m 0.0_m
geometry.prob_hi = 1.0_m 1.0_m 0.0_m
geometry.is_periodic = 1 0 0

system.amount = kmol
gas.mw = 28.0_kg/kmol
gas.thermo.type = cpconstant
gas.thermo.cpconstant.cp_moles = 29.1_J/mol/K
gas.thermo.cpconstant.h0 = 0.0_J/mol
gas.thermo.cpconstant.s0 = 0.0_J/mol/K
gas.thermo.cpconstant.Tref = 300.0_K
gas.transport.type = mixture_averaged
gas.transport.mixture_averaged.type = constant
gas.transport.mixture_averaged.mu = 1.0e-5_Pa*s
gas.transport.mixture_averaged.k = 0.02_W/m/K
gas.eos.type = cpg

species.names = ambient_gas inert_solid
ambient_gas.mechanics = fluid
inert_solid.mechanics = rigid_solid
inert_solid.reference_density = 5.0_kg/m^3
inert_solid.rigid.motion = fixed
inert_solid.rigid.relaxation_time = 1.0e-5_s
inert_solid.rigid.velocity = 0.0_m/s 0.0_m/s

chemistry.model.type = frozen
chemistry.solver.type = forward_euler

interface.thickness = 5.0e-2_m

advection.type = muscl
advection.muscl.limiter.type = minmod
cfl = 0.8
include_viscosity = 0
include_conduction = 0
advect_temperature = 0
projection.enabled = 1
projection.tol_rel = 1.0e-11
projection.tol_abs = 1.0e-12
projection.verbose = 0
projection.update_pressure = 0
diagnostics.interval = 0
diagnostics.extended_fields = 0

inert_solid.density.ic.type = expression
inert_solid.density.ic.expression.constant.rhos = 5.0_kg/m^3
inert_solid.density.ic.expression.constant.x0 = 0.5_m
inert_solid.density.ic.expression.constant.y0 = 0.25_m
inert_solid.density.ic.expression.constant.radius = 0.10_m
inert_solid.density.ic.expression.constant.width = 0.025_m
inert_solid.density.ic.expression.region0 = "rhos*(0.5-0.5*tanh((sqrt(min(abs(x-x0),1.0-abs(x-x0))^2+(y-y0)^2)-radius)/width))"

ambient_gas.density.ic.type = expression
ambient_gas.density.ic.expression.constant.rho0 = 1.12254198039921_kg/m^3
ambient_gas.density.ic.expression.constant.rhos = 5.0_kg/m^3
ambient_gas.density.ic.expression.constant.x0 = 0.5_m
ambient_gas.density.ic.expression.constant.y0 = 0.25_m
ambient_gas.density.ic.expression.constant.radius = 0.10_m
ambient_gas.density.ic.expression.constant.width = 0.025_m
ambient_gas.density.ic.expression.constant.outlet_center = 0.85_m
ambient_gas.density.ic.expression.constant.outlet_width = 0.02_m
ambient_gas.density.ic.expression.region0 = "rho0*(1.0-(0.5-0.5*tanh((sqrt(min(abs(x-x0),1.0-abs(x-x0))^2+(y-y0)^2)-radius)/width)))*(1.0-0.4*(0.5+0.5*tanh((y-outlet_center)/outlet_width)))"

velocity.ic.type = constant
velocity.ic.constant.value = 0.0_m/s 0.0_m/s
temperature.ic.type = constant
temperature.ic.constant.value = 300.0_K
pressure.ic.type = constant
pressure.ic.constant.value = 1.0e5_Pa

component_density.bc.type = constant
component_density.bc.constant.type.xlo = periodic
component_density.bc.constant.type.xhi = periodic
component_density.bc.constant.type.ylo = neumann
component_density.bc.constant.type.yhi = neumann

velocity.bc.type = constant
velocity.bc.constant.type.xlo = periodic
velocity.bc.constant.type.xhi = periodic
velocity.bc.constant.type.ylo = dirichlet
velocity.bc.constant.type.yhi = neumann
velocity.bc.constant.val.ylo = 0.0_m/s 0.0_m/s

temperature.bc.type = constant
temperature.bc.constant.type.xlo = periodic
temperature.bc.constant.type.xhi = periodic
temperature.bc.constant.type.ylo = neumann
temperature.bc.constant.type.yhi = neumann

pressure.bc.type = constant
pressure.bc.constant.type.xlo = periodic
pressure.bc.constant.type.xhi = periodic
pressure.bc.constant.type.ylo = neumann
pressure.bc.constant.type.yhi = dirichlet
pressure.bc.constant.val.yhi = 1.0e5_Pa
