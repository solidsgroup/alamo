# Half-size 4 MPa AP/HTPB regression through a PNG-defined Cyclone logo.
# Run with:
#   mpirun -np 4 ./bin/lowmach-2d-clang++ input.lm.ap_htpb_cyclone_half
#
# The logo is flipped to account for PNG row ordering, then rotated clockwise
# in the simulation. Rotating rendered frames counterclockwise makes the logo
# upright and the downward burn left-to-right.
# White pixels are AP and black pixels are HTPB. Thresholding keeps their
# internal interface sharp; only the common condensed/gas surface is diffuse.

plot_file = output.lm.ap_htpb_cyclone_half
# Restart from the preserved plotfile after the initial four-rank run.
restart_cell = output.lm.ap_htpb_cyclone_half/09404cell
restart.in_place = 1
amr.plot_dt = 0.05_ms
amr.max_level = 3
amr.n_cell = 32 48
amr.max_grid_size = 16
amr.blocking_factor = 4
amr.regrid_int = 5
amr.grid_eff = 0.7
amr.nsubsteps = 2
amr.reinitialize_condensed_composition = 1
amr.reinitialize_condensed_composition_eta_min = 0.99

# The 1 mm logo retains the original 3.9 um finest-cell size. Refinement follows
# the exposed condensed surface and reaction zone rather than the buried image.
eta_refinement_criterion = 0.1
reaction_refinement_criterion = 1.0e4_1/s
temperature_refinement_criterion = 500.0

timestep = 1.0e-7_s
stop_time = 0.3_s
dynamictimestep.on = 1
dynamictimestep.min = 1.0e-12
dynamictimestep.max = 5e-7
dynamictimestep.verbose = 0

integration.type = RungeKutta
integration.rk.type = 3

geometry.prob_lo = -0.5_mm -1.0_mm 0.0
geometry.prob_hi =  0.5_mm  0.5_mm 0.0
geometry.is_periodic = 0 0 0

# Gas species 0-5 retain the ordering required by the GrossModel mechanism:
# AP, binder, monopropellant, premixed, primary-flame, final-flame products.
system.amount = kmol
gas.mw = 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol 26.0_g/mol
gas.thermo.type = gross_model
gas.thermo.gross_model.cp_mass = 0.3_cal/g/K
gas.thermo.gross_model.Tref = 273.15_K
gas.transport.type = gross_model
gas.transport.gross_model.prandtl = 0.69
gas.transport.gross_model.lewis = 1.0
gas.transport.gross_model.lambda_a = 2.13037e-7_cal/cm/s/K^2
gas.transport.gross_model.lambda_b = 5.32743e-6_cal/cm/s/K
gas.eos.type = gross_model

species.names = AP_gas HTPB_gas Mono Premixed Primary Final AP_solid HTPB_solid
AP_gas.mechanics = fluid
HTPB_gas.mechanics = fluid
Mono.mechanics = fluid
Premixed.mechanics = fluid
Primary.mechanics = fluid
Final.mechanics = fluid
AP_solid.mechanics = rigid_solid
HTPB_solid.mechanics = rigid_solid
AP_solid.reference_density = 1950.0_kg/m^3
HTPB_solid.reference_density = 920.0_kg/m^3
AP_solid.specific_heat = 1297.90_J/kg/K
AP_solid.thermal_conductivity = 0.4186_W/m/K
HTPB_solid.specific_heat = 2418.29_J/kg/K
HTPB_solid.thermal_conductivity = 0.1300_W/m/K

chemistry.model.type = gross_model
chemistry.model.gross_model.A = 27.0e3_g/cm^3/s 25.3e3_g/cm^3/s 5.0e3_g/cm^3/s 0.4e3_g/cm^3/s
chemistry.model.gross_model.pressure_exponent = 1.6 1.7 1.7 1.7
chemistry.model.gross_model.activation_energy = 15.9_kcal/mol 14.5_kcal/mol 11.3_kcal/mol 14.5_kcal/mol
chemistry.model.gross_model.qgas = 430.0_cal/g 447.0_cal/g 8365.0_cal/g 2127.0_cal/g
chemistry.model.gross_model.pressure_reference = 1.0_bar
chemistry.solver.type = backward_euler
chemistry.solver.backward_euler.max_iter = 100
chemistry.solver.backward_euler.reltol = 1.0e-8
chemistry.solver.backward_euler.abstol = 1.0e-12

# Preserve the calibrated phase-change and phase-field parameters from the
# current AP/HTPB sandwich case.
mechanisms.names = AP_decomposition HTPB_pyrolysis
AP_decomposition.type = phase_change
AP_decomposition.phase_change.phase0 = AP_solid
AP_decomposition.phase_change.phase1 = AP_gas
AP_decomposition.phase_change.latent_heat = 100.0_cal/g
AP_decomposition.phase_change.rate_multiplier = 2.75e6
AP_decomposition.phase_change.activation_temperature = 3145.0_K
AP_decomposition.phase_change.temperature_cutoff = 360.0_K
AP_decomposition.phase_change.phase_field.type = allencahn
AP_decomposition.phase_change.phase_field.allencahn.mobility = 0.01_1/Pa/s
AP_decomposition.phase_change.phase_field.allencahn.lambda = 8.333333333333333_Pa
AP_decomposition.phase_change.phase_field.allencahn.kappa = 1.0e-8_J/m
AP_decomposition.phase_change.phase_field.allencahn.w0 = 0.0
AP_decomposition.phase_change.phase_field.allencahn.w12 = 2.0
AP_decomposition.phase_change.phase_field.allencahn.w1 = 1.0

HTPB_pyrolysis.type = phase_change
HTPB_pyrolysis.phase_change.phase0 = HTPB_solid
HTPB_pyrolysis.phase_change.phase1 = HTPB_gas
HTPB_pyrolysis.phase_change.latent_heat = 300.0_cal/g
HTPB_pyrolysis.phase_change.rate_multiplier = 1.85e5
HTPB_pyrolysis.phase_change.activation_temperature = 3145.0_K
HTPB_pyrolysis.phase_change.temperature_cutoff = 360.0_K
HTPB_pyrolysis.phase_change.phase_field.type = allencahn
HTPB_pyrolysis.phase_change.phase_field.allencahn.mobility = 0.01_1/Pa/s
HTPB_pyrolysis.phase_change.phase_field.allencahn.lambda = 8.333333333333333_Pa
HTPB_pyrolysis.phase_change.phase_field.allencahn.kappa = 1.0e-8_J/m
HTPB_pyrolysis.phase_change.phase_field.allencahn.w0 = 0.0
HTPB_pyrolysis.phase_change.phase_field.allencahn.w12 = 2.0
HTPB_pyrolysis.phase_change.phase_field.allencahn.w1 = 1.0

AP_solid.rigid.relaxation_time = 1.0e-8_s
AP_solid.rigid.velocity = 0.0 0.0
HTPB_solid.rigid.relaxation_time = 1.0e-8_s
HTPB_solid.rigid.velocity = 0.0 0.0

advection.type = muscl
advection.muscl.limiter.type = minmod
cfl = 0.8
phase_field.cfl = 1.5
include_viscosity = 1
implicit_viscosity = 1
include_conduction = 1
advect_temperature = 1
projection.enabled = 1
projection.tol_rel = 1.0e-11
projection.tol_abs = 1.0e-12
projection.verbose = 0
projection.update_pressure = 1
diffusion.tol_rel = 1.0e-11
diffusion.tol_abs = 1.0e-12
diffusion.verbose = 0
diagnostics.extended_fields = 0

# Read complementary AP and HTPB indicators from the same image. Both are
# multiplied by the y<0 condensed mask, so their sum reconstructs one diffuse
# horizontal burn surface without diffusing the internal material boundary.
AP_solid.density.ic.type = png
AP_solid.density.ic.png.filename = cyclone.png
AP_solid.density.ic.png.fit = coord
AP_solid.density.ic.png.coord.lo = -0.5_mm -1.0_mm
AP_solid.density.ic.png.coord.hi =  0.5_mm  0.0_mm
AP_solid.density.ic.png.channel = G
AP_solid.density.ic.png.rotation = 90
AP_solid.density.ic.png.flip.y = 1
AP_solid.density.ic.png.threshold = 0.5
AP_solid.density.ic.png.value = 1950.0_kg/m^3
AP_solid.density.ic.png.plane.point = 0.0_mm 0.0_mm 0.0_mm
AP_solid.density.ic.png.plane.normal = 0.0 -1.0 0.0
AP_solid.density.ic.png.plane.eps = 20.0_um

HTPB_solid.density.ic.type = png
HTPB_solid.density.ic.png.filename = cyclone.png
HTPB_solid.density.ic.png.fit = coord
HTPB_solid.density.ic.png.coord.lo = -0.5_mm -1.0_mm
HTPB_solid.density.ic.png.coord.hi =  0.5_mm  0.0_mm
HTPB_solid.density.ic.png.channel = G
HTPB_solid.density.ic.png.rotation = 90
HTPB_solid.density.ic.png.flip.y = 1
HTPB_solid.density.ic.png.threshold = 0.5
HTPB_solid.density.ic.png.invert = 1
HTPB_solid.density.ic.png.value = 920.0_kg/m^3
HTPB_solid.density.ic.png.plane.point = 0.0_mm 0.0_mm 0.0_mm
HTPB_solid.density.ic.png.plane.normal = 0.0 -1.0 0.0
HTPB_solid.density.ic.png.plane.eps = 20.0_um

# The gas starts as final products above the logo at a uniform 4 MPa.
Final.density.ic.type = expression
Final.density.ic.expression.constant.P = 4.0e6
Final.density.ic.expression.constant.Tambient = 300.0_K
Final.density.ic.expression.constant.Tignite = 400.0_K
Final.density.ic.expression.constant.Lsolid = 100.0_um
Final.density.ic.expression.constant.Lgas = 250.0_um
Final.density.ic.expression.region0 = "max(0.0,(0.5+0.5*tanh(2.0*y/20.0e-6))*P/(319.787*(Tambient+(Tignite-Tambient)*exp(-max(-y,0.0)/Lsolid-max(y,0.0)/Lgas))))"

velocity.ic.type = constant
velocity.ic.constant.value = 0.0 0.0
temperature.ic.type = expression
temperature.ic.expression.constant.Tambient = 300.0_K
temperature.ic.expression.constant.Tignite = 400.0_K
temperature.ic.expression.constant.Lsolid = 100.0_um
temperature.ic.expression.constant.Lgas = 250.0_um
temperature.ic.expression.region0 = "Tambient+(Tignite-Tambient)*exp(-max(-y,0.0)/Lsolid-max(y,0.0)/Lgas)"
pressure.ic.type = constant
pressure.ic.constant.value = 4.0e6

# Apply the same short ignition pulse as the calibrated sandwich case.
heat_source.ic.type = expression
heat_source.ic.expression.unit = W/m^3
heat_source.ic.expression.constant.qflux = 1.0e7_W/m^2
heat_source.ic.expression.constant.width = 6.25e-6_m
heat_source.ic.expression.constant.norm = 1.772453850905516
heat_source.ic.expression.constant.toff = 2.5e-4_s
heat_source.ic.expression.constant.tramp = 1.0e-5_s
heat_source.ic.expression.region0 = "qflux*exp(-(y/width)^2)/(norm*width)*0.5*(1.0-tanh((t-toff)/tramp))"

component_density.bc.type = constant
component_density.bc.constant.type.xlo = neumann
component_density.bc.constant.type.xhi = neumann
component_density.bc.constant.type.ylo = neumann
component_density.bc.constant.type.yhi = neumann

velocity.bc.type = constant
velocity.bc.constant.type.xlo = REFLECT_ODD REFLECT_EVEN
velocity.bc.constant.type.xhi = REFLECT_ODD REFLECT_EVEN
velocity.bc.constant.type.ylo = dirichlet
velocity.bc.constant.type.yhi = neumann
velocity.bc.constant.val.ylo = 0.0 0.0

temperature.bc.type = constant
temperature.bc.constant.type.xlo = neumann
temperature.bc.constant.type.xhi = neumann
temperature.bc.constant.type.ylo = neumann
temperature.bc.constant.type.yhi = neumann

pressure.bc.type = constant
pressure.bc.constant.type.xlo = neumann
pressure.bc.constant.type.xhi = neumann
pressure.bc.constant.type.ylo = neumann
pressure.bc.constant.type.yhi = dirichlet
pressure.bc.constant.val.yhi = 4.0e6
