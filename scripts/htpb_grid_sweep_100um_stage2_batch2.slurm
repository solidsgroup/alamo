#!/usr/bin/env bash
# Slurm job array: batch 2 of the stage-2 (full-pressure) 100um grid sweep.
#
# Unlike htpb_grid_sweep_100um_stage2.slurm (a fixed cartesian grid), this
# batch evaluates an explicit list of (pre_exponential, activation_temperature)
# points generated by scripts/generate_next_batch.py from a GP fit to batch 1's
# 32 completed results -- i.e. the points the surrogate model currently
# predicts are the lowest-residual, used to refine/densify that region rather
# than re-scanning the wider grid.
#
# Each array task gets 32 MPI ranks total, split across the 7 concurrent
# fit-pressure sims (~4-5 ranks/sim). --time is generous (8h) as before.
#
# Usage:
#   sbatch --array=0-34 scripts/htpb_grid_sweep_100um_stage2_batch2.slurm \
#       /path/to/workdir /path/to/points.json

#SBATCH --job-name=htpb-grid-100um-s2b2
#SBATCH --partition=nova
#SBATCH --account=brunnels
#SBATCH --nodes=1
#SBATCH --ntasks=32
#SBATCH --cpus-per-task=1
#SBATCH --time=08:00:00
#SBATCH --output=%x_%A_%a.out
#SBATCH --error=%x_%A_%a.err

set -euo pipefail

module load openmpi/4.1.6-jd5jqt4

REPO_ROOT="${SLURM_SUBMIT_DIR}"
SCRIPT_DIR="${REPO_ROOT}/scripts"

source "${REPO_ROOT}/.venv_htpb_sweep/bin/activate"

WORKDIR="${1:?usage: sbatch --array=0-34 scripts/htpb_grid_sweep_100um_stage2_batch2.slurm <workdir> <points.json>}"
POINTS_FILE="${2:?usage: sbatch --array=0-34 scripts/htpb_grid_sweep_100um_stage2_batch2.slurm <workdir> <points.json>}"

export LOWMACH_BIN="${LOWMACH_BIN:-${REPO_ROOT}/bin/lowmach-2d-hdf5-g++}"

python3 "${SCRIPT_DIR}/htpb_grid_sweep.py" \
    --mode eval \
    --workdir "${WORKDIR}" \
    --task-id "${SLURM_ARRAY_TASK_ID}" \
    --lowmach-bin "${LOWMACH_BIN}" \
    --cores 32 \
    --all-pressures \
    --points-file "${POINTS_FILE}"
